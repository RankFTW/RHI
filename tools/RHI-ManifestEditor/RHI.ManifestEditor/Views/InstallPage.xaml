<Page
    x:Class="RHI.ManifestEditor.Views.InstallPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer Padding="16">
        <StackPanel Spacing="20">
            <TextBlock Text="Install Behaviour" FontSize="20" FontWeight="SemiBold"/>
            <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="Controls what happens when the user clicks Install. Warnings, external redirects, DLL names, launch exe overrides, and more."/>

            <!-- installWarnings -->
            <Expander IsExpanded="True" HorizontalAlignment="Stretch">
                <Expander.Header><TextBlock Text="installWarnings — blocking confirm dialog before install" FontWeight="SemiBold"/></Expander.Header>
                <StackPanel Spacing="4" Padding="0,8,0,0">
                    <TextBlock FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="Per-game, per-component. Component keys: reshade renodx relimiter dc optiscaler luma reframework dxvk"/>
                    <ListView x:Name="InstallWarningsView" MaxHeight="320" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Expander Margin="0,4,0,0" HorizontalAlignment="Stretch">
                                    <Expander.Header>
                                        <TextBox Text="{Binding GameName, Mode=TwoWay}" PlaceholderText="game name"
                                                 FontSize="12" MinWidth="200"/>
                                    </Expander.Header>
                                    <StackPanel Spacing="6" Padding="8">
                                        <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="reshade:" VerticalAlignment="Top" FontSize="12"/>
                                            <TextBox Grid.Column="1" Text="{Binding Reshade, Mode=TwoWay}" AcceptsReturn="True" MaxHeight="80" FontSize="12" TextWrapping="Wrap"/>
                                        </Grid>
                                        <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="renodx:" VerticalAlignment="Top" FontSize="12"/>
                                            <TextBox Grid.Column="1" Text="{Binding Renodx, Mode=TwoWay}" AcceptsReturn="True" MaxHeight="80" FontSize="12" TextWrapping="Wrap"/>
                                        </Grid>
                                        <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="relimiter:" VerticalAlignment="Top" FontSize="12"/>
                                            <TextBox Grid.Column="1" Text="{Binding Relimiter, Mode=TwoWay}" AcceptsReturn="True" MaxHeight="80" FontSize="12" TextWrapping="Wrap"/>
                                        </Grid>
                                        <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="dc:" VerticalAlignment="Top" FontSize="12"/>
                                            <TextBox Grid.Column="1" Text="{Binding Dc, Mode=TwoWay}" AcceptsReturn="True" MaxHeight="80" FontSize="12" TextWrapping="Wrap"/>
                                        </Grid>
                                        <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="optiscaler:" VerticalAlignment="Top" FontSize="12"/>
                                            <TextBox Grid.Column="1" Text="{Binding Optiscaler, Mode=TwoWay}" AcceptsReturn="True" MaxHeight="80" FontSize="12" TextWrapping="Wrap"/>
                                        </Grid>
                                        <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="luma:" VerticalAlignment="Top" FontSize="12"/>
                                            <TextBox Grid.Column="1" Text="{Binding Luma, Mode=TwoWay}" AcceptsReturn="True" MaxHeight="80" FontSize="12" TextWrapping="Wrap"/>
                                        </Grid>
                                        <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="reframework:" VerticalAlignment="Top" FontSize="12"/>
                                            <TextBox Grid.Column="1" Text="{Binding Reframework, Mode=TwoWay}" AcceptsReturn="True" MaxHeight="80" FontSize="12" TextWrapping="Wrap"/>
                                        </Grid>
                                        <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="dxvk:" VerticalAlignment="Top" FontSize="12"/>
                                            <TextBox Grid.Column="1" Text="{Binding Dxvk, Mode=TwoWay}" AcceptsReturn="True" MaxHeight="80" FontSize="12" TextWrapping="Wrap"/>
                                        </Grid>
                                        <Button Content="Remove entry" Tag="{Binding}" Click="RemoveInstallWarning_Click" Foreground="OrangeRed"/>
                                    </StackPanel>
                                </Expander>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <Button Content="+ Add game" Click="AddInstallWarning_Click"/>
                </StackPanel>
            </Expander>

            <!-- snapshotOverrides -->
            <Expander HorizontalAlignment="Stretch">
                <Expander.Header><TextBlock Text="snapshotOverrides — override addon download URL" FontWeight="SemiBold"/></Expander.Header>
                <StackPanel Spacing="4" Padding="0,8,0,0">
                    <TextBlock FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="⚠ Do NOT add NativeHDR generic UE games here — any SnapshotUrl blocks UE-Extended."/>
                    <ListView x:Name="SnapshotView" MaxHeight="220" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnSpacing="8" Margin="0,2,0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Text="{Binding Key, Mode=TwoWay}" PlaceholderText="game name" FontSize="12"/>
                                    <TextBox Grid.Column="1" Text="{Binding Value, Mode=TwoWay}" PlaceholderText="https://..." FontSize="12"/>
                                    <Button Grid.Column="2" Content="✕" Tag="{Binding}" Click="RemoveSnapshot_Click" Padding="8,4"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <Button Content="+ Add" Click="AddSnapshot_Click"/>
                </StackPanel>
            </Expander>

            <!-- dllNameOverrides -->
            <Expander HorizontalAlignment="Stretch">
                <Expander.Header><TextBlock Text="dllNameOverrides — force ReShade/DC DLL filename" FontWeight="SemiBold"/></Expander.Header>
                <StackPanel Spacing="4" Padding="0,8,0,0">
                    <TextBlock FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="Key = game name. reshade = ReShade DLL name (e.g. d3d11.dll). dc = DC DLL name. Empty = use default."/>
                    <ListView x:Name="DllOverrideView" MaxHeight="220" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnSpacing="8" Margin="0,2,0,2">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="140"/><ColumnDefinition Width="140"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Text="{Binding GameName, Mode=TwoWay}" PlaceholderText="game name" FontSize="12"/>
                                    <TextBox Grid.Column="1" Text="{Binding Reshade, Mode=TwoWay}" PlaceholderText="reshade DLL" FontSize="12"/>
                                    <TextBox Grid.Column="2" Text="{Binding Dc, Mode=TwoWay}" PlaceholderText="dc DLL" FontSize="12"/>
                                    <Button Grid.Column="3" Content="✕" Tag="{Binding}" Click="RemoveDllOverride_Click" Padding="8,4"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <Button Content="+ Add" Click="AddDllOverride_Click"/>
                </StackPanel>
            </Expander>

            <!-- launchExeOverrides -->
            <Expander HorizontalAlignment="Stretch">
                <Expander.Header><TextBlock Text="launchExeOverrides — exe for Launch button and NVIDIA profile matching" FontWeight="SemiBold"/></Expander.Header>
                <StackPanel Spacing="4" Padding="0,8,0,0">
                    <TextBlock FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="Relative path from InstallPath. Used for Launch (priority 2) and NVIDIA profile exe matching."/>
                    <ListView x:Name="LaunchExeView" MaxHeight="220" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnSpacing="8" Margin="0,2,0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Text="{Binding Key, Mode=TwoWay}" PlaceholderText="game name" FontSize="12"/>
                                    <TextBox Grid.Column="1" Text="{Binding Value, Mode=TwoWay}" PlaceholderText="relative\path\to.exe" FontSize="12"/>
                                    <Button Grid.Column="2" Content="✕" Tag="{Binding}" Click="RemoveLaunchExe_Click" Padding="8,4"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <Button Content="+ Add" Click="AddLaunchExe_Click"/>
                </StackPanel>
            </Expander>

            <!-- legacyReShadeVersions -->
            <Expander HorizontalAlignment="Stretch">
                <Expander.Header><TextBlock Text="legacyReShadeVersions — auto-assign locked RS version" FontWeight="SemiBold"/></Expander.Header>
                <StackPanel Spacing="4" Padding="0,8,0,0">
                    <TextBlock FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="Never overwrites existing user overrides. Value = version string e.g. 6.4.1"/>
                    <ListView x:Name="LegacyVersionsView" MaxHeight="160" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnSpacing="8" Margin="0,2,0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="120"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Text="{Binding Key, Mode=TwoWay}" PlaceholderText="game name" FontSize="12"/>
                                    <TextBox Grid.Column="1" Text="{Binding Value, Mode=TwoWay}" PlaceholderText="e.g. 6.4.1" FontSize="12"/>
                                    <Button Grid.Column="2" Content="✕" Tag="{Binding}" Click="RemoveLegacyVersion_Click" Padding="8,4"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <Button Content="+ Add" Click="AddLegacyVersion_Click"/>
                </StackPanel>
            </Expander>

            <!-- legacyReShadeAvailable -->
            <Expander HorizontalAlignment="Stretch">
                <Expander.Header><TextBlock Text="legacyReShadeAvailable — games that support the legacy RS channel" FontWeight="SemiBold"/></Expander.Header>
                <StackPanel Spacing="4" Padding="0,8,0,0">
                    <TextBlock FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="Games listed here will show the Legacy RS channel option. Used alongside legacyReShadeVersions."/>
                    <ListView x:Name="LegacyAvailableView" MaxHeight="200" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnSpacing="8" Margin="0,2,0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Text="{Binding Value, Mode=TwoWay}" PlaceholderText="game name" FontSize="12"/>
                                    <Button Grid.Column="1" Content="✕" Tag="{Binding}" Click="RemoveLegacyAvailable_Click" Padding="8,4"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <Button Content="+ Add" Click="AddLegacyAvailable_Click"/>
                </StackPanel>
            </Expander>

            <!-- forceExternalOnly -->
            <Expander HorizontalAlignment="Stretch">
                <Expander.Header><TextBlock Text="forceExternalOnly — replace Install button with a download link" FontWeight="SemiBold"/></Expander.Header>
                <StackPanel Spacing="4" Padding="0,8,0,0">
                    <TextBlock FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="Key = detected game name (NOT wiki-mapped). url = link opened on click. label = button text (optional)."/>
                    <ListView x:Name="ForceExternalView" MaxHeight="220" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnSpacing="8" Margin="0,2,0,2">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="120"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Text="{Binding Key, Mode=TwoWay}" PlaceholderText="detected game name" FontSize="12"/>
                                    <TextBox Grid.Column="1" Text="{Binding Url, Mode=TwoWay}" PlaceholderText="https://..." FontSize="12"/>
                                    <TextBox Grid.Column="2" Text="{Binding Label, Mode=TwoWay}" PlaceholderText="button label" FontSize="12"/>
                                    <Button Grid.Column="3" Content="✕" Tag="{Binding}" Click="RemoveForceExternal_Click" Padding="8,4"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <Button Content="+ Add" Click="AddForceExternal_Click"/>
                </StackPanel>
            </Expander>

            <!-- gacSymlinkGames -->
            <Expander HorizontalAlignment="Stretch">
                <Expander.Header><TextBlock Text="gacSymlinkGames — games needing a GAC symlink for mod loading" FontWeight="SemiBold"/></Expander.Header>
                <StackPanel Spacing="4" Padding="0,8,0,0">
                    <TextBlock FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="Key = game name. Value = target path for the symlink. Used for games that load from a non-standard location."/>
                    <ListView x:Name="GacSymlinkView" MaxHeight="160" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnSpacing="8" Margin="0,2,0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Text="{Binding Key, Mode=TwoWay}" PlaceholderText="game name" FontSize="12"/>
                                    <TextBox Grid.Column="1" Text="{Binding Value, Mode=TwoWay}" PlaceholderText="symlink target path" FontSize="12"/>
                                    <Button Grid.Column="2" Content="✕" Tag="{Binding}" Click="RemoveGacSymlink_Click" Padding="8,4"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <Button Content="+ Add" Click="AddGacSymlink_Click"/>
                </StackPanel>
            </Expander>

            <!-- renodxIniOverrides -->
            <Expander HorizontalAlignment="Stretch">
                <Expander.Header><TextBlock Text="renodxIniOverrides — inject key=value pairs into renodx.ini on install" FontWeight="SemiBold"/></Expander.Header>
                <StackPanel Spacing="4" Padding="0,8,0,0">
                    <TextBlock FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="Outer key = game name. Inner key/value = ini key and value to write. Applied on every install and update."/>
                    <ListView x:Name="RenodxIniView" MaxHeight="400" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Expander Margin="0,4,0,0" HorizontalAlignment="Stretch">
                                    <Expander.Header>
                                        <TextBox Text="{Binding GameName, Mode=TwoWay}" PlaceholderText="game name" FontSize="12" MinWidth="200"/>
                                    </Expander.Header>
                                    <StackPanel Spacing="6" Padding="8">
                                        <ListView ItemsSource="{Binding Entries}" MaxHeight="200" SelectionMode="None">
                                            <ListView.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid ColumnSpacing="8" Margin="0,2,0,2">
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                        <TextBox Grid.Column="0" Text="{Binding Key, Mode=TwoWay}" PlaceholderText="ini key" FontSize="12"/>
                                                        <TextBox Grid.Column="1" Text="{Binding Value, Mode=TwoWay}" PlaceholderText="value" FontSize="12"/>
                                                        <Button Grid.Column="2" Content="✕" Tag="{Binding}" Click="RemoveRenodxIniEntry_Click" Padding="8,4"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ListView.ItemTemplate>
                                        </ListView>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Button Content="+ Add key" Tag="{Binding}" Click="AddRenodxIniEntry_Click"/>
                                            <Button Content="Remove game" Tag="{Binding}" Click="RemoveRenodxIniGame_Click" Foreground="OrangeRed"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Expander>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <Button Content="+ Add game" Click="AddRenodxIniGame_Click"/>
                </StackPanel>
            </Expander>

            <!-- renodxExtraSettings -->
            <Expander HorizontalAlignment="Stretch">
                <Expander.Header><TextBlock Text="renodxExtraSettings — global per-game sliders/options in the RenoDX cog" FontWeight="SemiBold"/></Expander.Header>
                <StackPanel Spacing="4" Padding="0,8,0,0">
                    <TextBlock FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="Each entry adds a control in the RenoDX cog dialog. key = ini key. label = display label (optional). default = default value. options = comma-separated value=name pairs (e.g. 0=Off, 1=On) — leave empty for a numeric text entry."/>
                    <ListView x:Name="RenodxExtraSettingsView" MaxHeight="320" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnSpacing="8" Margin="0,2,0,2">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="80"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Text="{Binding Key, Mode=TwoWay}" PlaceholderText="ini key" FontSize="12"/>
                                    <TextBox Grid.Column="1" Text="{Binding Label, Mode=TwoWay}" PlaceholderText="display label" FontSize="12"/>
                                    <TextBox Grid.Column="2" Text="{Binding Default, Mode=TwoWay}" PlaceholderText="default" FontSize="12"/>
                                    <TextBox Grid.Column="3" Text="{Binding OptionsRaw, Mode=TwoWay}" PlaceholderText="0=Off, 1=On" FontSize="12"/>
                                    <Button Grid.Column="4" Content="✕" Tag="{Binding}" Click="RemoveRenodxExtra_Click" Padding="8,4"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <Button Content="+ Add" Click="AddRenodxExtra_Click"/>
                </StackPanel>
            </Expander>
        </StackPanel>
    </ScrollViewer>
</Page>
