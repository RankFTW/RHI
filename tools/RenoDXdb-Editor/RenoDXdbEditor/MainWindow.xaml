<Window x:Class="RenoDXdbEditor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:t="clr-namespace:RhiTools.Theme"
        Title="RenoDXdb Editor" Height="760" Width="1180" MinWidth="860" MinHeight="540"
        Style="{StaticResource ThemedWindow}">

    <Window.Resources>
        <!-- Database picker card: lifts on hover -->
        <Style x:Key="DbCard" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Padding" Value="18,18,18,16"/>
            <Setter Property="MinHeight" Value="196"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource CardBgHover}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource FlyoutStroke}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="DbIconTile" TargetType="Border">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>
        <Style x:Key="DbCardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        </Style>
        <Style x:Key="DbFileName" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource TextTertiary}"/>
            <Setter Property="Margin" Value="0,3,0,8"/>
        </Style>
        <Style x:Key="DbStatus" TargetType="Border" BasedOn="{StaticResource Pill}">
            <Setter Property="Margin" Value="0,14,0,0"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Bottom"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- 0: command bar -->
            <RowDefinition Height="*"/>      <!-- 1: content (selector OR editor) -->
            <RowDefinition Height="Auto"/>   <!-- 2: status bar -->
        </Grid.RowDefinitions>

        <!-- ══════════════════════════════════════════════════════════════════
             ROW 0 — Command bar
             ══════════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="0" Style="{StaticResource CommandBar}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Back to selector -->
                    <Button x:Name="BackBtn" Content="Change DB" Click="BackToSelector_Click"
                            Style="{StaticResource SubtleButton}" t:Ui.Icon="&#xE72B;"
                            IsEnabled="{Binding HasFile}" ToolTip="Return to DB selector"/>
                    <Separator Style="{StaticResource ToolbarSeparator}"/>

                    <!-- File -->
                    <Button Content="Open JSON" Click="OpenFile_Click"
                            Style="{StaticResource SubtleButton}" t:Ui.Icon="&#xE8E5;"/>
                    <Button x:Name="SaveBtn" Content="Save" Click="SaveFile_Click"
                            Style="{StaticResource AccentButton}" t:Ui.Icon="&#xE74E;"
                            Margin="4,0,0,0" IsEnabled="{Binding HasFile}"/>
                    <Button x:Name="SaveAsBtn" Content="Save As" Click="SaveFileAs_Click"
                            Style="{StaticResource SubtleButton}" t:Ui.Icon="&#xE792;"
                            Margin="4,0,0,0" IsEnabled="{Binding HasFile}"/>
                    <Separator Style="{StaticResource ToolbarSeparator}"/>

                    <!-- Sync -->
                    <Button x:Name="SyncBtn" Content="Sync" Click="Sync_Click"
                            Style="{StaticResource SubtleButton}" t:Ui.Icon="&#xE895;"
                            ToolTip="Download latest from GitHub and check for changes"/>
                    <Button x:Name="PushBtn" Content="Push" Click="Push_Click"
                            Style="{StaticResource GreenButton}" t:Ui.Icon="&#xE898;"
                            Margin="4,0,0,0" IsEnabled="{Binding HasFile}"
                            ToolTip="Commit and push current file to rhi-repo on GitHub"/>
                    <Button x:Name="TokenBtn" Content="Token" Click="Token_Click"
                            Style="{StaticResource SubtleButton}" t:Ui.Icon="&#xE8D7;"
                            Margin="4,0,0,0" ToolTip="Set GitHub personal access token"/>
                    <Separator Style="{StaticResource ToolbarSeparator}"/>

                    <!-- Entries -->
                    <Button x:Name="NewBtn" Content="New" Click="NewEntry_Click"
                            Style="{StaticResource SubtleButton}" t:Ui.Icon="&#xE710;"
                            IsEnabled="{Binding HasFile}"/>
                    <Button x:Name="DeleteBtn" Content="Delete" Click="DeleteEntry_Click"
                            Style="{StaticResource SubtleButton}" t:Ui.Icon="&#xE74D;"
                            Margin="4,0,0,0" IsEnabled="{Binding HasSelection}"/>
                    <Separator Style="{StaticResource ToolbarSeparator}"/>

                    <!-- Wiki check -->
                    <Button x:Name="WikiCheckBtn" Content="Check Wiki" Click="WikiCheck_Click"
                            Style="{StaticResource SubtleButton}" t:Ui.Icon="&#xE774;"
                            IsEnabled="{Binding CanCheckWiki}"
                            ToolTip="Fetch the RenoDX wiki and find Done mods not yet in the DB"/>
                </WrapPanel>

            </Grid>
        </Border>

        <!-- ══════════════════════════════════════════════════════════════════
             ROW 1 — Content area (only one panel visible at a time)
             ══════════════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="1">

            <!-- ── PANEL A: DB Selector ─────────────────────────────────── -->
            <Border x:Name="SelectorPanel" Visibility="Visible" Style="{StaticResource Layer}"
                    BorderThickness="0,1,0,0" CornerRadius="0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                Margin="24,40,24,40" Width="940">

                        <TextBlock Text="RenoDXdb Editor" Style="{StaticResource PageTitle}" FontSize="28"/>
                        <TextBlock Text="Pick a database to open and edit."
                                   Style="{StaticResource Caption}" FontSize="14" Margin="0,4,0,20"/>

                        <!-- Sync status -->
                        <Border x:Name="SyncStatusBorder" Style="{StaticResource Card}" Padding="14,11" Margin="0,0,0,20">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE895;" Style="{StaticResource Glyph}" FontSize="14"
                                           Foreground="{DynamicResource AccentText}" Margin="0,0,12,0"/>
                                <TextBlock x:Name="SyncStatusLabel" Text="Syncing from GitHub..."
                                           Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- DB choice cards, all four in one row -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Named Mods -->
                            <Button Grid.Column="0" Click="OpenNamedMods_Click" Style="{StaticResource CardButton}">
                                <Border Style="{StaticResource DbCard}">
                                    <DockPanel LastChildFill="False">
                                        <StackPanel DockPanel.Dock="Top">
                                            <Border Style="{StaticResource DbIconTile}" Background="#1F3A52">
                                                <TextBlock Text="&#xE7B8;" Style="{StaticResource Glyph}" FontSize="18" Foreground="#8FD1FF"/>
                                            </Border>
                                            <TextBlock Text="Named Mods" Style="{StaticResource DbCardTitle}"/>
                                            <TextBlock Text="RenoDXdb.json" Style="{StaticResource DbFileName}"/>
                                            <TextBlock Text="RenoDX addon mods: name, author, snapshot URLs, Nexus and Discord links."
                                                       Style="{StaticResource Caption}"/>
                                        </StackPanel>
                                        <Border x:Name="NamedModsStatus" DockPanel.Dock="Bottom" Style="{StaticResource DbStatus}">
                                            <TextBlock x:Name="NamedModsStatusLabel" Text="Not synced" FontSize="11"
                                                       Foreground="{DynamicResource TextTertiary}" TextWrapping="Wrap"/>
                                        </Border>
                                    </DockPanel>
                                </Border>
                            </Button>

                            <!-- Unreal -->
                            <Button Grid.Column="2" Click="OpenUnreal_Click" Style="{StaticResource CardButton}">
                                <Border Style="{StaticResource DbCard}">
                                    <DockPanel LastChildFill="False">
                                        <StackPanel DockPanel.Dock="Top">
                                            <Border Style="{StaticResource DbIconTile}" Background="#24402A">
                                                <TextBlock Text="&#xE7FC;" Style="{StaticResource Glyph}" FontSize="18" Foreground="#9FE592"/>
                                            </Border>
                                            <TextBlock Text="Unreal Games" Style="{StaticResource DbCardTitle}"/>
                                            <TextBlock Text="RenoDXdb-unreal.json" Style="{StaticResource DbFileName}"/>
                                            <TextBlock Text="UE-Extended entries: HDR method, Engine.ini upgrade format and size."
                                                       Style="{StaticResource Caption}"/>
                                        </StackPanel>
                                        <Border x:Name="UnrealStatus" DockPanel.Dock="Bottom" Style="{StaticResource DbStatus}">
                                            <TextBlock x:Name="UnrealStatusLabel" Text="Not synced" FontSize="11"
                                                       Foreground="{DynamicResource TextTertiary}" TextWrapping="Wrap"/>
                                        </Border>
                                    </DockPanel>
                                </Border>
                            </Button>

                            <!-- Unity -->
                            <Button Grid.Column="4" Click="OpenUnity_Click" Style="{StaticResource CardButton}">
                                <Border Style="{StaticResource DbCard}">
                                    <DockPanel LastChildFill="False">
                                        <StackPanel DockPanel.Dock="Top">
                                            <Border Style="{StaticResource DbIconTile}" Background="#47391A">
                                                <TextBlock Text="&#xECA5;" Style="{StaticResource Glyph}" FontSize="18" Foreground="#FFD27A"/>
                                            </Border>
                                            <TextBlock Text="Unity Games" Style="{StaticResource DbCardTitle}"/>
                                            <TextBlock Text="RenoDXdb-unity.json" Style="{StaticResource DbFileName}"/>
                                            <TextBlock Text="Unity engine entries: upgrade format and comments."
                                                       Style="{StaticResource Caption}"/>
                                        </StackPanel>
                                        <Border DockPanel.Dock="Bottom" Style="{StaticResource DbStatus}">
                                            <TextBlock x:Name="UnityStatusLabel" Text="Not synced" FontSize="11"
                                                       Foreground="{DynamicResource TextTertiary}" TextWrapping="Wrap"/>
                                        </Border>
                                    </DockPanel>
                                </Border>
                            </Button>

                            <!-- Source -->
                            <Button Grid.Column="6" Click="OpenSource_Click" Style="{StaticResource CardButton}">
                                <Border Style="{StaticResource DbCard}">
                                    <DockPanel LastChildFill="False">
                                        <StackPanel DockPanel.Dock="Top">
                                            <Border Style="{StaticResource DbIconTile}" Background="#4A2A26">
                                                <TextBlock Text="&#xE943;" Style="{StaticResource Glyph}" FontSize="18" Foreground="#FFAB9E"/>
                                            </Border>
                                            <TextBlock Text="Source Games" Style="{StaticResource DbCardTitle}"/>
                                            <TextBlock Text="RenoDXdb-source.json" Style="{StaticResource DbFileName}"/>
                                            <TextBlock Text="Source engine entries: 32/64-bit addon and comments."
                                                       Style="{StaticResource Caption}"/>
                                        </StackPanel>
                                        <Border DockPanel.Dock="Bottom" Style="{StaticResource DbStatus}">
                                            <TextBlock x:Name="SourceStatusLabel" Text="Not synced" FontSize="11"
                                                       Foreground="{DynamicResource TextTertiary}" TextWrapping="Wrap"/>
                                        </Border>
                                    </DockPanel>
                                </Border>
                            </Button>
                        </Grid>

                        <TextBlock Text="Or open a local file with Open JSON in the bar above."
                                   Style="{StaticResource Hint}" HorizontalAlignment="Center" Margin="0,18,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- ── PANEL B: Editor (list + right panel) ─────────────────── -->
            <Grid x:Name="EditorPanel" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="290" MinWidth="180"/>
                    <ColumnDefinition Width="6"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Search + game list -->
                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Margin="10,8,6,8">
                        <Grid>
                            <TextBox x:Name="SearchBox" TextChanged="SearchBox_TextChanged" Padding="8,6,32,6"
                                     t:Ui.Placeholder="Search name or author"
                                     ToolTip="Filter by name / author"/>
                            <TextBlock Text="&#xE721;" Style="{StaticResource Glyph}" FontSize="13"
                                       HorizontalAlignment="Right" Margin="0,0,11,0" IsHitTestVisible="False"
                                       Foreground="{DynamicResource TextSecondary}"/>
                        </Grid>
                        <TextBlock x:Name="CountLabel" Style="{StaticResource Hint}" Margin="2,6,0,0"/>
                    </StackPanel>
                    <ListBox x:Name="GameList" Grid.Row="1" Margin="4,0,0,0"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             SelectionChanged="GameList_SelectionChanged"
                             DisplayMemberPath="DisplayName"/>
                </Grid>

                <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Cursor="SizeWE"/>

                <!-- Right: scrollable editor area -->
                <Border Grid.Column="2" Style="{StaticResource Layer}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="32,24,32,24">
                        <StackPanel x:Name="RightPanel" IsEnabled="{Binding HasSelection}" MaxWidth="880">

                            <!-- DB header (text set from code) -->
                            <TextBlock x:Name="EditorTitle" Text="Game Details"
                                       Style="{StaticResource PageTitle}" Margin="0,0,0,20"/>

                            <!-- ── Named Mods fields ────────────────────────── -->
                            <StackPanel x:Name="NamedModsFields">
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="Mod" Style="{StaticResource SectionTitle}"/>
                                        <Label Content="Game name *"/>
                                        <TextBox x:Name="NameBox" TextChanged="Field_Changed"/>
                                        <Grid Margin="0,14,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="160"/>
                                                <ColumnDefinition Width="16"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <Label Content="Status *"/>
                                                <ComboBox x:Name="StatusCombo" SelectionChanged="Field_Changed">
                                                    <ComboBoxItem Content="Done"/>
                                                    <ComboBoxItem Content="WIP"/>
                                                </ComboBox>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <Label Content="Author *"/>
                                                <TextBox x:Name="AuthorBox" TextChanged="Field_Changed"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="Snapshots" Style="{StaticResource SectionTitle}"/>
                                        <Label Content="64-bit (.addon64)"/>
                                        <TextBox x:Name="SnapshotUrlBox" TextChanged="Field_Changed"
                                                 Style="{StaticResource MonoTextBox}"/>
                                        <Label Content="32-bit (.addon32)" Margin="0,14,0,0"/>
                                        <TextBox x:Name="SnapshotUrl32Box" TextChanged="Field_Changed"
                                                 Style="{StaticResource MonoTextBox}"/>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="Links" Style="{StaticResource SectionTitle}"/>
                                        <Label Content="Nexus / GameBanana URL"/>
                                        <TextBox x:Name="NexusUrlBox" TextChanged="Field_Changed"
                                                 Style="{StaticResource MonoTextBox}"/>
                                        <Label Content="Discord URL" Margin="0,14,0,0"/>
                                        <TextBox x:Name="DiscordUrlBox" TextChanged="Field_Changed"
                                                 Style="{StaticResource MonoTextBox}"/>
                                        <Label Content="Discussion URL (GitHub Discussions)" Margin="0,14,0,0"/>
                                        <TextBox x:Name="DiscussionUrlBox" TextChanged="Field_Changed"
                                                 Style="{StaticResource MonoTextBox}"/>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="Notes" Style="{StaticResource SectionTitle}"/>
                                        <TextBox x:Name="NotesBox" TextChanged="Field_Changed"
                                                 TextWrapping="Wrap" AcceptsReturn="True" Height="90"
                                                 VerticalScrollBarVisibility="Auto"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- ── Unreal / Unity / Source fields ─────────── -->
                            <StackPanel x:Name="UnrealFields" Visibility="Collapsed">
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="Game" Style="{StaticResource SectionTitle}"/>
                                        <Label Content="Game name *"/>
                                        <TextBox x:Name="UNameBox" TextChanged="Field_Changed"/>
                                        <Grid Margin="0,14,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="16"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <Label Content="Status *"/>
                                                <ComboBox x:Name="UStatusCombo" SelectionChanged="Field_Changed">
                                                    <ComboBoxItem Content="Done"/>
                                                    <ComboBoxItem Content="WIP"/>
                                                </ComboBox>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <Label x:Name="UMethodLabel" Content="Method"/>
                                                <ComboBox x:Name="UMethodCombo" SelectionChanged="Field_Changed">
                                                    <ComboBoxItem Content="(none)" Tag=""/>
                                                    <ComboBoxItem Content="native"/>
                                                    <ComboBoxItem Content="ini"/>
                                                    <ComboBoxItem Content="upgrade"/>
                                                </ComboBox>
                                                <Label x:Name="UBitnessLabel" Content="Bitness" Visibility="Collapsed"/>
                                                <ComboBox x:Name="UBitnessCombo" SelectionChanged="Field_Changed" Visibility="Collapsed">
                                                    <ComboBoxItem Content="(unknown)" Tag=""/>
                                                    <ComboBoxItem Content="32-bit" Tag="32"/>
                                                    <ComboBoxItem Content="64-bit" Tag="64"/>
                                                    <ComboBoxItem Content="Both 32 and 64-bit" Tag="both"/>
                                                </ComboBox>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Border x:Name="UpgradesSection" Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="Upgrades" Style="{StaticResource SectionTitle}" Margin="0,0,0,2"/>
                                        <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,12"
                                                   Text="Each row is one upgrade: pick a format token and a size token. Leave both blank to add no upgrade."/>

                                        <!-- Column headers -->
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="12"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="36"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Format" FontSize="12" Foreground="{DynamicResource TextTertiary}"/>
                                            <TextBlock Grid.Column="2" Text="Size" FontSize="12" Foreground="{DynamicResource TextTertiary}"/>
                                        </Grid>

                                        <StackPanel x:Name="UpgradesPanel"/>

                                        <Button Content="Add upgrade row" Click="AddUpgradeRow_Click"
                                                Style="{StaticResource SubtleButton}" t:Ui.Icon="&#xE710;"
                                                HorizontalAlignment="Left" Margin="-8,6,0,0"/>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="Comments" Style="{StaticResource SectionTitle}"/>
                                        <TextBox x:Name="UCommentsBox" TextChanged="Field_Changed"
                                                 TextWrapping="Wrap" AcceptsReturn="True" Height="80"
                                                 VerticalScrollBarVisibility="Auto"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <TextBlock x:Name="StatusLabel" Foreground="{DynamicResource SuccessText}"
                                       Margin="2,2,0,0" FontSize="12"/>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>

        <!-- ══════════════════════════════════════════════════════════════════
             ROW 2 — Status bar
             ══════════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="2" Style="{StaticResource StatusBarBorder}">
            <TextBlock x:Name="StatusBar" TextTrimming="CharacterEllipsis"
                       Text="Select a database above to get started"/>
        </Border>
    </Grid>
</Window>
