<Window x:Class="PCGWEditor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:t="clr-namespace:RhiTools.Theme"
        Title="PCGW Editor" Height="780" Width="1200" MinWidth="900" MinHeight="540"
        Style="{StaticResource ThemedWindow}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- command bar -->
            <RowDefinition Height="*"/>     <!-- tabs + content -->
            <RowDefinition Height="Auto"/>  <!-- status bar -->
        </Grid.RowDefinitions>

        <!-- ══ Command bar ══ -->
        <Border Grid.Row="0" Style="{StaticResource CommandBar}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="OpenBtn" Content="Open JSON" Click="Open_Click"
                            Style="{StaticResource SubtleButton}" t:Ui.Icon="&#xE8E5;"/>
                    <Button x:Name="SaveBtn" Content="Save" Click="Save_Click"
                            Style="{StaticResource AccentButton}" t:Ui.Icon="&#xE74E;"
                            Margin="4,0,0,0" IsEnabled="False"/>
                    <Button x:Name="SaveAsBtn" Content="Save As" Click="SaveAs_Click"
                            Style="{StaticResource SubtleButton}" t:Ui.Icon="&#xE792;"
                            Margin="4,0,0,0" IsEnabled="False"/>
                    <Separator Style="{StaticResource ToolbarSeparator}"/>
                    <Button x:Name="SyncBtn" Content="Sync" Click="Sync_Click"
                            Style="{StaticResource SubtleButton}" t:Ui.Icon="&#xE895;"
                            ToolTip="Download latest pcgw_data.json from GitHub"/>
                    <Button x:Name="PushBtn" Content="Push" Click="Push_Click"
                            Style="{StaticResource GreenButton}" t:Ui.Icon="&#xE898;"
                            Margin="4,0,0,0" IsEnabled="False"
                            ToolTip="Push current file to GitHub"/>
                    <Button x:Name="TokenBtn" Content="Token" Click="Token_Click"
                            Style="{StaticResource SubtleButton}" t:Ui.Icon="&#xE8D7;"
                            Margin="4,0,0,0" ToolTip="Set GitHub personal access token"/>
                    <Button x:Name="PcgwCredsBtn" Content="PCGW login" Click="PcgwCreds_Click"
                            Style="{StaticResource SubtleButton}" t:Ui.Icon="&#xE77B;"
                            Margin="4,0,0,0"
                            ToolTip="Set PCGW bot credentials for fetching data"/>
                    <Separator Style="{StaticResource ToolbarSeparator}"/>
                    <Button x:Name="FetchUpdatesBtn" Content="Fetch Updates" Click="FetchUpdates_Click"
                            Style="{StaticResource SubtleButton}" t:Ui.Icon="&#xE896;"
                            ToolTip="Fetch only pages changed since the last run (fast, ~30 seconds)"/>
                    <Button x:Name="FetchAllBtn" Content="Full Refresh" Click="FetchAll_Click"
                            Style="{StaticResource SubtleButton}" t:Ui.Icon="&#xE72C;"
                            Margin="4,0,0,0"
                            ToolTip="Fetch all games from PCGW (~5 minutes)"/>
                    <Button x:Name="CancelFetchBtn" Content="Cancel" Click="CancelFetch_Click"
                            Style="{StaticResource DangerButton}" t:Ui.Icon="&#xE711;"
                            Margin="4,0,0,0" Visibility="Collapsed"
                            ToolTip="Cancel the in-progress fetch"/>
                    <Separator Style="{StaticResource ToolbarSeparator}"/>
                    <Button x:Name="AutoFetchBtn" Content="Auto fetch" Click="AutoFetch_Click"
                            Style="{StaticResource SubtleButton}" t:Ui.Icon="&#xE916;"
                            ToolTip="Fetch updates on a timer and push new data to GitHub automatically; system tray"/>
                    <Button x:Name="LogBtn" Content="Log" Click="Log_Click"
                            Style="{StaticResource SubtleButton}" t:Ui.Icon="&#xE81C;"
                            Margin="4,0,0,0"
                            ToolTip="Every fetch and push: when it ran, what was fetched, whether the push worked"/>
                </WrapPanel>

            </Grid>
        </Border>

        <!-- ══ Content ══ -->
        <TabControl Grid.Row="1" x:Name="MainTabs" SelectionChanged="Tabs_Changed">

            <!-- ── Tab 1: Games ─────────────────────────────────────────────── -->
            <TabItem Header="Games">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300" MinWidth="180"/>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Search + game list -->
                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Margin="10,0,6,8">
                            <Grid>
                                <TextBox x:Name="SearchBox" TextChanged="Search_Changed" Padding="8,6,32,6"
                                         t:Ui.Placeholder="Search name or Steam AppID"
                                         ToolTip="Filter by game name or Steam AppID"/>
                                <TextBlock Text="&#xE721;" Style="{StaticResource Glyph}" FontSize="13"
                                           HorizontalAlignment="Right" Margin="0,0,11,0" IsHitTestVisible="False"
                                           Foreground="{DynamicResource TextSecondary}"/>
                            </Grid>
                            <TextBlock x:Name="CountLabel" Style="{StaticResource Hint}" Margin="2,6,0,0"/>
                        </StackPanel>
                        <ListBox x:Name="GameList" Grid.Row="1" Margin="4,0,0,0"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 SelectionChanged="GameList_Changed"
                                 DisplayMemberPath="DisplayName"/>
                    </Grid>

                    <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Cursor="SizeWE"/>

                    <!-- Game editor -->
                    <Border Grid.Column="2" Style="{StaticResource Layer}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="32,24,32,24">
                            <StackPanel x:Name="GameEditorPanel" IsEnabled="False" MaxWidth="880"
                                        HorizontalAlignment="Stretch">

                                <!-- Header: the selected page's title -->
                                <TextBlock>
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource PageTitle}">
                                            <Setter Property="Text" Value="{Binding Text, ElementName=PageNameBox}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=PageNameBox}" Value="">
                                                    <Setter Property="Text" Value="Select a game"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource TextTertiary}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,22">
                                    <TextBlock Text="&#xE71B;" Style="{StaticResource Glyph}" FontSize="12"
                                               Foreground="{DynamicResource AccentText}" Margin="0,1,6,0"/>
                                    <TextBlock x:Name="WikiUrlBlock" Style="{StaticResource LinkText}"
                                               MouseLeftButtonDown="WikiUrl_Click"
                                               ToolTip="Open the PCGamingWiki page (derived from the page name)"/>
                                </StackPanel>

                                <!-- Page -->
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="Page" Style="{StaticResource SectionTitle}"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="16"/>
                                                <ColumnDefinition Width="200"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <!-- Read-only: the PCGW page title is the key -->
                                                <Label Content="PCGW page name"/>
                                                <TextBox x:Name="PageNameBox" IsReadOnly="True"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <Label Content="Steam AppID"/>
                                                <TextBox x:Name="SteamAppIdBox" TextChanged="GameField_Changed"
                                                         Style="{StaticResource MonoTextBox}"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- APIs -->
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="Graphics API support" Style="{StaticResource SectionTitle}"/>
                                        <WrapPanel>
                                            <CheckBox x:Name="Dx9Check"    Content="DirectX 9"  Click="GameField_Changed"/>
                                            <CheckBox x:Name="Dx10Check"   Content="DirectX 10" Click="GameField_Changed"/>
                                            <CheckBox x:Name="Dx11Check"   Content="DirectX 11" Click="GameField_Changed"/>
                                            <CheckBox x:Name="Dx12Check"   Content="DirectX 12" Click="GameField_Changed"/>
                                            <CheckBox x:Name="VulkanCheck" Content="Vulkan"     Click="GameField_Changed"/>
                                            <CheckBox x:Name="OpenGLCheck" Content="OpenGL"     Click="GameField_Changed"/>
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Config paths -->
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="Config paths" Style="{StaticResource SectionTitle}"/>
                                        <Label Content="Windows / Steam"/>
                                        <TextBox x:Name="ConfigPathBox" TextChanged="GameField_Changed"
                                                 Style="{StaticResource MonoTextBox}" TextWrapping="Wrap"/>
                                        <TextBlock Style="{StaticResource Hint}"
                                                   Text="e.g. %LOCALAPPDATA%\GameName\Saved\Config\WindowsNoEditor"/>

                                        <Label Content="Microsoft Store / Xbox" Margin="0,14,0,0"/>
                                        <TextBox x:Name="ConfigPathXboxBox" TextChanged="GameField_Changed"
                                                 Style="{StaticResource MonoTextBox}" TextWrapping="Wrap"/>
                                        <TextBlock Style="{StaticResource Hint}"
                                                   Text="e.g. %LOCALAPPDATA%\GameName\Saved\Config\WinGDK"/>
                                    </StackPanel>
                                </Border>

                                <!-- Engine -->
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="Engine" Style="{StaticResource SectionTitle}"/>
                                        <TextBox x:Name="EngineBox" TextChanged="GameField_Changed" TextWrapping="Wrap"/>
                                        <TextBlock Style="{StaticResource Hint}"
                                                   Text="e.g. Unreal Engine 5, Unity, NW.js, Northlight"/>
                                    </StackPanel>
                                </Border>

                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <Button Content="Apply Changes" Click="ApplyGame_Click"
                                            Style="{StaticResource AccentButton}" t:Ui.Icon="&#xE73E;"
                                            Padding="16,6"/>
                                    <TextBlock x:Name="GameStatusLabel" Foreground="{DynamicResource SuccessText}"
                                               VerticalAlignment="Center" Margin="14,0,0,0" FontSize="12"/>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ── Tab 2: Name Mappings ──────────────────────────────────────── -->
            <TabItem Header="Name Mappings">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>  <!-- actions -->
                        <RowDefinition Height="*"/>     <!-- list + editor -->
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="14,2,14,10">
                        <Button Content="Add Mapping" Click="AddMapping_Click"
                                Style="{StaticResource AccentButton}" t:Ui.Icon="&#xE710;"/>
                        <Button x:Name="DeleteMappingBtn" Content="Delete" Click="DeleteMapping_Click"
                                Style="{StaticResource DangerButton}" t:Ui.Icon="&#xE74D;"
                                Margin="8,0,0,0" IsEnabled="False"/>
                        <TextBlock Text="Map a detected game name to a PCGamingWiki page title."
                                   Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="16,0,0,0"/>
                    </StackPanel>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="340" MinWidth="200"/>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Mappings list -->
                        <ListBox x:Name="MappingList" Grid.Column="0" Margin="4,0,0,0"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 SelectionChanged="MappingList_Changed">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock Text="{Binding DetectedName}" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimary}"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                            <TextBlock Text="&#xE72A;" Style="{StaticResource Glyph}" FontSize="10"
                                                       Foreground="{DynamicResource TextTertiary}" Margin="0,1,6,0"/>
                                            <TextBlock Text="{Binding PcgwPageName}" FontSize="12"
                                                       Foreground="{DynamicResource TextSecondary}"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Cursor="SizeWE"/>

                        <!-- Mapping editor -->
                        <Border Grid.Column="2" Style="{StaticResource Layer}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="32,24,32,24">
                                <StackPanel x:Name="MappingEditorPanel" IsEnabled="False" MaxWidth="880">

                                    <TextBlock Margin="0,0,0,22">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource PageTitle}">
                                                <Setter Property="Text" Value="{Binding Text, ElementName=DetectedNameBox}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Text, ElementName=DetectedNameBox}" Value="">
                                                        <Setter Property="Text" Value="Name mapping"/>
                                                        <Setter Property="Foreground" Value="{DynamicResource TextTertiary}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <Border Style="{StaticResource Card}">
                                        <StackPanel>
                                            <Label Content="Detected game name *"/>
                                            <TextBox x:Name="DetectedNameBox" TextChanged="MappingField_Changed"/>
                                            <TextBlock Style="{StaticResource Hint}"
                                                       Text="The name RHI detects from the store folder or game library."/>

                                            <Label Content="PCGW page title *" Margin="0,14,0,0"/>
                                            <TextBox x:Name="PcgwPageNameBox" TextChanged="MappingField_Changed"/>
                                            <TextBlock Style="{StaticResource Hint}"
                                                       Text="The exact title of the PCGamingWiki page (not the full URL)."/>

                                            <Label Content="Page URL" Margin="0,14,0,0"/>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE71B;" Style="{StaticResource Glyph}" FontSize="12"
                                                           Foreground="{DynamicResource AccentText}" Margin="0,1,6,0"/>
                                                <TextBlock x:Name="MappingUrlBlock" Style="{StaticResource LinkText}"
                                                           MouseLeftButtonDown="MappingUrl_Click"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                        <Button Content="Apply Changes" Click="ApplyMapping_Click"
                                                Style="{StaticResource AccentButton}" t:Ui.Icon="&#xE73E;"
                                                Padding="16,6"/>
                                        <TextBlock x:Name="MappingStatusLabel" Foreground="{DynamicResource SuccessText}"
                                                   VerticalAlignment="Center" Margin="14,0,0,0" FontSize="12"/>
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- ══ Status bar ══ -->
        <Border Grid.Row="2" Style="{StaticResource StatusBarBorder}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusBar" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           Text="Open a pcgw_data.json file or sync from GitHub to get started."/>
                <TextBlock x:Name="SyncStatusLabel" Grid.Column="1" VerticalAlignment="Center" Margin="16,0,0,0"/>
            </Grid>
        </Border>
    </Grid>
</Window>
