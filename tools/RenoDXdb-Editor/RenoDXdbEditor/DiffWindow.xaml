<Window x:Class="RenoDXdbEditor.DiffWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:t="clr-namespace:RhiTools.Theme"
        Title="Remote Changes Detected" Height="600" Width="860"
        MinHeight="360" MinWidth="520"
        Style="{StaticResource ThemedWindow}"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="24,20,24,14">
            <TextBlock x:Name="HeaderLabel" Text="The remote file differs from your local copy."
                       Style="{StaticResource DialogTitle}" Foreground="{DynamicResource CautionText}"/>
            <TextBlock x:Name="FileNameLabel" Style="{StaticResource Caption}" FontFamily="{StaticResource MonoFont}"
                       Margin="0,4,0,0"/>
            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                <Border Style="{StaticResource Pill}" Background="{DynamicResource SuccessBg}" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="+" FontFamily="{StaticResource MonoFont}" FontWeight="Bold"
                                   Foreground="{DynamicResource SuccessText}" Margin="0,0,6,0"/>
                        <TextBlock x:Name="AddedLegend" Text="Added (remote)" FontSize="12"
                                   Foreground="{DynamicResource SuccessText}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Pill}" Background="{DynamicResource CriticalBg}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="−" FontFamily="{StaticResource MonoFont}" FontWeight="Bold"
                                   Foreground="{DynamicResource CriticalText}" Margin="0,0,6,0"/>
                        <TextBlock x:Name="RemovedLegend" Text="Removed (local only)" FontSize="12"
                                   Foreground="{DynamicResource CriticalText}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </StackPanel>

        <!-- Diff view -->
        <Border Grid.Row="1" Margin="24,0,24,16" CornerRadius="8" BorderThickness="1"
                BorderBrush="{DynamicResource CardStroke}" Background="#1A1A1A" ClipToBounds="True">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Padding="0,6">
                <ItemsControl x:Name="DiffList" FontFamily="{StaticResource MonoFont}" FontSize="12">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="30"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="{Binding Gutter}"
                                           Foreground="{Binding GutterColor}"
                                           Background="{Binding BgColor}"
                                           TextAlignment="Center" Padding="0,2"/>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding DisplayText}"
                                           Foreground="{Binding FgColor}"
                                           Background="{Binding BgColor}"
                                           Padding="4,2,12,2"
                                           TextWrapping="NoWrap"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- Bottom buttons -->
        <Border Grid.Row="2" Style="{StaticResource DialogFooter}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="SummaryLabel" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="OverwriteBtn" Content="Overwrite Local" Click="Overwrite_Click"
                            Style="{StaticResource AccentButton}" MinWidth="130"/>
                    <Button Content="Cancel" Click="Cancel_Click" Margin="8,0,0,0" MinWidth="100" IsCancel="True"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
