<Window x:Class="PCGWEditor.TokenWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GitHub Token" Height="200" Width="500"
        Background="#1A1A2E" FontFamily="Segoe UI" FontSize="13"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="GitHub Personal Access Token"
                   Foreground="#BBBBFF" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,6"/>
        <TextBlock Grid.Row="1" Foreground="#AAAACC" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10"
                   Text="Required for pushing changes to rhi-repo. Needs repo write access (Contents: Read &amp; Write)."/>
        <TextBox x:Name="TokenBox" Grid.Row="2"
                 Background="#252540" Foreground="#E0E0F0" BorderBrush="#444466"
                 BorderThickness="1" Padding="6,4" Margin="0,0,0,14" CaretBrush="#E0E0F0"/>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Save" Click="Save_Click" Width="80" Padding="0,6"
                    Background="#2255AA" Foreground="White" BorderBrush="#3366CC" BorderThickness="1">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            <Button Content="Cancel" Click="Cancel_Click" Width="80" Padding="0,6" Margin="8,0,0,0"
                    Background="#333355" Foreground="#E0E0F0" BorderBrush="#555577" BorderThickness="1">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </StackPanel>
    </Grid>
</Window>
