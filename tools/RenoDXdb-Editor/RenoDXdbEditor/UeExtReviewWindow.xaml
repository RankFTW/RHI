<Window x:Class="RenoDXdbEditor.UeExtReviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:t="clr-namespace:RhiTools.Theme"
        Title="Wiki UE-Extended Review" Height="560" Width="820"
        MinHeight="400" MinWidth="600"
        Style="{StaticResource ThemedWindow}"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False">

    <DockPanel>
        <!-- Header -->
        <Grid DockPanel.Dock="Top" Margin="24,20,24,14">
            <StackPanel>
                <TextBlock x:Name="ProgressLabel" Text="Reviewing entry 1 of 1" Style="{StaticResource DialogTitle}"/>
                <TextBlock Text="Review each entry and choose to Accept or Skip it."
                           Style="{StaticResource Caption}" Margin="0,4,0,0"/>
            </StackPanel>
            <Border Style="{StaticResource SuccessPill}" HorizontalAlignment="Right" VerticalAlignment="Top">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Accepted " FontSize="12" Foreground="{DynamicResource SuccessText}"/>
                    <TextBlock x:Name="AcceptedCountLabel" Text="0" FontSize="12" FontWeight="SemiBold"
                               Foreground="{DynamicResource SuccessText}"/>
                    <TextBlock Text=" / " FontSize="12" Foreground="{DynamicResource SuccessText}"/>
                    <TextBlock x:Name="TotalCountLabel" Text="?" FontSize="12" Foreground="{DynamicResource SuccessText}"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Action bar -->
        <Border DockPanel.Dock="Bottom" Style="{StaticResource DialogFooter}">
            <Grid>
                <TextBlock x:Name="PositionLabel" Text="Entry 1 / ?" Style="{StaticResource Caption}"
                           VerticalAlignment="Center" HorizontalAlignment="Left"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="AcceptBtn" Content="Accept and Add" Click="Accept_Click"
                            Style="{StaticResource AccentButton}" t:Ui.Icon="&#xE73E;" Margin="0,0,8,0"/>
                    <Button x:Name="SkipBtn" Content="Skip" Click="Skip_Click"
                            t:Ui.Icon="&#xE72A;" Margin="0,0,8,0"/>
                    <Button x:Name="StopBtn" Content="Stop Review" Click="Stop_Click"
                            Style="{StaticResource DangerButton}" t:Ui.Icon="&#xE71A;"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Content: wiki (read-only) and DB (editable) side by side -->
        <Grid Margin="24,0,24,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="From the wiki" Style="{StaticResource SectionTitle}" Foreground="{DynamicResource CautionText}"/>
                        <TextBlock Text="Name" Style="{StaticResource FieldLabel}"/>
                        <TextBlock x:Name="WikiName" Style="{StaticResource FieldValue}" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Text="Status" Style="{StaticResource FieldLabel}"/>
                        <TextBlock x:Name="WikiStatus" Style="{StaticResource FieldValue}"/>
                        <TextBlock Text="Notes" Style="{StaticResource FieldLabel}"/>
                        <TextBlock x:Name="WikiNotes" Style="{StaticResource FieldValue}" Foreground="{DynamicResource TextSecondary}"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Card}" Margin="0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Will be added as" Style="{StaticResource SectionTitle}" Foreground="{DynamicResource AccentText}"/>
                        <Label Content="Name *"/>
                        <TextBox x:Name="DbNameBox"/>
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <Label Content="Status"/>
                                <ComboBox x:Name="DbStatusCombo">
                                    <ComboBoxItem Content="Done"/>
                                    <ComboBoxItem Content="WIP"/>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <Label Content="Method"/>
                                <ComboBox x:Name="DbMethodCombo">
                                    <ComboBoxItem Content="(none)" Tag=""/>
                                    <ComboBoxItem Content="native" Tag="native"/>
                                    <ComboBoxItem Content="ini"    Tag="ini"/>
                                    <ComboBoxItem Content="upgrade" Tag="upgrade"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>
                        <Label Content="Comments" Margin="0,12,0,0"/>
                        <TextBox x:Name="DbCommentsBox" AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto" Height="90" TextWrapping="Wrap"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </DockPanel>
</Window>
