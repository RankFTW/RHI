<Window x:Class="PCGWEditor.PcgwCredentialsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PCGW Bot Credentials" Height="280" Width="520"
        Background="#1A1A2E" FontFamily="Segoe UI" FontSize="13"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="PCGamingWiki Bot Credentials"
                   Foreground="#BBBBFF" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,4"/>
        <TextBlock Grid.Row="1" Foreground="#AAAACC" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,14">
            Required for fetching from PCGW. Use a bot password from Special:BotPasswords&#10;(username format: YourName@BotName — needs Cargo query + High-volume access grants).
        </TextBlock>

        <Label Grid.Row="2" Content="Username (e.g. Rankftw@Fiatbrava14!)"
               Foreground="#AAAACC" Padding="0,0,0,2"/>
        <TextBox x:Name="UsernameBox" Grid.Row="3"
                 Background="#252540" Foreground="#E0E0F0" BorderBrush="#444466"
                 BorderThickness="1" Padding="6,4" Margin="0,0,0,10" CaretBrush="#E0E0F0"/>

        <Label Grid.Row="4" Content="Password (generated bot password)"
               Foreground="#AAAACC" Padding="0,0,0,2"/>
        <PasswordBox x:Name="PasswordBox" Grid.Row="5"
                     Background="#252540" Foreground="#E0E0F0" BorderBrush="#444466"
                     BorderThickness="1" Padding="6,4" Margin="0,0,0,14"
                     CaretBrush="#E0E0F0"/>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right"
                    Margin="0,50,0,0">
            <Button Content="Save" Click="Save_Click" Width="80" Padding="0,6"
                    Background="#2255AA" Foreground="White" BorderBrush="#3366CC" BorderThickness="1">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#3366BB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            <Button Content="Cancel" Click="Cancel_Click" Width="80" Padding="0,6" Margin="8,0,0,0"
                    Background="#333355" Foreground="#E0E0F0" BorderBrush="#555577" BorderThickness="1">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </StackPanel>
    </Grid>
</Window>
