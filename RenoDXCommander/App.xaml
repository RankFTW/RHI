<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="RenoDXCommander.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:RenoDXCommander.Controls">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <ResourceDictionary Source="Themes/DarkTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Buttons switch hover/press colours instantly: with Windows animation effects on, the
                 template's fade to the default near-transparent hover colour flashed bright (ButtonFade.cs) -->
            <Style TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="controls:ButtonFade.Disabled" Value="True"/>
            </Style>

            <!-- Title-bar colours (extracted from hardcoded values for easy theming) -->
            <Color x:Key="TitleBarBackground">#FF0F1318</Color>
            <Color x:Key="TitleBarForeground">#FFE8ECF2</Color>
            <Color x:Key="TitleBarInactiveBackground">#FF0F1318</Color>
            <Color x:Key="TitleBarInactiveForeground">#FF6B7A8E</Color>
            <Color x:Key="TitleBarButtonBackground">#FF0F1318</Color>
            <Color x:Key="TitleBarButtonForeground">#FFA0AABB</Color>
            <Color x:Key="TitleBarButtonHoverBackground">#FF1E242C</Color>
            <Color x:Key="TitleBarButtonHoverForeground">#FFE8ECF2</Color>
            <Color x:Key="TitleBarButtonPressedBackground">#FF283240</Color>
            <Color x:Key="TitleBarButtonPressedForeground">#FFE8ECF2</Color>
            <Color x:Key="TitleBarButtonInactiveBackground">#FF0F1318</Color>
            <Color x:Key="TitleBarButtonInactiveForeground">#FF404858</Color>

            <!-- Tooltips: same navy look as RHI's own in-window tooltips (TabsTheme.SetHandTip) -->
            <SolidColorBrush x:Key="ToolTipBackground" Color="#FF161D2B"/>
            <SolidColorBrush x:Key="ToolTipBorderBrush" Color="#FF2A3446"/>
            <SolidColorBrush x:Key="ToolTipForeground" Color="#FFE6EAF2"/>
            <Thickness x:Key="ToolTipBorderThemeThickness">1</Thickness>
            <Style TargetType="ToolTip" BasedOn="{StaticResource DefaultToolTipStyle}">
                <Setter Property="Background" Value="#FF161D2B"/>
                <Setter Property="BorderBrush" Value="#FF2A3446"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Foreground" Value="#FFE6EAF2"/>
                <Setter Property="CornerRadius" Value="6"/>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
