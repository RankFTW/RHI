<Window x:Class="RenoDXdbEditor.UnityReviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:t="clr-namespace:RhiTools.Theme"
        Title="Wiki Unity Review" Height="620" Width="880"
        MinHeight="440" MinWidth="620"
        Style="{StaticResource ThemedWindow}"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False">

    <DockPanel>
        <!-- Header -->
        <Grid DockPanel.Dock="Top" Margin="24,20,24,14">
            <StackPanel>
                <TextBlock x:Name="ProgressLabel" Text="Reviewing entry 1 of 1" Style="{StaticResource DialogTitle}"/>
                <TextBlock Text="Review each Unity game and choose to Accept or Skip it."
                           Style="{StaticResource Caption}" Margin="0,4,0,0"/>
            </StackPanel>
            <Border Style="{StaticResource SuccessPill}" HorizontalAlignment="Right" VerticalAlignment="Top">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Accepted " FontSize="12" Foreground="{DynamicResource SuccessText}"/>
                    <TextBlock x:Name="AcceptedCountLabel" Text="0" FontSize="12" FontWeight="SemiBold"
                               Foreground="{DynamicResource SuccessText}"/>
                    <TextBlock Text=" / " FontSize="12" Foreground="{DynamicResource SuccessText}"/>
                    <TextBlock x:Name="TotalCountLabel" Text="?" FontSize="12" Foreground="{DynamicResource SuccessText}"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Action bar -->
        <Border DockPanel.Dock="Bottom" Style="{StaticResource DialogFooter}">
            <Grid>
                <TextBlock x:Name="PositionLabel" Text="Entry 1 / ?" Style="{StaticResource Caption}"
                           VerticalAlignment="Center" HorizontalAlignment="Left"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="AcceptBtn" Content="Accept and Add" Click="Accept_Click"
                            Style="{StaticResource AccentButton}" t:Ui.Icon="&#xE73E;" Margin="0,0,8,0"/>
                    <Button Content="Skip" Click="Skip_Click" t:Ui.Icon="&#xE72A;" Margin="0,0,8,0"/>
                    <Button Content="Stop Review" Click="Stop_Click"
                            Style="{StaticResource DangerButton}" t:Ui.Icon="&#xE71A;"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Content -->
        <Grid Margin="24,0,24,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left: wiki read-only -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="From the wiki" Style="{StaticResource SectionTitle}" Foreground="{DynamicResource CautionText}"/>
                        <TextBlock Text="Name" Style="{StaticResource FieldLabel}"/>
                        <TextBlock x:Name="WikiName" Style="{StaticResource FieldValue}" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Text="Status" Style="{StaticResource FieldLabel}"/>
                        <TextBlock x:Name="WikiStatus" Style="{StaticResource FieldValue}"/>
                        <TextBlock Text="Raw notes" Style="{StaticResource FieldLabel}"/>
                        <TextBlock x:Name="WikiNotes" Style="{StaticResource FieldValue}" Foreground="{DynamicResource TextSecondary}"/>
                        <TextBlock Text="Parsed upgrades" Style="{StaticResource FieldLabel}"/>
                        <TextBlock x:Name="WikiUpgradesParsed" Style="{StaticResource FieldUrl}"/>
                        <TextBlock Text="Parsed comments" Style="{StaticResource FieldLabel}"/>
                        <TextBlock x:Name="WikiCommentsParsed" Style="{StaticResource FieldValue}" Foreground="{DynamicResource TextSecondary}"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Right: editable -->
            <Border Grid.Column="2" Style="{StaticResource Card}" Margin="0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Will be added as" Style="{StaticResource SectionTitle}" Foreground="{DynamicResource AccentText}"/>
                        <Label Content="Name *"/>
                        <TextBox x:Name="DbNameBox"/>
                        <Label Content="Status" Margin="0,12,0,0"/>
                        <ComboBox x:Name="DbStatusCombo" HorizontalAlignment="Left" MinWidth="160">
                            <ComboBoxItem Content="Done"/>
                            <ComboBoxItem Content="WIP"/>
                        </ComboBox>

                        <Label Content="Upgrades" Margin="0,12,0,0"/>
                        <TextBlock Text="One row per setting. Swapchain_Encoding: 0 = Linear, 1 = Gamma."
                                   Style="{StaticResource Hint}" Margin="0,0,0,8"/>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="34"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Key" FontSize="12" Foreground="{DynamicResource TextTertiary}"/>
                            <TextBlock Grid.Column="2" Text="Value" FontSize="12" Foreground="{DynamicResource TextTertiary}"/>
                        </Grid>
                        <StackPanel x:Name="UpgradesPanel"/>
                        <Button Content="Add upgrade row" Click="AddUpgradeRow_Click"
                                Style="{StaticResource SubtleButton}" t:Ui.Icon="&#xE710;"
                                HorizontalAlignment="Left" Margin="-8,4,0,0"/>

                        <Label Content="Comments" Margin="0,12,0,0"/>
                        <TextBox x:Name="DbCommentsBox" AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto" Height="90" TextWrapping="Wrap"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </DockPanel>
</Window>
