<Page
    x:Class="RHI.ManifestEditor.Views.UeHdrPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer Padding="16">
        <StackPanel Spacing="20">
            <TextBlock Text="Unreal Engine HDR / UE-Extended" FontSize="20" FontWeight="SemiBold"/>
            <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="Controls which games use UE-Extended (renodx-ue-extended.addon64). Priority: ueExtendedCompatibility &gt; noUeExtendedGames &gt; nativeHdrGames &gt; ueExtendedGames."/>

            <Expander IsExpanded="True" HorizontalAlignment="Stretch">
                <Expander.Header><TextBlock Text="nativeHdrGames — force UE-Extended (bypasses named mod check)" FontWeight="SemiBold"/></Expander.Header>
                <StackPanel Spacing="4" Padding="0,8,0,0">
                    <TextBlock FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="Games that always get UE-Extended even if a named wiki mod exists. UE toggle hidden on card."/>
                    <ListView x:Name="NativeHdrView" MaxHeight="220" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnSpacing="8" Margin="0,2,0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Text="{Binding Value, Mode=TwoWay}" FontSize="12"/>
                                    <Button Grid.Column="1" Content="✕" Tag="{Binding}" Click="RemoveNativeHdr_Click" Padding="8,4"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <Button Content="+ Add" Click="AddNativeHdr_Click"/>
                </StackPanel>
            </Expander>

            <Expander HorizontalAlignment="Stretch">
                <Expander.Header><TextBlock Text="ueExtendedCompatibility — highest priority config (hdr/lut flags)" FontWeight="SemiBold"/></Expander.Header>
                <StackPanel Spacing="4" Padding="0,8,0,0">
                    <TextBlock FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="Presence = forced UE-Extended. hdr=false skips HDR Engine.ini keys. lut=false skips LUT key."/>
                    <ListView x:Name="UeCompatView" MaxHeight="220" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnSpacing="8" Margin="0,2,0,2">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="120"/><ColumnDefinition Width="120"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Text="{Binding GameName, Mode=TwoWay}" PlaceholderText="game name" FontSize="12"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                        <TextBlock Text="hdr" VerticalAlignment="Center" FontSize="12"/>
                                        <CheckBox IsChecked="{Binding Hdr, Mode=TwoWay}" IsThreeState="True"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                        <TextBlock Text="lut" VerticalAlignment="Center" FontSize="12"/>
                                        <CheckBox IsChecked="{Binding Lut, Mode=TwoWay}" IsThreeState="True"/>
                                    </StackPanel>
                                    <Button Grid.Column="3" Content="✕" Tag="{Binding}" Click="RemoveUeCompat_Click" Padding="8,4"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <Button Content="+ Add" Click="AddUeCompat_Click"/>
                </StackPanel>
            </Expander>

            <Expander HorizontalAlignment="Stretch">
                <Expander.Header><TextBlock Text="noUeExtendedGames — block UE-Extended (highest priority)" FontWeight="SemiBold"/></Expander.Header>
                <StackPanel Spacing="4" Padding="0,8,0,0">
                    <TextBlock FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="Overrides everything including nativeHdrGames. Use for anti-cheat or known incompatible games."/>
                    <ListView x:Name="NoUeView" MaxHeight="160" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnSpacing="8" Margin="0,2,0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Text="{Binding Value, Mode=TwoWay}" FontSize="12"/>
                                    <Button Grid.Column="1" Content="✕" Tag="{Binding}" Click="RemoveNoUe_Click" Padding="8,4"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <Button Content="+ Add" Click="AddNoUe_Click"/>
                </StackPanel>
            </Expander>

            <Expander HorizontalAlignment="Stretch">
                <Expander.Header><TextBlock Text="lumaRenodxCompat — allow RenoDX and Luma to coexist" FontWeight="SemiBold"/></Expander.Header>
                <StackPanel Spacing="4" Padding="0,8,0,0">
                    <TextBlock FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="Exact game name match (case-sensitive). Normally enabling Luma removes RenoDX."/>
                    <ListView x:Name="LumaCompatView" MaxHeight="160" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnSpacing="8" Margin="0,2,0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Text="{Binding Value, Mode=TwoWay}" FontSize="12"/>
                                    <Button Grid.Column="1" Content="✕" Tag="{Binding}" Click="RemoveLumaCompat_Click" Padding="8,4"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <Button Content="+ Add" Click="AddLumaCompat_Click"/>
                </StackPanel>
            </Expander>

        </StackPanel>
    </ScrollViewer>
</Page>
