<Window x:Class="RenoDXdbEditor.DiffWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Remote Changes Detected" Height="560" Width="820"
        MinHeight="360" MinWidth="520"
        Background="#1A1A2E" FontFamily="Segoe UI" FontSize="13"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background"  Value="#333355"/>
            <Setter Property="Foreground"  Value="#E0E0F0"/>
            <Setter Property="BorderBrush" Value="#555577"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"     Value="16,6"/>
            <Setter Property="Cursor"      Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#444466"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background"  Value="#2255AA"/>
            <Setter Property="BorderBrush" Value="#3366CC"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#3366BB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#14142A" BorderBrush="#333355"
                BorderThickness="0,0,0,1" Padding="16,12">
            <StackPanel>
                <TextBlock Text="The remote file differs from your local copy."
                           Foreground="#FFCC44" FontSize="14" FontWeight="SemiBold"/>
                <TextBlock x:Name="FileNameLabel" Foreground="#AAAACC" FontSize="11" Margin="0,4,0,0"/>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0" Opacity="0.8">
                    <Border Background="#2D4D2D" BorderBrush="#3A6A3A" BorderThickness="1"
                            CornerRadius="3" Padding="8,3" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="■" Foreground="#55CC77" FontSize="10" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <TextBlock Text="Added (remote)" Foreground="#88EE88" FontSize="11"/>
                        </StackPanel>
                    </Border>
                    <Border Background="#4D2D2D" BorderBrush="#6A3A3A" BorderThickness="1"
                            CornerRadius="3" Padding="8,3">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="■" Foreground="#EE5555" FontSize="10" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <TextBlock Text="Removed (local only)" Foreground="#EE8888" FontSize="11"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Diff view -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Auto"
                      Background="#0F0F1E">
            <ItemsControl x:Name="DiffList" FontFamily="Consolas" FontSize="12">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <!-- Gutter -->
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="{Binding Gutter}"
                                       Foreground="{Binding GutterColor}"
                                       Background="{Binding BgColor}"
                                       FontSize="11" FontFamily="Consolas"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center"
                                       Padding="0,1"/>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding DisplayText}"
                                       Foreground="{Binding FgColor}"
                                       Background="{Binding BgColor}"
                                       Padding="4,2"
                                       TextWrapping="NoWrap"/>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Bottom buttons -->
        <Border Grid.Row="2" Background="#14142A" BorderBrush="#333355"
                BorderThickness="0,1,0,0" Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="SummaryLabel" Foreground="#AAAACC" FontSize="11"
                           VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Overwrite Local" Click="Overwrite_Click"
                            Style="{StaticResource AccentButton}"/>
                    <Button Content="Cancel" Click="Cancel_Click" Margin="8,0,0,0"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
