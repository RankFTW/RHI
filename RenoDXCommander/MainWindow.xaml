                                        VerticalAlignment="Stretch" Margin="12,0,12,0"/>

                                <!-- ── Right: HDR & Peak Brightness ── -->
                                <StackPanel Grid.Row="0" Grid.Column="2" Spacing="4">
                                    <TextBlock Text="{Binding [L8672ccd3c93f_Text], Source={StaticResource LocalizedStrings}, Mode=OneWay}" FontSize="14" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <TextBlock TextWrapping="Wrap" FontSize="11"
                                               Foreground="{StaticResource InlineDescriptionBrush}" LineHeight="18"
                                               Text="{Binding [Lae5eb515f8e0_Text], Source={StaticResource LocalizedStrings}, Mode=OneWay}"/>
                                </StackPanel>

                                <!-- Row 1 Left: Screenshot path + Open -->
                                <Grid Grid.Row="1" Grid.Column="0" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid Grid.Column="0">
                                        <TextBox x:Name="ScreenshotPathBox" x:FieldModifier="internal"
                                                 PlaceholderText="{Binding [L68e33020d3f0_PlaceholderText], Source={StaticResource LocalizedStrings}, Mode=OneWay}"
                                                 FontSize="12" Padding="12,8,36,8"
                                                 Background="{StaticResource SurfaceInputBrush}"
                                                 Foreground="{StaticResource TextSecondaryBrush}"
                                                 BorderBrush="{StaticResource BorderSubtleBrush}"/>
                                        <Button Click="BrowseScreenshotPath_Click"
                                                Background="Transparent" BorderThickness="0"
                                                Padding="8,6" MinWidth="0" MinHeight="0"
                                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                                Margin="0,0,4,0"
                                                ToolTipService.ToolTip="{Binding [L9e1e2edf6018_ToolTip], Source={StaticResource LocalizedStrings}, Mode=OneWay}">
                                            <FontIcon Glyph="&#xED25;" FontSize="14"
                                                      Foreground="{StaticResource TextTertiaryBrush}"/>
                                        </Button>
                                    </Grid>
                                    <Button Grid.Column="1" Content="{Binding [Ld3d1126f3f40_Content], Source={StaticResource LocalizedStrings}, Mode=OneWay}" Click="OpenScreenshotFolder_Click"
                                            Background="{StaticResource AccentBlueBgBrush}" Foreground="{StaticResource AccentBlueBrush}"
