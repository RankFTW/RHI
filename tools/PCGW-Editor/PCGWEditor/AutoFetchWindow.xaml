<Window x:Class="PCGWEditor.AutoFetchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Auto fetch" SizeToContent="Height" Width="520"
        Style="{StaticResource ThemedWindow}"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False">
    <StackPanel>
        <StackPanel Margin="24,20,24,20">
            <TextBlock Text="Automatic fetch and push" Style="{StaticResource DialogTitle}" Margin="0,0,0,6"/>
            <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,18" TextWrapping="Wrap"
                       Text="Runs Fetch Updates on a timer. When PCGW has something new, the file is saved and pushed to GitHub with no clicks. Every run is written to the Log."/>

            <CheckBox x:Name="EnabledBox" Content="Fetch updates automatically" Margin="0,0,0,12"/>

            <TextBlock Text="How often" Style="{StaticResource FieldLabel}" Margin="0,0,0,6"/>
            <ComboBox x:Name="IntervalBox" Margin="0,0,0,14" HorizontalAlignment="Left" MinWidth="220"/>

            <CheckBox x:Name="PushBox" Content="Push to GitHub when something new is found" Margin="0,0,0,10"/>
            <CheckBox x:Name="TrayBox" Content="Keep running in the system tray when closed or minimised" Margin="0,0,0,4"/>
            <TextBlock Style="{StaticResource Caption}" Margin="28,0,0,16" TextWrapping="Wrap"
                       Text="Double-click the tray icon to open the editor. Right-click it to fetch now or exit."/>

            <Border Style="{StaticResource Card}" Padding="14,10">
                <StackPanel>
                    <TextBlock x:Name="LastRunText" Style="{StaticResource Caption}"/>
                    <TextBlock x:Name="NextRunText" Style="{StaticResource Caption}" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <Border Style="{StaticResource DialogFooter}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Content="Save" Click="Save_Click" Style="{StaticResource AccentButton}" IsDefault="True"/>
                <Button Grid.Column="2" Content="Save and run now" Click="RunNow_Click"
                        ToolTip="Save these settings and run a fetch straight away"/>
                <Button Grid.Column="4" Content="Cancel" Click="Cancel_Click" IsCancel="True"/>
            </Grid>
        </Border>
    </StackPanel>
</Window>
