                                    <TextBlock x:Name="DetailDcLabel" x:FieldModifier="internal" Grid.Column="0" Text="Display Commander" FontSize="12"
                                               Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="DetailDcStatus" x:FieldModifier="internal" Grid.Column="1" FontSize="12"
                                               VerticalAlignment="Center" HorizontalTextAlignment="Center"
                                               PointerPressed="DetailDcStatus_PointerPressed"
                                               PointerEntered="LinkText_PointerEntered" PointerExited="LinkText_PointerExited"/>
                                    <Button x:Name="DetailDcInfoBtn" x:FieldModifier="internal" Grid.Column="2"
                                            Content="Info" FontSize="11" Padding="6,2,6,2"
                                            Background="{StaticResource SurfaceOverlayBrush}"
                                            Foreground="{StaticResource TextSecondaryBrush}"
                                            BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1"
                                            CornerRadius="8" Width="36" Height="32"
                                            Click="InfoButton_Click"/>
                                    <Button x:Name="DetailDcInstallBtn" x:FieldModifier="internal" Grid.Column="3"
                                            Click="InstallDcButton_Click"
                                            HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                            CornerRadius="8" FontSize="12" Height="32"/>
                                    <Button x:Name="DetailDcIniBtn" x:FieldModifier="internal" Grid.Column="4"
                                            Click="DcCogButton_Click"
                                            Background="{StaticResource SurfaceOverlayBrush}" Foreground="{StaticResource TextSecondaryBrush}"
                                            BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1"
                                            CornerRadius="8" Width="36" Height="32" Padding="0"
                                            ToolTipService.ToolTip="Display Commander Settings">
                                        <TextBlock Text="⚙" FontSize="14" HorizontalAlignment="Center"/>
                                    </Button>
                                    <Button x:Name="DetailDcDeleteBtn" x:FieldModifier="internal" Grid.Column="5"
                                            Click="UninstallDcButton_Click"
                                            Background="{StaticResource AccentRedBgBrush}" Foreground="{StaticResource AccentRedBrush}"
                                            BorderBrush="{StaticResource AccentPurpleBorderBrush}" BorderThickness="1"
                                            CornerRadius="8" Width="36" Height="32" Padding="0"
                                            ToolTipService.ToolTip="Remove Display Commander" Opacity="0" IsHitTestVisible="False">
                                        <TextBlock Text="✕" FontSize="12" HorizontalAlignment="Center" Foreground="{StaticResource AccentRedBrush}"/>
                                    </Button>
                                </Grid>

                                <!-- No mod message -->
                                <Border x:Name="DetailNoModMsg" x:FieldModifier="internal" Visibility="Collapsed"
                                        Background="{StaticResource AccentPurpleBgBrush}" CornerRadius="8" Padding="12,8"
                                        BorderBrush="{StaticResource AccentPurpleBorderBrush}" BorderThickness="1">
                                    <TextBlock Text="No RenoDX mod available for this game"
                                               FontSize="12" Foreground="{StaticResource TextDisabledBrush}" TextAlignment="Center"/>
                                </Border>

                                <!-- Progress bars -->
                                <StackPanel x:Name="DetailProgressSection" Spacing="4">
                                    <ProgressBar x:Name="DetailRefProgress" x:FieldModifier="internal" Visibility="Collapsed"
                                                 Maximum="100" Height="3" CornerRadius="2"
                                                 Foreground="{StaticResource AccentBlueBrush}" Background="{StaticResource SurfaceToolbarBrush}"/>
                                    <TextBlock x:Name="DetailRefMessage" x:FieldModifier="internal" FontSize="10" Foreground="{StaticResource AccentBlueBrush}"
                                               Visibility="Collapsed" TextWrapping="Wrap"/>

                                    <ProgressBar x:Name="DetailRsProgress" x:FieldModifier="internal" Visibility="Collapsed"
                                                 Maximum="100" Height="3" CornerRadius="2"
                                                 Foreground="{StaticResource AccentTealDimBrush}" Background="{StaticResource SurfaceToolbarBrush}"/>
                                    <TextBlock x:Name="DetailRsMessage" x:FieldModifier="internal" FontSize="10" Foreground="{StaticResource TextTertiaryBrush}"
                                               Visibility="Collapsed" TextWrapping="Wrap"/>

                                    <ProgressBar x:Name="DetailUlProgress" x:FieldModifier="internal" Visibility="Collapsed"
                                                 Maximum="100" Height="3" CornerRadius="2"
                                                 Foreground="{StaticResource AccentBlueBrush}" Background="{StaticResource SurfaceToolbarBrush}"/>
                                    <TextBlock x:Name="DetailUlMessage" x:FieldModifier="internal" FontSize="10" Foreground="{StaticResource AccentBlueBrush}"
                                               Visibility="Collapsed" TextWrapping="Wrap"/>
                                    <ProgressBar x:Name="DetailDcProgress" x:FieldModifier="internal" Visibility="Collapsed"
                                                 Maximum="100" Height="3" CornerRadius="2"
                                                 Foreground="{StaticResource AccentBlueBrush}" Background="{StaticResource SurfaceToolbarBrush}"/>
                                    <TextBlock x:Name="DetailDcMessage" x:FieldModifier="internal" FontSize="10" Foreground="{StaticResource AccentBlueBrush}"
                                               Visibility="Collapsed" TextWrapping="Wrap"/>
                                    <ProgressBar x:Name="DetailDofFixProgress" x:FieldModifier="internal" Visibility="Collapsed"
                                                 Maximum="100" Height="3" CornerRadius="2"
                                                 Foreground="{StaticResource AccentBlueBrush}" Background="{StaticResource SurfaceToolbarBrush}"/>
                                    <TextBlock x:Name="DetailDofFixMessage" x:FieldModifier="internal" FontSize="10" Foreground="{StaticResource AccentBlueBrush}"
                                               Visibility="Collapsed" TextWrapping="Wrap"/>
                                    <ProgressBar x:Name="DetailDxvkProgress" x:FieldModifier="internal" Visibility="Collapsed"
                                                 Maximum="100" Height="3" CornerRadius="2"
                                                 Foreground="{StaticResource AccentBlueBrush}" Background="{StaticResource SurfaceToolbarBrush}"/>
                                    <TextBlock x:Name="DetailDxvkMessage" x:FieldModifier="internal" FontSize="10" Foreground="{StaticResource AccentBlueBrush}"
                                               Visibility="Collapsed" TextWrapping="Wrap"/>
                                    <ProgressBar x:Name="DetailRdxProgress" x:FieldModifier="internal" Visibility="Collapsed"
                                                 Maximum="100" Height="3" CornerRadius="2"
                                                 Foreground="{StaticResource AccentBlueBrush}" Background="{StaticResource SurfaceToolbarBrush}"/>
                                    <TextBlock x:Name="DetailRdxMessage" x:FieldModifier="internal" FontSize="10" Foreground="{StaticResource AccentBlueBrush}"
                                               Visibility="Collapsed" TextWrapping="Wrap"/>
                                    <ProgressBar x:Name="DetailLumaProgress" x:FieldModifier="internal" Visibility="Collapsed"
                                                 Maximum="100" Height="3" CornerRadius="2"
                                                 Foreground="{StaticResource AccentGreenBrush}" Background="{StaticResource SurfaceToolbarBrush}"/>
                                    <TextBlock x:Name="DetailLumaMessage" x:FieldModifier="internal" FontSize="10" Foreground="{StaticResource AccentGreenBrush}"
                                               Visibility="Collapsed" TextWrapping="Wrap"/>
                                </StackPanel>
                                </StackPanel><!-- /DetailComponentsBody -->
                            </StackPanel>
                        </Border>

                        <!-- ── Game Overrides section ── -->
                        <Border x:Name="OverridesContainer" x:FieldModifier="internal"
                                Background="{StaticResource SurfaceComponentTableBrush}" CornerRadius="12"
                                BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1"
                                Padding="14,12" Visibility="Collapsed">
                            <StackPanel Spacing="8">
                                <!-- Collapse header — wired in BuildOverridesPanel -->
                                <StackPanel x:Name="OverridesHeaderRow" x:FieldModifier="internal"
                                            Orientation="Horizontal" Spacing="0"/>
                                <!-- Body — all overrides content added here by builder -->
                                <StackPanel x:Name="OverridesPanel" x:FieldModifier="internal" Spacing="6"/>
                            </StackPanel>
                        </Border>

                        <!-- ── Neural Rendering section ── -->
                        <Border x:Name="NeuralRenderingContainer" x:FieldModifier="internal"
                                Background="{StaticResource SurfaceComponentTableBrush}" CornerRadius="12"
                                BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1"
                                Padding="14,12" Visibility="Collapsed">
                            <StackPanel x:Name="NeuralRenderingPanel" x:FieldModifier="internal" Spacing="6"/>
                        </Border>

                        <!-- ── DLSS / Streamline section ── -->
                        <Border x:Name="NvidiaProfileDlssContainer" x:FieldModifier="internal"
                                Background="{StaticResource SurfaceComponentTableBrush}" CornerRadius="12"
                                BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1"
                                Padding="14,12" Visibility="Collapsed">
                            <StackPanel x:Name="NvidiaProfileDlssPanel" x:FieldModifier="internal" Spacing="6"/>
                        </Border>

                        <!-- ── Driver Settings section ── -->
                        <Border x:Name="NvidiaProfileDriverContainer" x:FieldModifier="internal"
                                Background="{StaticResource SurfaceComponentTableBrush}" CornerRadius="12"
                                BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1"
                                Padding="14,12" Visibility="Collapsed">
                            <StackPanel x:Name="NvidiaProfileDriverPanel" x:FieldModifier="internal" Spacing="6"/>
                        </Border>

                        <!-- ── Legacy container — kept for migration, never shown ── -->
                        <Border x:Name="NvidiaProfileContainer" x:FieldModifier="internal"
                                Visibility="Collapsed"/>

                        <!-- ── Management section (folder, reset, report) ── -->
                        <Border x:Name="ManagementContainer" x:FieldModifier="internal"
                                Background="{StaticResource SurfaceComponentTableBrush}" CornerRadius="12"
                                BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1"
                                Padding="14,12" Visibility="Collapsed">
                            <StackPanel x:Name="ManagementPanel" x:FieldModifier="internal" Spacing="6"/>
                        </Border>
                        <!-- ── Extras section ── -->
                        <Border x:Name="ExtrasContainer" x:FieldModifier="internal"
                                Background="{StaticResource SurfaceComponentTableBrush}" CornerRadius="12"
                                BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1"
                                Padding="14,12" Visibility="Collapsed">
                            <StackPanel Spacing="6">
                                <StackPanel x:Name="ExtrasPanel" x:FieldModifier="internal" Spacing="6"/>
                                <ProgressBar x:Name="DetailOsProgress" x:FieldModifier="internal" Visibility="Collapsed"
                                             Maximum="100" Height="3" CornerRadius="2"
                                             Foreground="{StaticResource AccentBlueBrush}" Background="{StaticResource SurfaceToolbarBrush}"/>
                                <TextBlock x:Name="DetailOsMessage" x:FieldModifier="internal" FontSize="10" Foreground="{StaticResource AccentBlueBrush}"
                                           Visibility="Collapsed" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                    <!-- Skeleton detail panel overlay (removed programmatically after first load) -->
                    <ScrollViewer x:Name="SkeletonDetailScrollViewer" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled" Visibility="Visible">
                        <StackPanel x:Name="SkeletonDetailPanel" Spacing="16"
                                    Padding="24,18,24,24"/>
                    </ScrollViewer>

                </Grid>
            </Grid>

            <!--  SETTINGS PANEL  -->
            <Grid x:Name="SettingsPanel" x:FieldModifier="internal" Visibility="Collapsed" Background="{StaticResource SurfaceBaseBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Back button bar -->
                <Border Grid.Row="0" Padding="24,12,24,10" Background="{StaticResource SurfaceHeaderBrush}"
                        BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,0,0,1">
                    <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                        <Button x:Name="SettingsBackBtn" Content="← Back to Games"
                                Click="SettingsBack_Click"
                                Background="{StaticResource SurfaceOverlayBrush}" Foreground="{StaticResource TextSecondaryBrush}"
                                BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1"
                                CornerRadius="8" Padding="12,6" FontSize="12"/>
                        <TextBlock Text="Settings" FontSize="20" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="Most settings save as soon as you change them. Hover a setting for details."
                                   FontSize="12" Foreground="{StaticResource SettingsHelpBrush}" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Border>

                <!-- Scrollable settings content -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <!-- Width and alignment are set from C# (SettingsHandler.Navigation) once the section list is added -->
                    <StackPanel x:Name="SettingsCardsPanel" x:FieldModifier="internal"
                                Padding="32,24,32,40" Spacing="28" MaxWidth="1000"
                                HorizontalAlignment="Center">
                        <!-- Settings buttons keep their own text colour on hover/press (the hover shows through the
                             background). WinUI could leave the hover text colour stuck after the pointer left. -->
                        <StackPanel.Resources>
                            <StaticResource x:Key="ButtonForegroundPointerOver" ResourceKey="SettingsLabelBrush"/>
                            <StaticResource x:Key="ButtonForegroundPressed" ResourceKey="SettingsLabelBrush"/>
                        </StackPanel.Resources>

                        <!-- ══════════════════════════════════════════════════════════
                             SETTINGS SECTIONS — each section is an unnamed StackPanel with
                             Tag="Section:<Key>" (found from C# by Tag, never by x:Name).
                             Keys: General, Accounts, ReShade, Display, Dlss, Driver, Components, Tools.
                             New settings go into the matching section.
                             ══════════════════════════════════════════════════════════ -->

                        <!-- ══════════════════════════════════════════════════════════
                             SECTION 1: GENERAL
                             Layout follows the agreed mock-up: cards with two columns of
                             label-left / control-right rows (styles in Themes/DarkTheme.xaml).
                             ══════════════════════════════════════════════════════════ -->
                        <StackPanel Tag="Section:General" Spacing="12">
                            <StackPanel Spacing="3">
                                <TextBlock Text="General" FontSize="18" FontWeight="Bold"
                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="Updates and how RHI behaves on your PC. Start here if you are new."
                                           FontSize="12" LineHeight="17" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>

                            <!-- Card: Updates -->
                            <Border Style="{StaticResource SettingsCardStyle}">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="Updates" Style="{StaticResource SettingsCardTitleStyle}"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Left: Check for updates (countdown is inserted above the note in C#) + Components to check -->
                                        <StackPanel Grid.Column="0" Spacing="9" Margin="0,0,20,0" VerticalAlignment="Top">
                                            <TextBlock Text="Check for updates" Style="{StaticResource SettingsHeadStyle}"/>
                                            <TextBlock Style="{StaticResource SettingsNoteStyle}"
                                                       Text="RHI checks every 4 hours while it's open. Check now to skip the wait."/>
                                            <Button x:Name="CheckForUpdatesBtn" Content="Check for updates"
                                                    Click="CheckForUpdatesButton_Click"
                                                    Style="{StaticResource SettingsPrimaryButtonStyle}" Foreground="{StaticResource SettingsButtonBlueBrush}"
                                                    ToolTipService.ToolTip="Check all components and the app for available updates">
                                                <Button.Resources>
                                                    <StaticResource x:Key="ButtonForegroundPointerOver" ResourceKey="SettingsButtonBlueBrush"/>
                                                    <StaticResource x:Key="ButtonForegroundPressed" ResourceKey="SettingsButtonBlueBrush"/>
                                                </Button.Resources>
                                            </Button>
                                            <Grid ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*" MaxWidth="210"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Background checks" Style="{StaticResource SettingsLabelStyle}"/>
                                                <ComboBox Grid.Column="1" x:Name="BackgroundUpdateChecksCombo" x:FieldModifier="internal"
                                                          Style="{StaticResource SettingsComboStyle}"
                                                          SelectionChanged="BackgroundUpdateChecksCombo_SelectionChanged">
                                                    <ToolTipService.ToolTip>
                                                        <ToolTip>
                                                            <TextBlock TextWrapping="Wrap" MaxWidth="280">
                                                                <Run Text="On: all update checks run automatically on startup and every 4 hours, including ReShade, RenoDX, OptiScaler, Nexus Mods, and all other components."/><LineBreak/>
                                                                <Run Text="Minimal: only manifests, PCGW data, and DLSS versions update automatically. Component update checks only run when you click Refresh or Update All."/>
                                                            </TextBlock>
                                                        </ToolTip>
                                                    </ToolTipService.ToolTip>
                                                    <ComboBoxItem Content="On"/>
                                                    <ComboBoxItem Content="Minimal"/>
                                                </ComboBox>
                                            </Grid>
                                            <TextBlock Text="Components to check" Style="{StaticResource SettingsHeadStyle}"
                                                       ToolTipService.ToolTip="Disable update checks for individual components. When disabled, the component will not be checked during startup or Update All."/>
                                            <TextBlock x:Name="GlobalUpdateSummaryText" x:FieldModifier="internal"
                                                       Style="{StaticResource SettingsStatusStyle}"/>
                                            <Button x:Name="GlobalUpdateInclusionBtn"
                                                    Content="Choose"
                                                    Click="GlobalUpdateInclusion_Click"
                                                    Style="{StaticResource SettingsButtonStyle}" Foreground="{StaticResource SettingsLabelBrush}"
                                                    ToolTipService.ToolTip="Choose which components RHI checks for updates. Components you turn off are not checked during startup or Update All."/>
                                        </StackPanel>

                                        <Border Grid.Column="1" Width="1" Background="{StaticResource BorderDefaultBrush}"/>

                                        <!-- Right: Automatic updates (Components, DLSS, Streamline) -->
                                        <StackPanel Grid.Column="2" Spacing="9" Margin="20,0,0,0" VerticalAlignment="Top">
                                            <TextBlock Text="Automatic updates" Style="{StaticResource SettingsHeadStyle}"/>
                                            <Grid ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*" MaxWidth="210"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Components" Style="{StaticResource SettingsLabelStyle}"/>
                                                <ComboBox Grid.Column="1" x:Name="AutoUpdateComponentsCombo" x:FieldModifier="internal"
                                                          Style="{StaticResource SettingsComboStyle}"
                                                          ToolTipService.ToolTip="When On, RHI silently installs component updates in the background after each update check. Games that are running when an update is detected are updated once they close. Does not apply to app updates."
                                                          SelectionChanged="AutoUpdateComponentsCombo_SelectionChanged">
                                                    <ComboBoxItem Content="Off"/>
                                                    <ComboBoxItem Content="On"/>
                                                </ComboBox>
                                            </Grid>
                                            <TextBlock Style="{StaticResource SettingsHelpStyle}"
                                                       Text="ReShade, RenoDX, ReLimiter, Display Commander, OptiScaler, RE Framework, Luma, DXVK and DOF Fix, installed in the background."/>
                                            <Grid ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*" MaxWidth="210"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="DLSS" Style="{StaticResource SettingsLabelStyle}"/>
                                                <ComboBox Grid.Column="1" x:Name="AutoUpdateDlssCombo" x:FieldModifier="internal"
                                                          Style="{StaticResource SettingsComboStyle}"
                                                          ToolTipService.ToolTip="Swaps games to the newest DLSS when a new version is released. Only affects games on the previous latest version; older versions you picked yourself are left alone."
                                                          SelectionChanged="AutoUpdateDlssCombo_SelectionChanged">
                                                    <ComboBoxItem Content="Off"/>
                                                    <ComboBoxItem Content="On"/>
                                                </ComboBox>
                                            </Grid>
                                            <Grid ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*" MaxWidth="210"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Streamline" Style="{StaticResource SettingsLabelStyle}"/>
                                                <ComboBox Grid.Column="1" x:Name="AutoUpdateStreamlineCombo" x:FieldModifier="internal"
                                                          Style="{StaticResource SettingsComboStyle}"
                                                          ToolTipService.ToolTip="Swaps games to the newest Streamline when a new version is released. Only affects games on the previous latest version; older versions you picked yourself are left alone."
                                                          SelectionChanged="AutoUpdateStreamlineCombo_SelectionChanged">
                                                    <ComboBoxItem Content="Off"/>
                                                    <ComboBoxItem Content="On"/>
                                                </ComboBox>
                                            </Grid>
                                            <TextBlock Style="{StaticResource SettingsNoteStyle}"
                                                       Text="RHI's own updates are never installed without asking."/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Card: Windows and Admin Mode -->
                            <Border Style="{StaticResource SettingsCardStyle}">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="Windows and Admin Mode" Style="{StaticResource SettingsCardTitleStyle}"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Left: Windows (system tray, start with Windows) -->
                                        <StackPanel Grid.Column="0" Spacing="9" Margin="0,0,20,0" VerticalAlignment="Top">
                                            <TextBlock Text="Windows" Style="{StaticResource SettingsHeadStyle}"/>
                                            <Grid ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*" MaxWidth="210"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Close to tray" Style="{StaticResource SettingsLabelStyle}"/>
                                                <ComboBox Grid.Column="1" x:Name="CloseToTrayCombo" x:FieldModifier="internal"
                                                          Style="{StaticResource SettingsComboStyle}"
                                                          ToolTipService.ToolTip="Closing the window keeps RHI running in the system tray."
                                                          SelectionChanged="CloseToTrayCombo_SelectionChanged">
                                                    <ComboBoxItem Content="Off"/>
                                                    <ComboBoxItem Content="On"/>
                                                </ComboBox>
                                            </Grid>
                                            <Grid ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*" MaxWidth="210"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Recent games in tray menu" Style="{StaticResource SettingsLabelStyle}"/>
                                                <ComboBox Grid.Column="1" x:Name="RecentGamesCombo" x:FieldModifier="internal"
                                                          Style="{StaticResource SettingsComboStyle}"
                                                          ToolTipService.ToolTip="Right-click the tray icon or pinned taskbar icon to quickly launch recent games."
                                                          SelectionChanged="RecentGamesCombo_SelectionChanged">
                                                    <ComboBoxItem Content="Off"/>
                                                    <ComboBoxItem Content="On"/>
                                                </ComboBox>
                                            </Grid>
                                            <Grid ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*" MaxWidth="210"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Start with Windows" Style="{StaticResource SettingsLabelStyle}"/>
                                                <ComboBox Grid.Column="1" x:Name="StartWithWindowsCombo" x:FieldModifier="internal"
                                                          Style="{StaticResource SettingsComboStyle}"
                                                          SelectionChanged="StartWithWindowsCombo_SelectionChanged">
                                                    <ComboBoxItem Content="Off"/>
                                                    <ComboBoxItem Content="On"/>
                                                </ComboBox>
                                            </Grid>
                                        </StackPanel>

                                        <Border Grid.Column="1" Width="1" Background="{StaticResource BorderDefaultBrush}"/>

                                        <!-- Right: Admin Mode + Drop Helper -->
                                        <StackPanel Grid.Column="2" Spacing="9" Margin="20,0,0,0" VerticalAlignment="Top">
                                            <TextBlock Text="Admin Mode" Style="{StaticResource SettingsHeadStyle}"/>
                                            <TextBlock Style="{StaticResource SettingsNoteStyle}"
                                                       Text="Runs RHI as administrator without a prompt each time. Needed for ReBAR, the DLSS indicator, Smooth Motion and Low Latency Ultra."/>
                                            <Grid ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*" MaxWidth="210"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Admin Mode" Style="{StaticResource SettingsLabelStyle}"/>
                                                <ComboBox Grid.Column="1" x:Name="AdminModeCombo" x:FieldModifier="internal"
                                                          Style="{StaticResource SettingsComboStyle}"
                                                          ToolTipService.ToolTip="Creates a scheduled task that launches RHI with elevated privileges, so there is no prompt each time. Takes effect after RHI restarts."
                                                          SelectionChanged="AdminModeCombo_SelectionChanged">
                                                    <ComboBoxItem Content="Off"/>
                                                    <ComboBoxItem Content="On"/>
                                                </ComboBox>
                                            </Grid>
                                            <Grid ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*" MaxWidth="210"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                    <TextBlock Text="Drop Helper" Style="{StaticResource SettingsLabelStyle}"/>
                                                    <Border BorderBrush="{StaticResource AccentAmberDimBrush}" BorderThickness="1"
                                                            CornerRadius="9" Padding="6,0,6,1" VerticalAlignment="Center"
                                                            ToolTipService.ToolTip="Only used when Admin Mode is on.">
                                                        <TextBlock Text="Admin" FontSize="10" Foreground="{StaticResource AccentAmberBrush}"/>
                                                    </Border>
                                                </StackPanel>
                                                <ComboBox Grid.Column="1" x:Name="DropHelperCombo" x:FieldModifier="internal"
                                                          Style="{StaticResource SettingsComboStyle}"
                                                          ToolTipService.ToolTip="The drop helper window enables Discord drag-and-drop in admin mode. Disable if you don't need it. Restart required."
                                                          SelectionChanged="DropHelperCombo_SelectionChanged">
                                                    <ComboBoxItem Content="Off"/>
                                                    <ComboBoxItem Content="On"/>
                                                </ComboBox>
                                            </Grid>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ══════════════════════════════════════════════════════════
                             SECTION 2: ACCOUNTS & DATA
                             (RenoDxDbSourceCard is made visible in SettingsHandler; NexusModsCard
                             is shown when FeatureFlags.NexusMods is on: dev unlock or manifest flag)
                             ══════════════════════════════════════════════════════════ -->
                        <StackPanel Tag="Section:Accounts" Spacing="12">
                            <StackPanel Spacing="3">
                                <TextBlock Text="Accounts &amp; Data" FontSize="18" FontWeight="Bold"
                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="Where RHI gets its mod information, and the accounts it can use."
                                           FontSize="12" LineHeight="17" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>

                            <Border x:Name="RenoDxDbSourceCard" x:FieldModifier="internal"
                                    Style="{StaticResource SettingsCardStyle}">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="Accounts and mod data" Style="{StaticResource SettingsCardTitleStyle}"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Left: GitHub token -->
                                        <StackPanel Grid.Column="0" Spacing="9" Margin="0,0,20,0" VerticalAlignment="Top">
                                            <TextBlock Text="GitHub token" Style="{StaticResource SettingsHeadStyle}"/>
                                            <TextBlock Style="{StaticResource SettingsNoteStyle}"
                                                       ToolTipService.ToolTip="A token raises the GitHub API rate limit from 60 to 5,000 requests per hour. This improves reliability of update checks, DLSS version lookups, and manifest fetches."
                                                       Text="Without a token RHI is limited to 60 GitHub requests an hour; a token raises it to 5,000."/>

                                            <!-- Status text (connected / code display / error) -->
                                            <TextBlock x:Name="GitHubStatusText" x:FieldModifier="internal"
                                                       Style="{StaticResource SettingsStatusStyle}"
                                                       Foreground="{StaticResource TextTertiaryBrush}"
                                                       Text="Not connected (60 req/hr)"/>

                                            <!-- Device code panel — shown during the sign-in flow -->
                                            <StackPanel x:Name="GitHubDeviceCodePanel" x:FieldModifier="internal"
                                                        Spacing="6" Visibility="Collapsed">
                                                <TextBlock Style="{StaticResource SettingsNoteStyle}"
                                                           Text="Open the link below and enter this code:"/>
                                                <TextBlock x:Name="GitHubUserCodeText" x:FieldModifier="internal"
                                                           FontSize="20" FontWeight="Bold"
                                                           Foreground="{StaticResource TextPrimaryBrush}"
                                                           Text="XXXX-XXXX"
                                                           CharacterSpacing="200"/>
                                                <HyperlinkButton x:Name="GitHubVerificationLink" x:FieldModifier="internal"
                                                                 Content="github.com/login/device"
                                                                 NavigateUri="https://github.com/login/device"
                                                                 FontSize="11" Padding="0"/>
                                            </StackPanel>

                                            <!-- Personal Access Token -->
                                            <Grid ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*" MaxWidth="210"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Token" Style="{StaticResource SettingsLabelStyle}"/>
                                                <Grid Grid.Column="1" ColumnSpacing="6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox x:Name="GitHubPatBox" x:FieldModifier="internal"
                                                             PlaceholderText="ghp_..."
                                                             Style="{StaticResource SettingsTextBoxStyle}"
                                                             IsSpellCheckEnabled="False"
                                                             InputScope="Url"
                                                             ToolTipService.ToolTip="Paste a GitHub Personal Access Token (PAT). It stays valid until you revoke it. No scopes needed, just generate and paste."/>
                                                    <Button Grid.Column="1" x:Name="GitHubPatSaveBtn" x:FieldModifier="internal"
                                                            Content="Save"
                                                            Click="GitHubPatSaveBtn_Click"
                                                            Style="{StaticResource SettingsButtonStyle}" Foreground="{StaticResource SettingsLabelBrush}"/>
                                                </Grid>
                                            </Grid>
                                            <TextBlock x:Name="GitHubPatStatusText" x:FieldModifier="internal"
                                                       Style="{StaticResource SettingsNoteStyle}"
                                                       Text="" Visibility="Collapsed"/>
                                            <controls:WrapPanel HorizontalSpacing="8" VerticalSpacing="8">
                                                <HyperlinkButton NavigateUri="https://github.com/settings/tokens/new?description=RHI&amp;scopes="
                                                                 Content="Create a token"
                                                                 FontSize="12" MinHeight="30" Padding="12,5" CornerRadius="8"
                                                                 BorderThickness="1"
                                                                 Background="{StaticResource SurfaceOverlayBrush}"
                                                                 BorderBrush="{StaticResource BorderStrongBrush}"
                                                                 Foreground="{StaticResource TextSecondaryBrush}"
                                                                 ToolTipService.ToolTip="Opens github.com/settings/tokens. No boxes to tick: generate it and paste it above."/>
                                                <Button x:Name="GitHubConnectBtn" x:FieldModifier="internal"
                                                        Content="Sign in with GitHub instead"
                                                        Click="GitHubConnectBtn_Click"
                                                        Style="{StaticResource SettingsButtonStyle}" Foreground="{StaticResource SettingsLabelBrush}"
                                                        ToolTipService.ToolTip="Sign in with your GitHub account in the browser instead of pasting a token."/>
                                                <Button x:Name="GitHubPatClearBtn" x:FieldModifier="internal"
                                                        Content="Remove"
                                                        Click="GitHubPatClearBtn_Click"
                                                        Style="{StaticResource SettingsDangerButtonStyle}" Foreground="{StaticResource AccentRedBrush}"
                                                        ToolTipService.ToolTip="Remove the saved token.">
                                                    <Button.Resources>
                                                        <StaticResource x:Key="ButtonForegroundPointerOver" ResourceKey="AccentRedBrush"/>
                                                        <StaticResource x:Key="ButtonForegroundPressed" ResourceKey="AccentRedBrush"/>
                                                    </Button.Resources>
                                                </Button>
                                                <!-- Disconnect — shown only when signed in -->
                                                <StackPanel x:Name="GitHubDisconnectRow" x:FieldModifier="internal"
                                                            Visibility="Collapsed">
                                                    <Button Content="Sign out"
                                                            Click="GitHubDisconnectBtn_Click"
                                                            Style="{StaticResource SettingsDangerButtonStyle}" Foreground="{StaticResource AccentRedBrush}"
                                                            ToolTipService.ToolTip="Sign out of GitHub.">
                                                        <Button.Resources>
                                                            <StaticResource x:Key="ButtonForegroundPointerOver" ResourceKey="AccentRedBrush"/>
                                                            <StaticResource x:Key="ButtonForegroundPressed" ResourceKey="AccentRedBrush"/>
                                                        </Button.Resources>
                                                    </Button>
                                                </StackPanel>
                                            </controls:WrapPanel>
                                        </StackPanel>

                                        <Border Grid.Column="1" Width="1" Background="{StaticResource BorderDefaultBrush}"/>

                                        <!-- Right: Mod data source + Nexus Mods -->
                                        <StackPanel Grid.Column="2" Spacing="9" Margin="20,0,0,0" VerticalAlignment="Top">
                                            <TextBlock Text="Mod data source" Style="{StaticResource SettingsHeadStyle}"/>
                                            <Grid ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*" MaxWidth="210"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Source" Style="{StaticResource SettingsLabelStyle}"/>
                                                <ComboBox Grid.Column="1" x:Name="RenoDxDbSourceCombo" x:FieldModifier="internal"
                                                          Style="{StaticResource SettingsComboStyle}"
                                                          ToolTipService.ToolTip="RHI Database uses the community-maintained RHI database (recommended). RenoDX Wiki falls back to the RenoDX wiki scraper. Changing this setting triggers an immediate refresh.">
                                                    <ComboBoxItem Content="RHI Database" Tag="DbOnly"/>
                                                    <ComboBoxItem Content="RenoDX Wiki" Tag="WikiOnly"/>
                                                </ComboBox>
                                            </Grid>
                                            <TextBlock Style="{StaticResource SettingsHelpStyle}"
                                                       Text="Where RHI looks up which games have mods. Changing it refreshes the library."/>

                                            <!-- Nexus Mods (shown when FeatureFlags.NexusMods is on) -->
                                            <Border x:Name="NexusModsCard" x:FieldModifier="internal"
                                                    Visibility="Collapsed">
                                                <StackPanel Spacing="9">
                                                    <TextBlock Text="Nexus Mods" Style="{StaticResource SettingsHeadStyle}"/>
                                                    <TextBlock Style="{StaticResource SettingsNoteStyle}"
                                                               Text="Connect signs in to Nexus Mods in your browser. Premium users get one-click downloads and silent auto-updates. Free users get one-click browser downloads."/>
                                                    <Grid ColumnSpacing="10">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="*" MaxWidth="210"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="Account" Style="{StaticResource SettingsLabelStyle}"/>
                                                        <Grid Grid.Column="1" ColumnSpacing="6">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock x:Name="NexusStatusText" x:FieldModifier="internal"
                                                                       FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center"
                                                                       Foreground="{StaticResource TextTertiaryBrush}"
                                                                       Text="Not connected"/>
                                                            <Button Grid.Column="1" x:Name="NexusConnectBtn" x:FieldModifier="internal"
                                                                    Content="Connect"
                                                                    Click="NexusConnectBtn_Click"
                                                                    Style="{StaticResource SettingsButtonStyle}" Foreground="{StaticResource SettingsLabelBrush}"/>
                                                        </Grid>
                                                    </Grid>
                                                    <StackPanel x:Name="NexusDisconnectRow" x:FieldModifier="internal"
                                                                Visibility="Collapsed" HorizontalAlignment="Right">
                                                        <Button Content="Disconnect"
                                                                Click="NexusDisconnectBtn_Click"
                                                                Style="{StaticResource SettingsDangerButtonStyle}" Foreground="{StaticResource AccentRedBrush}">
                                                            <Button.Resources>
                                                                <StaticResource x:Key="ButtonForegroundPointerOver" ResourceKey="AccentRedBrush"/>
                                                                <StaticResource x:Key="ButtonForegroundPressed" ResourceKey="AccentRedBrush"/>
                                                            </Button.Resources>
                                                        </Button>
                                                    </StackPanel>
                                                    <Grid ColumnSpacing="10">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="*" MaxWidth="210"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="nxm:// links" Style="{StaticResource SettingsLabelStyle}"
                                                                   ToolTipService.ToolTip="Register RHI as the nxm:// handler so Nexus &quot;Mod Manager Download&quot; buttons open directly in RHI."/>
                                                        <Grid Grid.Column="1" ColumnSpacing="6">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock x:Name="NxmStatusText" x:FieldModifier="internal"
                                                                       FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center"
                                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                                       Text="Not registered"/>
                                                            <Button Grid.Column="1" x:Name="NxmRegisterBtn" x:FieldModifier="internal"
                                                                    Content="Register"
                                                                    Click="NxmRegisterBtn_Click"
                                                                    Style="{StaticResource SettingsButtonStyle}" Foreground="{StaticResource SettingsLabelBrush}"
                                                                    ToolTipService.ToolTip="Open Nexus &quot;Mod Manager Download&quot; links in RHI."/>
                                                        </Grid>
                                                    </Grid>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ══════════════════════════════════════════════════════════
                             SECTION 3: RESHADE & RENODX
                             ══════════════════════════════════════════════════════════ -->
                        <StackPanel Tag="Section:ReShade" Spacing="12">
                            <StackPanel Spacing="3">
                                <TextBlock Text="ReShade &amp; RenoDX" FontSize="18" FontWeight="Bold"
                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="Defaults for every game using ReShade. Each game can still change these in its own ReShade ⚙."
                                           FontSize="12" LineHeight="17" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>

                            <!-- Card: Keys, screenshots and brightness -->
                            <Border Style="{StaticResource SettingsCardStyle}">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="Keys, screenshots and brightness" Style="{StaticResource SettingsCardTitleStyle}"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Left: Keys and screenshots -->
                                        <StackPanel Grid.Column="0" Spacing="9" Margin="0,0,20,0" VerticalAlignment="Top">
                                            <TextBlock Text="Keys and screenshots" Style="{StaticResource SettingsHeadStyle}"
                                                       ToolTipService.ToolTip="Screenshot save path and ReShade key bindings applied to all managed reshade.ini files."/>
                                            <Grid ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*" MaxWidth="210"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Overlay key" Style="{StaticResource SettingsLabelStyle}"/>
                                                <TextBox Grid.Column="1" x:Name="HotkeyBox" x:FieldModifier="internal"
                                                         PlaceholderText="Press a key..." IsReadOnly="True"
                                                         Style="{StaticResource SettingsTextBoxStyle}" FontFamily="Consolas"
                                                         ToolTipService.ToolTip="Opens the ReShade overlay in game. Click here and press a key to change it."
                                                         PreviewKeyDown="HotkeyBox_PreviewKeyDown"/>
                                            </Grid>
                                            <Grid ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*" MaxWidth="210"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Screenshot key" Style="{StaticResource SettingsLabelStyle}"/>
                                                <Grid Grid.Column="1" ColumnSpacing="6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox x:Name="ScreenshotHotkeyBox" x:FieldModifier="internal"
                                                             PlaceholderText="Press a key..." IsReadOnly="True"
                                                             Style="{StaticResource SettingsTextBoxStyle}" FontFamily="Consolas"
                                                             ToolTipService.ToolTip="Press a key to assign it, or Backspace to clear it."
                                                             PreviewKeyDown="ScreenshotHotkeyBox_PreviewKeyDown"/>
                                                    <Button Grid.Column="1" Content="↺" Click="ResetScreenshotHotkey_Click"
                                                            Style="{StaticResource SettingsIconButtonStyle}" Foreground="{StaticResource SettingsLabelBrush}"
                                                            ToolTipService.ToolTip="Reset to Print Screen"/>
                                                </Grid>
                                            </Grid>
                                            <Grid ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*" MaxWidth="210"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Screenshot folder" Style="{StaticResource SettingsLabelStyle}"/>
                                                <Grid Grid.Column="1" ColumnSpacing="6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox x:Name="ScreenshotPathBox" x:FieldModifier="internal"
                                                             PlaceholderText="Type or choose a folder"
                                                             Style="{StaticResource SettingsTextBoxStyle}"
                                                             ToolTipService.ToolTip="Where ReShade saves screenshots. Type a folder and press Enter, or use Browse."
                                                             KeyDown="ScreenshotPathBox_KeyDown"
                                                             LostFocus="ScreenshotPathBox_LostFocus"/>
                                                    <Button Grid.Column="1" Content="Browse" Click="BrowseScreenshotPath_Click"
                                                            Style="{StaticResource SettingsIconButtonStyle}" Foreground="{StaticResource SettingsLabelBrush}"
                                                            ToolTipService.ToolTip="Pick a folder for screenshots"/>
                                                    <Button Grid.Column="2" Content="Open" Click="OpenScreenshotFolder_Click"
                                                            Style="{StaticResource SettingsIconButtonStyle}" Foreground="{StaticResource SettingsLabelBrush}"
                                                            ToolTipService.ToolTip="Open the screenshot folder in Explorer"/>
                                                </Grid>
                                            </Grid>
                                            <Grid ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*" MaxWidth="210"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Folder per game" Style="{StaticResource SettingsLabelStyle}"/>
                                                <ComboBox Grid.Column="1" x:Name="PerGameScreenshotCombo" x:FieldModifier="internal"
                                                          Style="{StaticResource SettingsComboStyle}"
                                                          ToolTipService.ToolTip="When On, each game gets its own screenshot subfolder."
                                                          SelectionChanged="PerGameScreenshotCombo_SelectionChanged">
                                                    <ComboBoxItem Content="Off"/>
                                                    <ComboBoxItem Content="On"/>
                                                </ComboBox>
                                            </Grid>
                                            <Grid ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*" MaxWidth="210"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Effect list style" Style="{StaticResource SettingsLabelStyle}"/>
                                                <ComboBox Grid.Column="1" x:Name="RsVariableListUseTabsCombo" x:FieldModifier="internal"
                                                          Style="{StaticResource SettingsComboStyle}"
                                                          ToolTipService.ToolTip="Controls how shaders are displayed in the ReShade overlay. Tabs groups effect files into named tabs; Tree shows a collapsible hierarchy."
                                                          SelectionChanged="RsVariableListUseTabsCombo_SelectionChanged">
                                                    <ComboBoxItem Content="Tabs"/>
                                                    <ComboBoxItem Content="Tree"/>
                                                </ComboBox>
                                            </Grid>
                                            <Button x:Name="ApplyHotkeyBtn" x:FieldModifier="internal"
                                                    Content="Write these to all games"
                                                    Click="ApplyScreenshotPath_Click"
                                                    Style="{StaticResource SettingsPrimaryButtonStyle}" Foreground="{StaticResource SettingsButtonBlueBrush}"
                                                    ToolTipService.ToolTip="Writes the overlay key, screenshot key, screenshot folder and effect list style into every game's reshade.ini. Skips hidden games and games set to keep their own reshade.ini.">
                                                <Button.Resources>
                                                    <StaticResource x:Key="ButtonForegroundPointerOver" ResourceKey="SettingsButtonBlueBrush"/>
                                                    <StaticResource x:Key="ButtonForegroundPressed" ResourceKey="SettingsButtonBlueBrush"/>
                                                </Button.Resources>
                                            </Button>
                                            <TextBlock Style="{StaticResource SettingsNoteStyle}"
                                                       Text="Skips hidden games and games set to keep their own reshade.ini."/>
                                        </StackPanel>

                                        <Border Grid.Column="1" Width="1" Background="{StaticResource BorderDefaultBrush}"/>

                                        <!-- Right: HDR brightness (RenoDX) -->
                                        <StackPanel Grid.Column="2" Spacing="9" Margin="20,0,0,0" VerticalAlignment="Top">
                                            <TextBlock Text="HDR brightness (RenoDX)" Style="{StaticResource SettingsHeadStyle}"/>
                                            <Grid ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*" MaxWidth="210"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Peak brightness" Style="{StaticResource SettingsLabelStyle}"/>
                                                <Grid Grid.Column="1" ColumnSpacing="6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox x:Name="PeakNitsBox" x:FieldModifier="internal"
                                                             PlaceholderText="nits"
                                                             Style="{StaticResource SettingsTextBoxStyle}"
                                                             ToolTipService.ToolTip="Your monitor's peak brightness in nits, written to reshade.ini presets. Press Enter to save."
                                                             KeyDown="PeakNitsBox_KeyDown"
                                                             LostFocus="PeakNitsBox_LostFocus"/>
                                                    <Button Grid.Column="1" x:Name="PeakNitsAutoBtn"
                                                            Content="Auto" Click="PeakNitsAuto_Click"
                                                            Style="{StaticResource SettingsIconButtonStyle}" Foreground="{StaticResource SettingsLabelBrush}"
                                                            ToolTipService.ToolTip="Reads your monitor's peak brightness automatically."/>
                                                    <Button Grid.Column="2" Content="⚙" Click="PeakNitsCog_Click"
                                                            Style="{StaticResource SettingsIconButtonStyle}" Foreground="{StaticResource SettingsLabelBrush}"
                                                            ToolTipService.ToolTip="Configure which presets receive the global peak nits value."/>
                                                </Grid>
                                            </Grid>
                                            <Button x:Name="ApplyScreenshotPathBtn"
                                                    Content="Write peak brightness to all games"
                                                    Click="ApplyPeakNitsToAll_Click"
                                                    Style="{StaticResource SettingsPrimaryButtonStyle}" Foreground="{StaticResource SettingsButtonBlueBrush}"
                                                    ToolTipService.ToolTip="Writes the peak nits value into every game's reshade.ini. Skips hidden games and games set to keep their own reshade.ini.">
                                                <Button.Resources>
                                                    <StaticResource x:Key="ButtonForegroundPointerOver" ResourceKey="SettingsButtonBlueBrush"/>
                                                    <StaticResource x:Key="ButtonForegroundPressed" ResourceKey="SettingsButtonBlueBrush"/>
                                                </Button.Resources>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Card: Shaders and addons -->
                            <Border Style="{StaticResource SettingsCardStyle}">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="Shaders and addons" Style="{StaticResource SettingsCardTitleStyle}"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Left: Shader management + download all -->
                                        <StackPanel Grid.Column="0" Spacing="9" Margin="0,0,20,0" VerticalAlignment="Top">
                                            <Grid ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*" MaxWidth="210"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Shaders" Style="{StaticResource SettingsLabelStyle}"/>
                                                <ComboBox Grid.Column="1" x:Name="CustomShadersCombo" x:FieldModifier="internal"
                                                          Style="{StaticResource SettingsComboStyle}"
                                                          ToolTipService.ToolTip="RHI Managed: deploy built-in shader packs to all games.&#10;Custom: use your own shader directory.&#10;Off: RHI never touches shaders on any game."
                                                          SelectionChanged="CustomShadersCombo_SelectionChanged">
                                                    <ComboBoxItem Content="Off"/>
                                                    <ComboBoxItem Content="RHI Managed"/>
                                                    <ComboBoxItem Content="Custom"/>
                                                </ComboBox>
                                            </Grid>
                                            <TextBlock Style="{StaticResource SettingsHelpStyle}"
                                                       Text="Changing this updates every game's shaders, so RHI asks first."/>
                                            <Grid ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*" MaxWidth="210"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Download all shaders" Style="{StaticResource SettingsLabelStyle}"/>
                                                <ComboBox Grid.Column="1" x:Name="CacheAllShadersCombo" x:FieldModifier="internal"
                                                          Style="{StaticResource SettingsComboStyle}"
                                                          ToolTipService.ToolTip="When On, all shader packs are downloaded and cached at startup. When Off, packs are downloaded on demand when needed."
                                                          SelectionChanged="CacheAllShadersCombo_SelectionChanged">
                                                    <ComboBoxItem Content="Off"/>
                                                    <ComboBoxItem Content="On"/>
                                                </ComboBox>
                                            </Grid>
                                        </StackPanel>

                                        <Border Grid.Column="1" Width="1" Background="{StaticResource BorderDefaultBrush}"/>

                                        <!-- Right: Addon watch folder -->
                                        <StackPanel Grid.Column="2" Spacing="9" Margin="20,0,0,0" VerticalAlignment="Top">
                                            <Grid ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*" MaxWidth="210"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Addon watch folder" Style="{StaticResource SettingsLabelStyle}"/>
                                                <Grid Grid.Column="1" ColumnSpacing="6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox x:Name="AddonWatchFolderBox" x:FieldModifier="internal"
                                                             PlaceholderText="Downloads (default)"
                                                             Style="{StaticResource SettingsTextBoxStyle}"
                                                             ToolTipService.ToolTip="RHI watches this folder for RenoDX addon files (.addon64/.addon32) and archives. Defaults to your Downloads folder."
                                                             KeyDown="AddonWatchFolderBox_KeyDown"
                                                             LostFocus="AddonWatchFolderBox_LostFocus"/>
                                                    <Button Grid.Column="1" Content="Browse" Click="BrowseAddonWatchFolder_Click"
                                                            Style="{StaticResource SettingsIconButtonStyle}" Foreground="{StaticResource SettingsLabelBrush}"
                                                            ToolTipService.ToolTip="Pick the folder RHI watches for addon downloads"/>
                                                    <Button Grid.Column="2" Content="Reset" Click="ResetAddonWatchFolder_Click"
                                                            Style="{StaticResource SettingsIconButtonStyle}" Foreground="{StaticResource SettingsLabelBrush}"
                                                            ToolTipService.ToolTip="Go back to your Downloads folder"/>
                                                </Grid>
                                            </Grid>
                                            <TextBlock Style="{StaticResource SettingsHelpStyle}"
                                                       Text="RHI looks here for RenoDX addon files you download."/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ══════════════════════════════════════════════════════════
                             SECTION 4: DISPLAY & HDR
                             (ResolutionControlCard and DldsrControlCard are shown when
                             FeatureFlags.ResolutionControl is on — currently always)
                             ══════════════════════════════════════════════════════════ -->
                        <StackPanel Tag="Section:Display" Spacing="12">
                            <StackPanel Spacing="3">
                                <TextBlock Text="Display &amp; HDR" FontSize="18" FontWeight="Bold"
                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="What happens to your screen when you launch a game through RHI, and display options without the NVIDIA Control Panel."
                                           FontSize="12" LineHeight="17" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>

                            <!-- Card: Display -->
                            <Border x:Name="ResolutionControlCard" x:FieldModifier="internal"
                                    Style="{StaticResource SettingsCardStyle}">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="Display" Style="{StaticResource SettingsCardTitleStyle}"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Left: When a game starts (HDR + resolution auto-toggle, target resolution) -->
                                        <StackPanel Grid.Column="0" Spacing="9" Margin="0,0,20,0" VerticalAlignment="Top">
                                            <TextBlock Text="When a game starts" Style="{StaticResource SettingsHeadStyle}"/>
                                            <TextBlock Style="{StaticResource SettingsNoteStyle}"
                                                       Text="Undone automatically when the game closes."/>
                                            <Grid ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*" MaxWidth="210"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Windows HDR" Style="{StaticResource SettingsLabelStyle}"/>
                                                <Grid Grid.Column="1" ColumnSpacing="6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <ComboBox x:Name="HdrAutoToggleCombo" x:FieldModifier="internal"
                                                              Style="{StaticResource SettingsComboStyle}"
                                                              ToolTipService.ToolTip="When On, Windows HDR is automatically enabled when launching a game through RHI and disabled when the game exits."
                                                              SelectionChanged="HdrAutoToggleCombo_SelectionChanged">
                                                        <ComboBoxItem Content="Off"/>
                                                        <ComboBoxItem Content="On"/>
                                                    </ComboBox>
                                                    <Button Grid.Column="1" Content="⚙" Click="HdrSelectMonitors_Click"
                                                            Style="{StaticResource SettingsIconButtonStyle}" Foreground="{StaticResource SettingsLabelBrush}"
                                                            ToolTipService.ToolTip="Select which monitors to enable HDR on. Empty = primary display only."/>
                                                </Grid>
                                            </Grid>
                                            <Grid ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*" MaxWidth="210"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Change resolution" Style="{StaticResource SettingsLabelStyle}"/>
                                                <Grid Grid.Column="1" ColumnSpacing="6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <ComboBox x:Name="ResAutoToggleCombo" x:FieldModifier="internal"
                                                              Style="{StaticResource SettingsComboStyle}"
                                                              ToolTipService.ToolTip="When On, switches to the target resolution on game launch and restores it on exit."
                                                              SelectionChanged="ResAutoToggleCombo_SelectionChanged">
                                                        <ComboBoxItem Content="Off"/>
                                                        <ComboBoxItem Content="On"/>
                                                    </ComboBox>
                                                    <Button Grid.Column="1" Content="⚙" Click="ResSelectMonitors_Click"
                                                            Style="{StaticResource SettingsIconButtonStyle}" Foreground="{StaticResource SettingsLabelBrush}"
                                                            ToolTipService.ToolTip="Select which monitors to change resolution on."/>
                                                </Grid>
                                            </Grid>
                                            <Grid ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*" MaxWidth="210"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Resolution" Style="{StaticResource SettingsLabelStyle}"/>
                                                <ComboBox Grid.Column="1" x:Name="ResolutionTargetCombo" x:FieldModifier="internal"
                                                          Style="{StaticResource SettingsComboStyle}"
                                                          ToolTipService.ToolTip="Desktop resolution to switch to before a game launches. Restored on game exit."
                                                          SelectionChanged="ResolutionTargetCombo_SelectionChanged"/>
                                            </Grid>
                                        </StackPanel>

                                        <Border Grid.Column="1" Width="1" Background="{StaticResource BorderDefaultBrush}"/>

                                        <!-- Right: Output colour -->
                                        <StackPanel Grid.Column="2" Spacing="9" Margin="20,0,0,0" VerticalAlignment="Top">
                                            <TextBlock Text="Output colour" Style="{StaticResource SettingsHeadStyle}"
                                                       ToolTipService.ToolTip="Set display colour depth and dynamic range without opening NVIDIA Control Panel."/>
                                            <!-- Monitor row: C# hides the combo's parent row when no NVIDIA display is found -->
                                            <Grid ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*" MaxWidth="210"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Monitor" Style="{StaticResource SettingsLabelStyle}"/>
                                                <ComboBox Grid.Column="1" x:Name="ColorDisplayCombo" x:FieldModifier="internal"
                                                          Style="{StaticResource SettingsComboStyle}"
                                                          ToolTipService.ToolTip="Select which display to configure."
                                                          SelectionChanged="ColorDisplayCombo_SelectionChanged"/>
                                            </Grid>
                                            <Grid ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*" MaxWidth="210"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Colour depth" Style="{StaticResource SettingsLabelStyle}"/>
                                                <ComboBox Grid.Column="1" x:Name="ColorDepthCombo" x:FieldModifier="internal"
                                                          Style="{StaticResource SettingsComboStyle}"
                                                          ToolTipService.ToolTip="Bits per colour channel sent to the monitor. 10 bpc or higher suits HDR. Only depths your monitor and cable support will work.">
                                                    <ComboBoxItem Content="8 bpc"/>
                                                    <ComboBoxItem Content="10 bpc"/>
                                                    <ComboBoxItem Content="12 bpc"/>
                                                </ComboBox>
                                            </Grid>
                                            <Grid ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*" MaxWidth="210"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Dynamic range" Style="{StaticResource SettingsLabelStyle}"/>
                                                <ComboBox Grid.Column="1" x:Name="ColorRangeCombo" x:FieldModifier="internal"
                                                          Style="{StaticResource SettingsComboStyle}"
                                                          ToolTipService.ToolTip="Full suits PC monitors. Limited suits TVs that expect video levels. The wrong one makes blacks look grey or crushed.">
                                                    <ComboBoxItem Content="Full"/>
                                                    <ComboBoxItem Content="Limited"/>
                                                </ComboBox>
                                            </Grid>
                                            <Button Content="Apply"
                                                    x:Name="ColorApplyBtn" x:FieldModifier="internal"
                                                    Click="ColorApplyBtn_Click"
                                                    Style="{StaticResource SettingsPrimaryButtonStyle}" Foreground="{StaticResource SettingsButtonBlueBrush}"
                                                    ToolTipService.ToolTip="Apply the colour depth and dynamic range to the selected monitor.">
                                                <Button.Resources>
                                                    <StaticResource x:Key="ButtonForegroundPointerOver" ResourceKey="SettingsButtonBlueBrush"/>
                                                    <StaticResource x:Key="ButtonForegroundPressed" ResourceKey="SettingsButtonBlueBrush"/>
                                                </Button.Resources>
                                            </Button>
                                            <Grid ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*" MaxWidth="210"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Digital vibrance" Style="{StaticResource SettingsLabelStyle}"/>
                                                <Grid Grid.Column="1" ColumnSpacing="6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="Per monitor" FontSize="12" VerticalAlignment="Center"
                                                               Foreground="{StaticResource SettingsHelpBrush}"/>
                                                    <Button Grid.Column="1" Content="Adjust"
                                                            Click="DigitalVibrance_Click"
                                                            Style="{StaticResource SettingsIconButtonStyle}" Foreground="{StaticResource SettingsLabelBrush}"
                                                            ToolTipService.ToolTip="Adjust NVIDIA Digital Vibrance (color saturation) per-display. Saved values are automatically restored on app startup."/>
                                                </Grid>
                                            </Grid>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Card: DLDSR -->
                            <Border x:Name="DldsrControlCard" x:FieldModifier="internal"
                                    Visibility="Collapsed"
                                    Style="{StaticResource SettingsCardStyle}">
                                <StackPanel Spacing="12">
                                    <StackPanel Spacing="3">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="DLDSR" Style="{StaticResource SettingsCardTitleStyle}" VerticalAlignment="Center"/>
                                            <Button x:Name="DldsrInfoBtn" x:FieldModifier="internal"
                                                    Content="i" Click="DldsrInfoBtn_Click"
                                                    Width="20" Height="20" MinWidth="0" MinHeight="0" Padding="0"
                                                    CornerRadius="10" BorderThickness="1" FontSize="11"
                                                    Background="Transparent"
                                                    BorderBrush="{StaticResource AccentBlueBorderBrush}"
                                                    Foreground="{StaticResource SettingsButtonBlueBrush}"
                                                    VerticalAlignment="Center"
                                                    ToolTipService.ToolTip="How to use DLDSR Control"/>
                                        </StackPanel>
                                        <TextBlock Style="{StaticResource SettingsCardDescStyle}"
                                                   Text="Turn DLDSR (Deep Learning Dynamic Super Resolution) factors on or off without opening the NVIDIA Control Panel. Capture a state in the NVIDIA Control Panel first."/>
                                    </StackPanel>

                                    <StackPanel Spacing="9">
                                        <TextBlock Text="Current state" Style="{StaticResource SettingsHeadStyle}"/>
                                        <TextBlock x:Name="DldsrCurrentStateText" x:FieldModifier="internal"
                                                   Text="(not checked)"
                                                   Style="{StaticResource SettingsStatusStyle}"/>

                                        <!-- Smoothness slider + Set -->
                                        <StackPanel Spacing="6">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="Smoothness" Style="{StaticResource SettingsLabelStyle}"/>
                                                <TextBlock x:Name="DldsrSmoothnessValueText" x:FieldModifier="internal"
                                                           Text="33%" FontSize="12" FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <Grid ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Slider x:Name="DldsrSmoothnessSlider" x:FieldModifier="internal"
                                                        Minimum="0" Maximum="100" StepFrequency="1" TickFrequency="10"
                                                        HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                                        ToolTipService.ToolTip="Adjust DSR smoothness (0-100%). Lower values are sharper, higher values are smoother. ~15 second display blackout on apply."/>
                                                <Button Grid.Column="1"
                                                        x:Name="DldsrSmoothnessApplyBtn" x:FieldModifier="internal"
                                                        Content="Set" Click="DldsrSmoothnessApplyBtn_Click"
                                                        Style="{StaticResource SettingsButtonStyle}" Foreground="{StaticResource SettingsLabelBrush}"
                                                        ToolTipService.ToolTip="Apply the selected smoothness value. Causes ~15 second display blackout."/>
                                            </Grid>
                                        </StackPanel>

                                        <!-- Saved state + Apply -->
                                        <Grid ColumnSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*" MaxWidth="300"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Saved state" Style="{StaticResource SettingsLabelStyle}"/>
                                            <Grid Grid.Column="1" ColumnSpacing="6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <ComboBox x:Name="DldsrStateCombo" x:FieldModifier="internal"
                                                          Style="{StaticResource SettingsComboStyle}"
                                                          ToolTipService.ToolTip="Select a previously captured DLDSR state to apply."/>
                                                <Button Grid.Column="1"
                                                        x:Name="DldsrApplyBtn" x:FieldModifier="internal"
                                                        Content="Apply" Click="DldsrApplyBtn_Click"
                                                        Style="{StaticResource SettingsButtonStyle}" Foreground="{StaticResource SettingsLabelBrush}"
                                                        ToolTipService.ToolTip="Apply the selected DLDSR state. Causes ~15 second display blackout."/>
                                            </Grid>
                                        </Grid>
                                        <TextBlock Style="{StaticResource SettingsNoteStyle}" Foreground="{StaticResource AccentAmberBrush}"
                                                   Text="The screen goes black for about 15 seconds when you set smoothness or apply a state."/>

                                        <controls:WrapPanel HorizontalSpacing="8" VerticalSpacing="8">
                                            <Button x:Name="DldsrCaptureBtn" x:FieldModifier="internal"
                                                    Content="Capture current" Click="DldsrCaptureBtn_Click"
                                                    Style="{StaticResource SettingsButtonStyle}" Foreground="{StaticResource SettingsLabelBrush}"
                                                    ToolTipService.ToolTip="Capture the current DLDSR state from NVIDIA Control Panel. Configure DLDSR in NVIDIA CP first, then capture."/>
                                            <Button x:Name="DldsrDeleteBtn" x:FieldModifier="internal"
                                                    Content="Delete" Click="DldsrDeleteBtn_Click"
                                                    Style="{StaticResource SettingsButtonStyle}" Foreground="{StaticResource SettingsLabelBrush}"
                                                    ToolTipService.ToolTip="Delete the currently selected saved state."/>
                                            <Button x:Name="DldsrRefreshBtn" x:FieldModifier="internal"
                                                    Content="Refresh" Click="DldsrRefreshBtn_Click"
                                                    Style="{StaticResource SettingsButtonStyle}" Foreground="{StaticResource SettingsLabelBrush}"
                                                    ToolTipService.ToolTip="Refresh the current DLDSR state from registry."/>
                                        </controls:WrapPanel>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ══════════════════════════════════════════════════════════
                             SECTION 5: DLSS / STREAMLINE
                             ══════════════════════════════════════════════════════════ -->
                        <StackPanel Tag="Section:Dlss" Spacing="12">
                            <StackPanel Spacing="3">
                                <TextBlock Text="DLSS / Streamline" FontSize="18" FontWeight="Bold"
                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="Matches the DLSS / Streamline section in each game's panel."
                                           FontSize="12" LineHeight="17" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>

                            <!-- Card: Defaults (summary grid is built in C# by RefreshDlssDefaultsSummary) -->
                            <Border Style="{StaticResource SettingsCardStyle}">
                                <StackPanel Spacing="12">
                                    <StackPanel Spacing="3">
                                        <TextBlock Text="Defaults" Style="{StaticResource SettingsCardTitleStyle}"/>
                                        <TextBlock Style="{StaticResource SettingsCardDescStyle}"
                                                   Text="Versions, presets and render scales that Quick Apply (in each game's DLSS / Streamline section) puts on a game."/>
                                    </StackPanel>
                                    <StackPanel Spacing="9">
                                        <StackPanel x:Name="DlssDefaultsSummaryPanel" x:FieldModifier="internal" Spacing="4"/>
                                        <Button Content="Configure defaults" Click="DlssDefaults_Click"
                                                Style="{StaticResource SettingsPrimaryButtonStyle}" Foreground="{StaticResource AccentBlueBrush}"
                                                ToolTipService.ToolTip="Choose the DLSS / Streamline versions, presets and render scales that Quick Apply uses.">
                                            <Button.Resources>
                                                <StaticResource x:Key="ButtonForegroundPointerOver" ResourceKey="SettingsButtonBlueBrush"/>
                                                <StaticResource x:Key="ButtonForegroundPressed" ResourceKey="SettingsButtonBlueBrush"/>
                                            </Button.Resources>
                                        </Button>
                                        <TextBlock Style="{StaticResource SettingsNoteStyle}" Foreground="{StaticResource AccentBlueBrush}"
                                                   Text="Automatic DLSS and Streamline updates: General › Updates."/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Card: Indicator, frame generation and batch deploy -->
                            <Border Style="{StaticResource SettingsCardStyle}">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="Indicator, frame generation and batch deploy" Style="{StaticResource SettingsCardTitleStyle}"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Left: DLSS indicator + Multi frame generation (DMFG global base profile) -->
                                        <StackPanel Grid.Column="0" Spacing="9" Margin="0,0,20,0" VerticalAlignment="Top">
                                            <Grid ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*" MaxWidth="210"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                    <TextBlock Text="DLSS indicator" Style="{StaticResource SettingsLabelStyle}"/>
                                                    <Border BorderBrush="{StaticResource AccentAmberDimBrush}" BorderThickness="1"
                                                            CornerRadius="9" Padding="6,0,6,1" VerticalAlignment="Center"
                                                            ToolTipService.ToolTip="Needs Admin Mode (General › Windows and Admin Mode).">
                                                        <TextBlock Text="Admin" FontSize="10" Foreground="{StaticResource AccentAmberBrush}"/>
                                                    </Border>
                                                </StackPanel>
                                                <ComboBox Grid.Column="1" x:Name="DlssIndicatorCombo" x:FieldModifier="internal"
                                                          Style="{StaticResource SettingsComboStyle}"
                                                          ToolTipService.ToolTip="Controls the DLSS text overlay NVIDIA shows in the corner of games. Global system setting — affects all games. Requires admin."
                                                          SelectionChanged="DlssIndicatorCombo_SelectionChanged">
                                                    <ComboBoxItem Content="Off"/>
                                                    <ComboBoxItem Content="On"/>
                                                </ComboBox>
                                            </Grid>
                                            <TextBlock Text="Multi frame generation (RTX 50)" Style="{StaticResource SettingsHeadStyle}"
                                                       ToolTipService.ToolTip="Global Dynamic Multi Frame Generation (DMFG) defaults. Set these once, then just enable Dynamic mode in each game's MFG dialog."/>
                                            <Grid ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*" MaxWidth="210"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Max frames" Style="{StaticResource SettingsLabelStyle}"/>
                                                <ComboBox Grid.Column="1" x:Name="DmfgFrameCountCombo" x:FieldModifier="internal"
                                                          Style="{StaticResource SettingsComboStyle}"
                                                          ToolTipService.ToolTip="Global DMFG max frame count. Games using Dynamic mode inherit this unless overridden per-game."
                                                          SelectionChanged="DmfgFrameCountCombo_SelectionChanged"/>
                                            </Grid>
                                            <Grid ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*" MaxWidth="210"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Target FPS" Style="{StaticResource SettingsLabelStyle}"/>
                                                <ComboBox Grid.Column="1" x:Name="DmfgTargetFpsCombo" x:FieldModifier="internal"
                                                          Style="{StaticResource SettingsComboStyle}"
                                                          ToolTipService.ToolTip="Global DMFG target frame rate. Off = no target. Max Refresh Rate = match display. Or pick a specific FPS."
                                                          SelectionChanged="DmfgTargetFpsCombo_SelectionChanged"/>
                                            </Grid>
                                        </StackPanel>

                                        <Border Grid.Column="1" Width="1" Background="{StaticResource BorderDefaultBrush}"/>

                                        <!-- Right: Batch deploy -->
                                        <StackPanel Grid.Column="2" Spacing="9" Margin="20,0,0,0" VerticalAlignment="Top">
                                            <TextBlock Text="Batch deploy" Style="{StaticResource SettingsHeadStyle}"/>
                                            <TextBlock Style="{StaticResource SettingsNoteStyle}"
                                                       Text="Put DLSS and Streamline versions and presets on many games at once."/>
                                            <Button Content="Batch deploy" Click="MassDlssDeploy_Click"
                                                    Style="{StaticResource SettingsPrimaryButtonStyle}" Foreground="{StaticResource SettingsButtonBlueBrush}"
                                                    ToolTipService.ToolTip="Deploy DLSS and Streamline DLL versions and DLSS presets to multiple games at once. Backs up originals automatically. Pre-populated with your configured defaults.">
                                                <Button.Resources>
                                                    <StaticResource x:Key="ButtonForegroundPointerOver" ResourceKey="SettingsButtonBlueBrush"/>
                                                    <StaticResource x:Key="ButtonForegroundPressed" ResourceKey="SettingsButtonBlueBrush"/>
                                                </Button.Resources>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ══════════════════════════════════════════════════════════
                             SECTION 6: DRIVER SETTINGS
                             ══════════════════════════════════════════════════════════ -->
                        <StackPanel Tag="Section:Driver" Spacing="12">
                            <StackPanel Spacing="3">
                                <TextBlock Text="Driver Settings" FontSize="18" FontWeight="Bold"
                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="Driver defaults for every game. A game's own Driver Settings section overrides these."
                                           FontSize="12" LineHeight="17" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>

                            <!-- Card: Driver defaults (NVAPI combos, populated with init guards in SettingsHandler) -->
                            <Border Style="{StaticResource SettingsCardStyle}">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="Driver defaults" Style="{StaticResource SettingsCardTitleStyle}"
                                               ToolTipService.ToolTip="Driver-level settings applied globally via the base NVIDIA profile. Per-game settings are in the Driver Settings section of each game's panel."/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Left: VSync, frame rate, G-Sync, refresh rate -->
                                        <StackPanel Grid.Column="0" Spacing="9" Margin="0,0,20,0" VerticalAlignment="Top">
                                            <Grid ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*" MaxWidth="210"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="VSync" Style="{StaticResource SettingsLabelStyle}"/>
                                                <ComboBox Grid.Column="1" x:Name="GlobalVSyncCombo" x:FieldModifier="internal"
                                                          Style="{StaticResource SettingsComboStyle}"
                                                          ToolTipService.ToolTip="Global VSync mode — applies to all games without a per-game override."
                                                          SelectionChanged="GlobalVSyncCombo_SelectionChanged"/>
                                            </Grid>
                                            <Grid ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*" MaxWidth="210"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Frame rate limit" Style="{StaticResource SettingsLabelStyle}"/>
                                                <ComboBox Grid.Column="1" x:Name="FpsLimitCombo" x:FieldModifier="internal"
                                                          Style="{StaticResource SettingsComboStyle}"
                                                          ToolTipService.ToolTip="Global FPS cap via NVIDIA driver. VRR-optimal presets cap just below refresh rate to stay in VRR range. Choosing a cap also turns the per-game FPS limit Off for every game with ReLimiter or Display Commander, so the two limiters don't fight."
                                                          SelectionChanged="FpsLimitCombo_SelectionChanged"/>
                                            </Grid>
                                            <Grid ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*" MaxWidth="210"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="G-Sync" Style="{StaticResource SettingsLabelStyle}"/>
                                                <ComboBox Grid.Column="1" x:Name="GSyncEnableCombo" x:FieldModifier="internal"
                                                          Style="{StaticResource SettingsComboStyle}"
                                                          ToolTipService.ToolTip="Globally enables or disables G-Sync/FreeSync variable refresh rate."
                                                          SelectionChanged="GSyncEnableCombo_SelectionChanged"/>
                                            </Grid>
                                            <Grid ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*" MaxWidth="210"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="G-Sync mode" Style="{StaticResource SettingsLabelStyle}"/>
                                                <ComboBox Grid.Column="1" x:Name="GSyncModeCombo" x:FieldModifier="internal"
                                                          Style="{StaticResource SettingsComboStyle}"
                                                          ToolTipService.ToolTip="Controls G-Sync/FreeSync variable refresh rate. Fullscreen and Windowed recommended for seamless experience."
                                                          SelectionChanged="GSyncModeCombo_SelectionChanged"/>
                                            </Grid>
                                            <Grid ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*" MaxWidth="210"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="G-Sync indicator" Style="{StaticResource SettingsLabelStyle}"/>
                                                <ComboBox Grid.Column="1" x:Name="GSyncIndicatorCombo" x:FieldModifier="internal"
                                                          Style="{StaticResource SettingsComboStyle}"
                                                          ToolTipService.ToolTip="Shows NVIDIA's G-Sync indicator in games when G-Sync is active. Global driver setting, affects all games."
                                                          SelectionChanged="GSyncIndicatorCombo_SelectionChanged">
                                                    <ComboBoxItem Content="Off"/>
                                                    <ComboBoxItem Content="On"/>
                                                </ComboBox>
                                            </Grid>
                                            <Grid ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*" MaxWidth="210"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Preferred refresh rate" Style="{StaticResource SettingsLabelStyle}"/>
                                                <ComboBox Grid.Column="1" x:Name="PreferredRefreshRateCombo" x:FieldModifier="internal"
                                                          Style="{StaticResource SettingsComboStyle}"
                                                          ToolTipService.ToolTip="Highest available forces your max refresh rate. App Setting lets games choose their own refresh rate."
                                                          SelectionChanged="PreferredRefreshRateCombo_SelectionChanged"/>
                                            </Grid>
                                        </StackPanel>

                                        <Border Grid.Column="1" Width="1" Background="{StaticResource BorderDefaultBrush}"/>

                                        <!-- Right: Power, shaders, ReBAR -->
                                        <StackPanel Grid.Column="2" Spacing="9" Margin="20,0,0,0" VerticalAlignment="Top">
                                            <Grid ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*" MaxWidth="210"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Power mode" Style="{StaticResource SettingsLabelStyle}"/>
                                                <ComboBox Grid.Column="1" x:Name="GlobalPowerModeCombo" x:FieldModifier="internal"
                                                          Style="{StaticResource SettingsComboStyle}"
                                                          ToolTipService.ToolTip="Global power management mode — applies to all games without a per-game override."
                                                          SelectionChanged="GlobalPowerModeCombo_SelectionChanged"/>
                                            </Grid>
                                            <Grid ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*" MaxWidth="210"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Shader cache size" Style="{StaticResource SettingsLabelStyle}"/>
                                                <ComboBox Grid.Column="1" x:Name="ShaderCacheSizeCombo" x:FieldModifier="internal"
                                                          Style="{StaticResource SettingsComboStyle}"
                                                          ToolTipService.ToolTip="Maximum disk space for compiled shader cache. Larger = fewer stutters on revisits. 16GB is the driver default."
                                                          SelectionChanged="ShaderCacheSizeCombo_SelectionChanged"/>
                                            </Grid>
                                            <Grid ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*" MaxWidth="210"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Shader pre-compile" Style="{StaticResource SettingsLabelStyle}"/>
                                                <ComboBox Grid.Column="1" x:Name="ShaderPrecompileCombo" x:FieldModifier="internal"
                                                          Style="{StaticResource SettingsComboStyle}"
                                                          ToolTipService.ToolTip="Auto-compiles shaders in the background when idle. Higher = more CPU usage during idle, faster first-time game loads."
                                                          SelectionChanged="ShaderPrecompileCombo_SelectionChanged"/>
                                            </Grid>
                                            <Grid ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*" MaxWidth="210"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                    <TextBlock Text="ReBAR" Style="{StaticResource SettingsLabelStyle}"/>
                                                    <!-- Shown by C# (ReBarAdminWarning) when RHI isn't running as admin -->
                                                    <Border BorderBrush="{StaticResource AccentAmberDimBrush}" BorderThickness="1"
                                                            CornerRadius="9" Padding="6,0,6,1" VerticalAlignment="Center"
                                                            Visibility="{Binding Visibility, ElementName=ReBarAdminWarning}"
                                                            ToolTipService.ToolTip="Needs Admin Mode (General › Windows and Admin Mode).">
                                                        <TextBlock x:Name="ReBarAdminWarning" x:FieldModifier="internal"
                                                                   Text="Admin" FontSize="10"
                                                                   Foreground="{StaticResource AccentAmberBrush}"
                                                                   Visibility="Collapsed"/>
                                                    </Border>
                                                </StackPanel>
                                                <ComboBox Grid.Column="1" x:Name="GlobalReBarEnableCombo" x:FieldModifier="internal"
                                                          Style="{StaticResource SettingsComboStyle}"
                                                          ToolTipService.ToolTip="Global Resizable BAR — enables large GPU memory transfers for all games. Requires admin and compatible hardware (RTX 30 Series+)."
                                                          SelectionChanged="GlobalReBarEnableCombo_SelectionChanged"/>
                                            </Grid>
                                            <Grid ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*" MaxWidth="210"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="ReBAR size limit" Style="{StaticResource SettingsLabelStyle}"/>
                                                <ComboBox Grid.Column="1" x:Name="GlobalReBarSizeCombo" x:FieldModifier="internal"
                                                          Style="{StaticResource SettingsComboStyle}"
                                                          ToolTipService.ToolTip="Maximum BAR transfer size. 1GB is optimal for most games. Decrease to 512MB if experiencing ReBAR-related stutters."
                                                          SelectionChanged="GlobalReBarSizeCombo_SelectionChanged"/>
                                            </Grid>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Card: Profiles -->
                            <Border Style="{StaticResource SettingsCardStyle}">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="Profiles" Style="{StaticResource SettingsCardTitleStyle}"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Left: create / back up / restore profiles -->
                                        <StackPanel Grid.Column="0" Spacing="9" Margin="0,0,20,0" VerticalAlignment="Top">
                                            <controls:WrapPanel HorizontalSpacing="8" VerticalSpacing="8">
                                                <Button Content="Create missing profiles"
                                                        Click="CreateMissingNvidiaProfiles_Click"
                                                        Style="{StaticResource SettingsButtonStyle}" Foreground="{StaticResource SettingsLabelBrush}"
                                                        ToolTipService.ToolTip="Creates NVIDIA driver profiles for all games that don't have one yet. Games without a profile don't get the driver defaults above (Power Mode, VSync and so on)."/>
                                                <Button Content="Back up profiles"
                                                        Click="ExportNvidiaProfiles_Click"
                                                        Style="{StaticResource SettingsButtonStyle}" Foreground="{StaticResource SettingsLabelBrush}"
                                                        ToolTipService.ToolTip="Save all per-game NVIDIA profile settings to a backup file. Useful before updating drivers."/>
                                                <Button Content="Restore profiles"
                                                        Click="ImportNvidiaProfiles_Click"
                                                        Style="{StaticResource SettingsButtonStyle}" Foreground="{StaticResource SettingsLabelBrush}"
                                                        ToolTipService.ToolTip="Restore per-game NVIDIA profile settings from a previous backup."/>
                                            </controls:WrapPanel>
                                        </StackPanel>

                                        <Border Grid.Column="1" Width="1" Background="{StaticResource BorderDefaultBrush}"/>

                                        <!-- Right: Reset -->
                                        <StackPanel Grid.Column="2" Spacing="9" Margin="20,0,0,0" VerticalAlignment="Top">
                                            <TextBlock Text="Reset" Style="{StaticResource SettingsHeadStyle}"/>
                                            <TextBlock Style="{StaticResource SettingsNoteStyle}"
                                                       Text="These can't be undone. Each asks first, with Cancel as the default."/>
                                            <controls:WrapPanel HorizontalSpacing="8" VerticalSpacing="8">
                                                <Button Content="Reset all game profiles"
                                                        Click="ResetAllNvidiaProfiles_Click"
                                                        Style="{StaticResource SettingsDangerButtonStyle}" Foreground="{StaticResource AccentRedBrush}"
                                                        ToolTipService.ToolTip="Removes ALL per-game NVIDIA profile overrides. The global profile will be like new.">
                                                    <Button.Resources>
                                                        <StaticResource x:Key="ButtonForegroundPointerOver" ResourceKey="AccentRedBrush"/>
                                                        <StaticResource x:Key="ButtonForegroundPressed" ResourceKey="AccentRedBrush"/>
                                                    </Button.Resources>
                                                </Button>
                                                <Button Content="Clear shader cache"
                                                        Click="ClearNvidiaShaderCache_Click"
                                                        Style="{StaticResource SettingsDangerButtonStyle}" Foreground="{StaticResource AccentRedBrush}"
                                                        ToolTipService.ToolTip="Deletes the NVIDIA DXCache and GLCache folders. Forces shaders to recompile on next launch.">
                                                    <Button.Resources>
                                                        <StaticResource x:Key="ButtonForegroundPointerOver" ResourceKey="AccentRedBrush"/>
                                                        <StaticResource x:Key="ButtonForegroundPressed" ResourceKey="AccentRedBrush"/>
                                                    </Button.Resources>
                                                </Button>
                                            </controls:WrapPanel>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ══════════════════════════════════════════════════════════
                             SECTION 7: COMPONENTS (ReLimiter + OptiScaler)
                             ══════════════════════════════════════════════════════════ -->
                        <StackPanel Tag="Section:Components" Spacing="12">
                            <StackPanel Spacing="3">
                                <TextBlock Text="Components" FontSize="18" FontWeight="Bold"
                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="Defaults for ReLimiter and OptiScaler. Each game's ⚙ overrides these."
                                           FontSize="12" LineHeight="17" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>

                            <Border Style="{StaticResource SettingsCardStyle}">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="ReLimiter and OptiScaler" Style="{StaticResource SettingsCardTitleStyle}"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Left: ReLimiter -->
                                        <StackPanel Grid.Column="0" Spacing="9" Margin="0,0,20,0" VerticalAlignment="Top">
                                            <TextBlock Text="ReLimiter" Style="{StaticResource SettingsHeadStyle}"
                                                       ToolTipService.ToolTip="ReLimiter OSD hotkey and global feature settings applied to all games."/>
                                            <Grid ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*" MaxWidth="210"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Overlay key" Style="{StaticResource SettingsLabelStyle}"/>
                                                <TextBox Grid.Column="1" x:Name="UlHotkeyBox" x:FieldModifier="internal"
                                                         PlaceholderText="Press a key..." IsReadOnly="True"
                                                         Style="{StaticResource SettingsTextBoxStyle}" FontFamily="Consolas"
                                                         ToolTipService.ToolTip="The key that toggles the ReLimiter OSD overlay in-game."
                                                         PreviewKeyDown="UlHotkeyBox_PreviewKeyDown"/>
                                            </Grid>
                                            <Grid ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*" MaxWidth="210"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Target FPS" Style="{StaticResource SettingsLabelStyle}"/>
                                                <ComboBox Grid.Column="1" x:Name="UlTargetFpsCombo" x:FieldModifier="internal"
                                                          Style="{StaticResource SettingsComboStyle}"
                                                          ToolTipService.ToolTip="Global FPS cap written to all relimiter.ini files. Select a VRR preset or Custom for a manual value."
                                                          SelectionChanged="UlTargetFpsCombo_SelectionChanged">
                                                    <!-- Items populated in code-behind -->
                                                </ComboBox>
                                            </Grid>
                                            <Grid ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*" MaxWidth="210"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Shared presets" Style="{StaticResource SettingsLabelStyle}"/>
                                                <ComboBox Grid.Column="1" x:Name="UlSharedPresetsCombo" x:FieldModifier="internal"
                                                          Style="{StaticResource SettingsComboStyle}"
                                                          ToolTipService.ToolTip="When On, all games share the same OSD presets file. When Off, each game has its own presets."
                                                          SelectionChanged="UlSharedPresetsCombo_SelectionChanged">
                                                    <ComboBoxItem Content="Off"/>
                                                    <ComboBoxItem Content="On"/>
                                                </ComboBox>
                                            </Grid>
                                            <Grid ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*" MaxWidth="210"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="DLSS hooks" Style="{StaticResource SettingsLabelStyle}"/>
                                                <ComboBox Grid.Column="1" x:Name="UlDlssHooksCombo" x:FieldModifier="internal"
                                                          Style="{StaticResource SettingsComboStyle}"
                                                          ToolTipService.ToolTip="Shows DLSS quality mode, render resolution, and active features on the ReLimiter OSD. Disable if experiencing crashes."
                                                          SelectionChanged="UlDlssHooksCombo_SelectionChanged">
                                                    <ComboBoxItem Content="Off"/>
                                                    <ComboBoxItem Content="On"/>
                                                </ComboBox>
                                            </Grid>
                                            <Button x:Name="ApplyUlHotkeyBtn" x:FieldModifier="internal"
                                                    Content="Write to all ReLimiter games"
                                                    Click="ApplyUlOsdHotkey_Click"
                                                    Style="{StaticResource SettingsPrimaryButtonStyle}" Foreground="{StaticResource SettingsButtonBlueBrush}"
                                                    ToolTipService.ToolTip="Writes the overlay key, Shared presets, DLSS hooks and Target FPS into every game's relimiter.ini. Skips hidden games.">
                                                <Button.Resources>
                                                    <StaticResource x:Key="ButtonForegroundPointerOver" ResourceKey="SettingsButtonBlueBrush"/>
                                                    <StaticResource x:Key="ButtonForegroundPressed" ResourceKey="SettingsButtonBlueBrush"/>
                                                </Button.Resources>
                                            </Button>
                                        </StackPanel>

                                        <Border Grid.Column="1" Width="1" Background="{StaticResource BorderDefaultBrush}"/>

                                        <!-- Right: OptiScaler -->
                                        <StackPanel Grid.Column="2" Spacing="9" Margin="20,0,0,0" VerticalAlignment="Top">
                                            <TextBlock Text="OptiScaler" Style="{StaticResource SettingsHeadStyle}"
                                                       ToolTipService.ToolTip="GPU type, DLSS input settings, and overlay hotkey for OptiScaler installations."/>
                                            <Grid ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*" MaxWidth="210"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="GPU type" Style="{StaticResource SettingsLabelStyle}"/>
                                                <ComboBox Grid.Column="1" x:Name="OsGpuCombo" x:FieldModifier="internal"
                                                          Style="{StaticResource SettingsComboStyle}"
                                                          ToolTipService.ToolTip="The GPU brand in this PC. RHI uses it to pick which OptiScaler.ini to install. DLSS inputs appears for AMD and Intel."
                                                          SelectionChanged="OsGpuCombo_SelectionChanged">
                                                    <x:String>NVIDIA</x:String>
                                                    <x:String>AMD</x:String>
                                                    <x:String>Intel</x:String>
                                                </ComboBox>
                                            </Grid>
                                            <!-- DLSS inputs: shown by C# for AMD and Intel -->
                                            <StackPanel x:Name="OsDlssInputsPanel" x:FieldModifier="internal" Visibility="Collapsed">
                                                <Grid ColumnSpacing="10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*" MaxWidth="210"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="DLSS inputs" Style="{StaticResource SettingsLabelStyle}"/>
                                                    <ComboBox Grid.Column="1" x:Name="OsDlssInputsCombo" x:FieldModifier="internal"
                                                              Style="{StaticResource SettingsComboStyle}"
                                                              ToolTipService.ToolTip="On: OptiScaler reports an NVIDIA GPU to the game, so the game offers DLSS and OptiScaler uses its inputs. Off: no GPU spoofing. Used when OptiScaler.ini is installed."
                                                              SelectionChanged="OsDlssInputsCombo_SelectionChanged">
                                                        <x:String>Off</x:String>
                                                        <x:String>On</x:String>
                                                    </ComboBox>
                                                </Grid>
                                            </StackPanel>
                                            <Grid ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*" MaxWidth="210"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Overlay key" Style="{StaticResource SettingsLabelStyle}"/>
                                                <ComboBox Grid.Column="1" x:Name="OsHotkeyCombo" x:FieldModifier="internal"
                                                          Style="{StaticResource SettingsComboStyle}"
                                                          ToolTipService.ToolTip="The key that opens the OptiScaler overlay in game. Saved straight away for new installs; use the button to update games that already have OptiScaler."
                                                          SelectionChanged="OsHotkeyCombo_SelectionChanged">
                                                    <x:String>Insert</x:String>
                                                    <x:String>Home</x:String>
                                                    <x:String>End</x:String>
                                                    <x:String>Delete</x:String>
                                                    <x:String>Page Up</x:String>
                                                    <x:String>Page Down</x:String>
                                                    <x:String>F1</x:String>
                                                    <x:String>F2</x:String>
                                                    <x:String>F3</x:String>
                                                    <x:String>F4</x:String>
                                                    <x:String>F5</x:String>
                                                    <x:String>F6</x:String>
                                                    <x:String>F7</x:String>
                                                    <x:String>F8</x:String>
                                                    <x:String>F9</x:String>
                                                    <x:String>F10</x:String>
                                                    <x:String>F11</x:String>
                                                    <x:String>F12</x:String>
                                                </ComboBox>
                                            </Grid>
                                            <Button x:Name="ApplyOsHotkeyBtn" x:FieldModifier="internal"
                                                    Content="Write key to all OptiScaler games"
                                                    Click="ApplyOsHotkey_Click"
                                                    Style="{StaticResource SettingsPrimaryButtonStyle}" Foreground="{StaticResource SettingsButtonBlueBrush}"
                                                    ToolTipService.ToolTip="Writes the overlay key into OptiScaler.ini in every game that has OptiScaler installed. Skips hidden games.">
                                                <Button.Resources>
                                                    <StaticResource x:Key="ButtonForegroundPointerOver" ResourceKey="SettingsButtonBlueBrush"/>
                                                    <StaticResource x:Key="ButtonForegroundPressed" ResourceKey="SettingsButtonBlueBrush"/>
                                                </Button.Resources>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ══════════════════════════════════════════════════════════
                             SECTION 8: TOOLS & MAINTENANCE
                             (Freeze Diagnostics, dev unlock only, is appended after this in SettingsHandler)
                             ══════════════════════════════════════════════════════════ -->
                        <StackPanel Tag="Section:Tools" Spacing="12">
                            <StackPanel Spacing="3">
                                <TextBlock Text="Tools &amp; Maintenance" FontSize="18" FontWeight="Bold"
                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="Bulk actions, folders and logs, and last-resort fixes."
                                           FontSize="12" LineHeight="17" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>

                            <!-- Card: Tools -->
                            <Border Style="{StaticResource SettingsCardStyle}">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="Tools" Style="{StaticResource SettingsCardTitleStyle}"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Left: Deploy to many games (Mass INI + Mass Preset Install) -->
                                        <StackPanel Grid.Column="0" Spacing="9" Margin="0,0,20,0" VerticalAlignment="Top">
                                            <TextBlock Text="Deploy to many games" Style="{StaticResource SettingsHeadStyle}"/>
                                            <TextBlock Style="{StaticResource SettingsNoteStyle}"
                                                       Text="Deploy INI files or ReShade presets to many games at once. Your hotkeys and screenshot folder are kept."/>
                                            <controls:WrapPanel HorizontalSpacing="8" VerticalSpacing="8">
                                                <Button Content="ReShade.ini" Click="MassDeployRsIni_Click"
                                                        Style="{StaticResource SettingsButtonStyle}" Foreground="{StaticResource SettingsLabelBrush}"/>
                                                <Button Content="relimiter.ini" Click="MassDeployUlIni_Click"
                                                        Style="{StaticResource SettingsButtonStyle}" Foreground="{StaticResource SettingsLabelBrush}"/>
                                                <Button Content="DisplayCommander.ini" Click="MassDeployDcIni_Click"
                                                        Style="{StaticResource SettingsButtonStyle}" Foreground="{StaticResource SettingsLabelBrush}"/>
                                                <Button Content="OptiScaler.ini" Click="MassDeployOsIni_Click"
                                                        Style="{StaticResource SettingsButtonStyle}" Foreground="{StaticResource SettingsLabelBrush}"/>
                                                <Button Content="ReShade preset" Click="MassPresetInstall_Click"
                                                        Style="{StaticResource SettingsButtonStyle}" Foreground="{StaticResource SettingsLabelBrush}"
                                                        ToolTipService.ToolTip="Install a ReShade preset into many games at once."/>
                                            </controls:WrapPanel>
                                        </StackPanel>

                                        <Border Grid.Column="1" Width="1" Background="{StaticResource BorderDefaultBrush}"/>

                                        <!-- Right: Folders and logs -->
                                        <StackPanel Grid.Column="2" Spacing="9" Margin="20,0,0,0" VerticalAlignment="Top">
                                            <TextBlock Text="Folders and logs" Style="{StaticResource SettingsHeadStyle}"
                                                       ToolTipService.ToolTip="All RHI data is stored in AppData. The Logs folder contains session usage logs useful for troubleshooting."/>
                                            <TextBlock Style="{StaticResource SettingsNoteStyle}"
                                                       Text="Drop your own ReShade, DLSS or Streamline DLLs into the Custom folder to use them as per-game overrides."/>
                                            <controls:WrapPanel HorizontalSpacing="8" VerticalSpacing="8">
                                                <Button x:Name="OpenAppDataBtn" Content="RHI data" Click="OpenAppDataFolder_Click"
                                                        Style="{StaticResource SettingsButtonStyle}" Foreground="{StaticResource SettingsLabelBrush}"
                                                        ToolTipService.ToolTip="Open RHI's data folder in AppData"/>
                                                <Button x:Name="OpenDownloadsBtn" Content="Downloads" Click="OpenDownloadsFolder_Click"
                                                        Style="{StaticResource SettingsButtonStyle}" Foreground="{StaticResource SettingsLabelBrush}"
                                                        ToolTipService.ToolTip="Open RHI's downloads folder"/>
                                                <Button x:Name="OpenCustomBtn" Content="Custom" Click="OpenCustomFolder_Click"
                                                        Style="{StaticResource SettingsButtonStyle}" Foreground="{StaticResource SettingsLabelBrush}"
                                                        ToolTipService.ToolTip="Open the Custom folder for your own ReShade, DLSS or Streamline DLLs"/>
                                                <Button x:Name="OpenLogsBtn" Content="Logs" Click="OpenLogsFolder_Click"
                                                        Style="{StaticResource SettingsButtonStyle}" Foreground="{StaticResource SettingsLabelBrush}"
                                                        ToolTipService.ToolTip="Open the Logs folder"/>
                                                <Button x:Name="CopyLogsArchiveBtn" Content="Copy logs" Click="CopyLogsArchive_Click"
                                                        Style="{StaticResource SettingsPrimaryButtonStyle}" Foreground="{StaticResource SettingsButtonBlueBrush}"
                                                        ToolTipService.ToolTip="Creates a zip archive of all logs and copies it to clipboard — paste directly into Discord">
                                                    <Button.Resources>
                                                        <StaticResource x:Key="ButtonForegroundPointerOver" ResourceKey="SettingsButtonBlueBrush"/>
                                                        <StaticResource x:Key="ButtonForegroundPressed" ResourceKey="SettingsButtonBlueBrush"/>
                                                    </Button.Resources>
                                                </Button>
                                                <Button x:Name="ExportGameDataBtn" x:FieldModifier="internal" Content="Export game data" Click="ExportGameData_Click"
                                                        Style="{StaticResource SettingsButtonStyle}" Foreground="{StaticResource SettingsLabelBrush}"
                                                        ToolTipService.ToolTip="Gathers game library data (APIs, exe paths, engine info) and copies a JSON file to clipboard — paste into Discord to share with the RHI community database"/>
                                            </controls:WrapPanel>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Card: Troubleshooting -->
                            <Border Style="{StaticResource SettingsCardStyle}" BorderBrush="#FF5A2A2A">
                                <StackPanel Spacing="12">
                                    <StackPanel Spacing="3">
                                        <TextBlock Text="Troubleshooting" Style="{StaticResource SettingsCardTitleStyle}"
                                                   Foreground="{StaticResource AccentRedBrush}"/>
                                        <TextBlock Style="{StaticResource SettingsCardDescStyle}"
                                                   Text="Use these if something is badly wrong. Each asks first."/>
                                    </StackPanel>
                                    <controls:WrapPanel HorizontalSpacing="8" VerticalSpacing="8">
                                        <Button x:Name="FullRefreshBtn" Content="Full refresh"
                                                Click="FullRefreshButton_Click"
                                                Style="{StaticResource SettingsDangerButtonStyle}" Foreground="{StaticResource AccentRedBrush}"
                                                ToolTipService.ToolTip="Clears all caches and re-scans everything from disk. Use as a last resort if games are missing, paths have changed, DLSS has been added to a game, or the DLSS section is missing from a game card.">
                                            <Button.Resources>
                                                <StaticResource x:Key="ButtonForegroundPointerOver" ResourceKey="AccentRedBrush"/>
                                                <StaticResource x:Key="ButtonForegroundPressed" ResourceKey="AccentRedBrush"/>
                                            </Button.Resources>
                                        </Button>
                                        <Button x:Name="PurgeCacheBtn"
                                                Content="Purge staging files"
                                                Click="PurgeCachedFiles_Click"
                                                Style="{StaticResource SettingsDangerButtonStyle}" Foreground="{StaticResource AccentRedBrush}"
                                                ToolTipService.ToolTip="Deletes cached DLSS, Streamline, and component staging files to free disk space. Shaders, installed addons, and version metadata are preserved. Files are re-downloaded automatically when needed.">
                                            <Button.Resources>
                                                <StaticResource x:Key="ButtonForegroundPointerOver" ResourceKey="AccentRedBrush"/>
                                                <StaticResource x:Key="ButtonForegroundPressed" ResourceKey="AccentRedBrush"/>
                                            </Button.Resources>
                                        </Button>
                                    </controls:WrapPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Hidden combos retained for code-behind compatibility -->
                        <StackPanel Visibility="Collapsed">
                            <ComboBox x:Name="ReShadeChannelCombo" x:FieldModifier="internal"
                                      SelectionChanged="ReShadeChannelCombo_SelectionChanged">
                                <x:String>Stable (reshade.me releases)</x:String>
                                <x:String>Nightly (GitHub Actions builds)</x:String>
                            </ComboBox>
                            <ComboBox x:Name="DxvkVariantCombo" x:FieldModifier="internal"
                                      SelectionChanged="DxvkVariantCombo_SelectionChanged">
                                <x:String>Development (nightly builds)</x:String>
                                <x:String>Stable (tagged releases)</x:String>
                                <x:String>Lilium HDR</x:String>
                            </ComboBox>
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- end SettingsPanel -->

            <!--  ABOUT PANEL  -->
            <Grid x:Name="AboutPanel" x:FieldModifier="internal" Visibility="Collapsed" Background="{StaticResource SurfaceBaseBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Back button bar -->
                <Border Grid.Row="0" Padding="24,12,24,10" Background="Transparent"
                        BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,0,0,1">
                    <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                        <Button Content="← Back to Games"
                                Click="AboutBack_Click"
                                Background="{StaticResource SurfaceOverlayBrush}" Foreground="{StaticResource TextSecondaryBrush}"
                                BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1"
                                CornerRadius="8" Padding="12,6" FontSize="12"/>
                        <TextBlock Text="About" FontSize="20" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Scrollable about content -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel Padding="32,24,32,40" Spacing="14" MaxWidth="800"
                                HorizontalAlignment="Center">

                        <!-- ── About ───────────────────────────────────────────────── -->
                        <Border Background="{StaticResource SurfaceRaisedBrush}" CornerRadius="10" Padding="20,16"
                                BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
                            <StackPanel Spacing="10">
                                <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,0,0,4">
                                    <Image Source="icon.ico" Width="48" Height="48"/>
                                    <StackPanel VerticalAlignment="Center" Spacing="4">
                                        <TextBlock FontSize="20" FontWeight="Bold">
                                            <Run Text="RHI" Foreground="{StaticResource AccentTealBrush}"/>
                                        </TextBlock>
                                        <TextBlock x:Name="AboutVersionText" x:FieldModifier="internal" FontSize="12" Foreground="{StaticResource InlineDescriptionBrush}"/>
                                    </StackPanel>
                                </StackPanel>

                                <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource TextTertiaryBrush}" LineHeight="20"
                                           Text="The all-in-one game enhancement toolkit for PC. Auto-detects games from 8 storefronts and provides one-click management for ReShade, HDR mods, shaders, DLSS/Streamline, frame limiters, NVIDIA driver profiles, and more — all from one place."/>

                                <!-- What it does -->
                                <Border Background="{StaticResource SurfaceToolbarBrush}" CornerRadius="8" Padding="14,10"
                                        BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="What RHI manages" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource InlineDescriptionBrush}" LineHeight="18"
                                                   Text="ReShade &amp; shader packs · RenoDX HDR mods · Luma Framework · DLSS/Streamline version swaps &amp; presets · NVIDIA driver profile settings (VSync, Low Latency, ReBAR, Smooth Motion, Power) · OptiScaler · ReLimiter &amp; Display Commander frame limiters · RE Framework · DXVK · UE-Extended native HDR · Per-game overrides for everything."/>
                                    </StackPanel>
                                </Border>

                                <!-- Disclaimer -->
                                <!-- Single-player warning -->
                                <Border Background="{StaticResource AccentRedBgBrush}" CornerRadius="8" Padding="14,10"
                                        BorderBrush="{StaticResource AccentPurpleBorderBrush}" BorderThickness="1">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="Single-player only" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{StaticResource AccentRedBrush}"/>
                                        <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource InlineDescriptionBrush}" LineHeight="18"
                                                   Text="RHI installs ReShade with full addon support, OptiScaler, and can swap DLSS/Streamline DLLs. These modifications may be flagged by anti-cheat in online or multiplayer games. Uninstall ReShade, OptiScaler, and restore DLSS/Streamline defaults before playing online."/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- ── Credits ─────────────────────────────────────────────── -->
                        <Border Background="{StaticResource SurfaceRaisedBrush}" CornerRadius="10" Padding="20,16"
                                BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Credits &amp; Acknowledgements" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource InlineDescriptionBrush}" LineHeight="20"
                                           Text="This app would not exist without the work of the following people and projects."/>

                                <!-- RenoDX -->
                                <Border Background="{StaticResource SurfaceToolbarBrush}" CornerRadius="8" Padding="12,10" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
                                    <StackPanel Spacing="3">
                                        <TextBlock FontSize="12">
                                            <Run Text="RenoDX" FontWeight="SemiBold" Foreground="{StaticResource AccentTealBrush}"/>
                                            <Run Text=" by clshortfuse &amp; contributors" Foreground="{StaticResource TextTertiaryBrush}"/>
                                            <Run Text="  ·  MIT Licence" Foreground="{StaticResource InlineDescriptionBrush}" FontSize="11"/>
                                        </TextBlock>
                                        <TextBlock FontSize="11" Foreground="{StaticResource InlineDescriptionBrush}" Margin="0,0,0,0" TextWrapping="Wrap"
                                                   Text="HDR mod framework powering 800+ games. The entire reason this app exists."/>
                                        <HyperlinkButton NavigateUri="https://github.com/clshortfuse/renodx" Padding="0,2,0,0" FontSize="11">
                                            <TextBlock Foreground="{StaticResource AccentTealDimBrush}" Text="github.com/clshortfuse/renodx"/>
                                        </HyperlinkButton>
                                    </StackPanel>
                                </Border>

                                <!-- ReShade -->
                                <Border Background="{StaticResource SurfaceToolbarBrush}" CornerRadius="8" Padding="12,10" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
                                    <StackPanel Spacing="3">
                                        <TextBlock FontSize="12">
                                            <Run Text="ReShade" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                                            <Run Text=" by Crosire" Foreground="{StaticResource TextTertiaryBrush}"/>
                                            <Run Text="  ·  BSD 3-Clause Licence" Foreground="{StaticResource InlineDescriptionBrush}" FontSize="11"/>
                                        </TextBlock>
                                        <TextBlock FontSize="11" Foreground="{StaticResource InlineDescriptionBrush}" TextWrapping="Wrap"
                                                   Text="Post-processing injection framework. Downloaded with full addon support from reshade.me and cached locally. Copyright © Crosire."/>
                                        <HyperlinkButton NavigateUri="https://reshade.me" Padding="0,2,0,0" FontSize="11">
                                            <TextBlock Foreground="{StaticResource AccentTealDimBrush}" Text="reshade.me  ·  github.com/crosire/reshade"/>
                                        </HyperlinkButton>
                                    </StackPanel>
