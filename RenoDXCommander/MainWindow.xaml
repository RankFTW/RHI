                                          SelectionChanged="InterfaceLanguageCombo_SelectionChanged">
                                    <ComboBoxItem ContentTemplate="{StaticResource LocalizedOptionTemplate}" Content="English" Tag="en-US"/>
                                    <ComboBoxItem ContentTemplate="{StaticResource LocalizedOptionTemplate}" Content="Simplified Chinese" Tag="zh-CN"/>
                                </ComboBox>
                                <TextBlock Text="{Binding [InterfaceLanguageRestart_Text], Source={StaticResource LocalizedStrings}, Mode=OneWay}"
                                           TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource InlineDescriptionBrush}"/>
                            </StackPanel>
                        </Border>

                        <!-- ══════════════════════════════════════════════════════════
                             CARD 1: GAME LIBRARY
                             ══════════════════════════════════════════════════════════ -->
                        <Border Background="{StaticResource SurfaceRaisedBrush}" CornerRadius="10" Padding="20,16"
                                BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
                            <StackPanel Spacing="12">
                            <TextBlock Text="{Binding [Ld64d250a3df5_Text], Source={StaticResource LocalizedStrings}, Mode=OneWay}" FontSize="15" FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                            <Grid ColumnSpacing="0" RowSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="25"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Left: Check For Updates -->
                                <Grid Grid.Column="0" RowSpacing="8">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <StackPanel Grid.Row="0" Spacing="8">
                                        <TextBlock Text="{Binding [L9fcf0d0d050b_Text], Source={StaticResource LocalizedStrings}, Mode=OneWay}" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource InlineDescriptionBrush}" LineHeight="18"
                                                   Text="{Binding [L2d78f34bf00b_Text], Source={StaticResource LocalizedStrings}, Mode=OneWay}"/>
                                    </StackPanel>
                                    <Button Grid.Row="1" x:Name="CheckForUpdatesBtn" Content="{Binding [L5342b2135381_Content], Source={StaticResource LocalizedStrings}, Mode=OneWay}"
                                            Click="CheckForUpdatesButton_Click"
                                            Background="{StaticResource AccentBlueBgBrush}" Foreground="{StaticResource AccentBlueBrush}"
                                            BorderBrush="{StaticResource AccentBlueBorderBrush}" BorderThickness="1"
                                            CornerRadius="8" Padding="12,7" FontSize="12"
                                            HorizontalAlignment="Stretch"
                                            ToolTipService.ToolTip="{Binding [L5342b2135381_ToolTip], Source={StaticResource LocalizedStrings}, Mode=OneWay}"/>
                                    <TextBlock Grid.Row="2" TextWrapping="Wrap" FontSize="11"
                                               Foreground="{StaticResource InlineDescriptionBrush}" LineHeight="18" Margin="0,8,0,0"
                                               Text="{Binding [L2fa138a348d2_Text], Source={StaticResource LocalizedStrings}, Mode=OneWay}"/>
                                    <ComboBox Grid.Row="3" x:Name="BackgroundUpdateChecksCombo" x:FieldModifier="internal"
                                              FontSize="12" HorizontalAlignment="Stretch"
                                              SelectionChanged="BackgroundUpdateChecksCombo_SelectionChanged">
