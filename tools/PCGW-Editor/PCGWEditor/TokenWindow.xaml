<Window x:Class="PCGWEditor.TokenWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GitHub Token" SizeToContent="Height" Width="520"
        Style="{StaticResource ThemedWindow}"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False">
    <StackPanel>
        <StackPanel Margin="24,20,24,20">
            <TextBlock Text="GitHub personal access token" Style="{StaticResource DialogTitle}" Margin="0,0,0,6"/>
            <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,16"
                       Text="Required for pushing changes to rhi-repo. Needs repo write access (Contents: Read &amp; Write)."/>
            <TextBox x:Name="TokenBox" Style="{StaticResource MonoTextBox}" t:Ui.Placeholder="github_pat_..."
                     xmlns:t="clr-namespace:RhiTools.Theme"/>
        </StackPanel>

        <Border Style="{StaticResource DialogFooter}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Content="Save" Click="Save_Click" Style="{StaticResource AccentButton}" IsDefault="True"/>
                <Button Grid.Column="2" Content="Cancel" Click="Cancel_Click" IsCancel="True"/>
            </Grid>
        </Border>
    </StackPanel>
</Window>
