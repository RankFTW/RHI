<Window x:Class="PCGWEditor.FetchSummaryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Fetch Results" Height="580" Width="580"
        Style="{StaticResource ThemedWindow}"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" x:Name="TitleLabel" Style="{StaticResource DialogTitle}" Margin="24,20,24,12"/>

        <!-- Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,0,24,16">
            <StackPanel>

                <!-- Nothing changed -->
                <TextBlock x:Name="NoChangesLabel" Visibility="Collapsed" Style="{StaticResource Caption}" FontSize="13"
                           Text="No changes found since the last fetch. Everything is up to date."/>

                <!-- New games -->
                <Border x:Name="NewSection" Visibility="Collapsed" Style="{StaticResource Card}" Padding="14,12">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="&#xE710;" Style="{StaticResource Glyph}" FontSize="13"
                                       Foreground="{DynamicResource SuccessText}" Margin="0,0,8,0"/>
                            <TextBlock x:Name="NewCountLabel" Foreground="{DynamicResource SuccessText}" FontWeight="SemiBold"/>
                        </StackPanel>
                        <ListBox x:Name="NewList" MaxHeight="180" FontSize="12" Margin="-8,0"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                    </StackPanel>
                </Border>

                <!-- Kept for the code that shows it between sections; cards already have spacing -->
                <Border x:Name="SectionSep" Height="0" Visibility="Collapsed"/>

                <!-- Updated games -->
                <Border x:Name="UpdatedSection" Visibility="Collapsed" Style="{StaticResource Card}" Padding="14,12">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="&#xE895;" Style="{StaticResource Glyph}" FontSize="13"
                                       Foreground="{DynamicResource CautionText}" Margin="0,0,8,0"/>
                            <TextBlock x:Name="UpdatedCountLabel" Foreground="{DynamicResource CautionText}" FontWeight="SemiBold"/>
                        </StackPanel>
                        <ListBox x:Name="UpdatedList" MaxHeight="220" FontSize="12" Margin="-8,0"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Close -->
        <Border Grid.Row="2" Style="{StaticResource DialogFooter}">
            <Button Content="Close" Click="Close_Click" HorizontalAlignment="Right" MinWidth="110"
                    Style="{StaticResource AccentButton}" IsDefault="True" IsCancel="True"/>
        </Border>
    </Grid>
</Window>
