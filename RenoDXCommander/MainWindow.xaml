                                    <TextBlock x:Name="DetailDcLabel" x:FieldModifier="internal" Grid.Column="0" Text="Display Commander" FontSize="12"
                                               Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="DetailDcStatus" x:FieldModifier="internal" Grid.Column="1" FontSize="12"
                                               VerticalAlignment="Center" HorizontalTextAlignment="Center"
                                               PointerPressed="DetailDcStatus_PointerPressed"
                                               PointerEntered="LinkText_PointerEntered" PointerExited="LinkText_PointerExited"/>
                                    <Button x:Name="DetailDcInfoBtn" x:FieldModifier="internal" Grid.Column="2"
                                            Content="Инфо" FontSize="11" Padding="6,2,6,2"
                                            Background="{StaticResource SurfaceOverlayBrush}"
                                            Foreground="{StaticResource TextSecondaryBrush}"
                                            BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1"
                                            CornerRadius="8" Width="36" Height="32"
                                            Click="InfoButton_Click"/>
                                    <Button x:Name="DetailDcInstallBtn" x:FieldModifier="internal" Grid.Column="3"
                                            Click="InstallDcButton_Click"
                                            HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                            CornerRadius="8" FontSize="12" Height="32"/>
                                    <Button x:Name="DetailDcIniBtn" x:FieldModifier="internal" Grid.Column="4"
                                            Click="DcCogButton_Click"
                                            Background="{StaticResource SurfaceOverlayBrush}" Foreground="{StaticResource TextSecondaryBrush}"
                                            BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1"
                                            CornerRadius="8" Width="36" Height="32" Padding="0"
                                            ToolTipService.ToolTip="Настройки Display Commander">
                                        <TextBlock Text="⚙" FontSize="14" HorizontalAlignment="Center"/>
                                    </Button>
                                    <Button x:Name="DetailDcDeleteBtn" x:FieldModifier="internal" Grid.Column="5"
                                            Click="UninstallDcButton_Click"
                                            Background="{StaticResource AccentRedBgBrush}" Foreground="{StaticResource AccentRedBrush}"
                                            BorderBrush="{StaticResource AccentPurpleBorderBrush}" BorderThickness="1"
                                            CornerRadius="8" Width="36" Height="32" Padding="0"
                                            ToolTipService.ToolTip="Удалить Display Commander" Opacity="0" IsHitTestVisible="False">
                                        <TextBlock Text="✕" FontSize="12" HorizontalAlignment="Center" Foreground="{StaticResource AccentRedBrush}"/>
                                    </Button>
                                </Grid>

                                <!-- No mod message -->
                                <Border x:Name="DetailNoModMsg" x:FieldModifier="internal" Visibility="Collapsed"
                                        Background="{StaticResource AccentPurpleBgBrush}" CornerRadius="8" Padding="12,8"
                                        BorderBrush="{StaticResource AccentPurpleBorderBrush}" BorderThickness="1">
                                    <TextBlock Text="Для этой игры нет мода RenoDX"
                                               FontSize="12" Foreground="{StaticResource TextDisabledBrush}" TextAlignment="Center"/>
                                </Border>

                                <!-- Progress bars -->
                                <StackPanel x:Name="DetailProgressSection" Spacing="4">
                                    <ProgressBar x:Name="DetailRefProgress" x:FieldModifier="internal" Visibility="Collapsed"
                                                 Maximum="100" Height="3" CornerRadius="2"
                                                 Foreground="{StaticResource AccentBlueBrush}" Background="{StaticResource SurfaceToolbarBrush}"/>
                                    <TextBlock x:Name="DetailRefMessage" x:FieldModifier="internal" FontSize="10" Foreground="{StaticResource AccentBlueBrush}"
                                               Visibility="Collapsed" TextWrapping="Wrap"/>

                                    <ProgressBar x:Name="DetailRsProgress" x:FieldModifier="internal" Visibility="Collapsed"
                                                 Maximum="100" Height="3" CornerRadius="2"
                                                 Foreground="{StaticResource AccentTealDimBrush}" Background="{StaticResource SurfaceToolbarBrush}"/>
                                    <TextBlock x:Name="DetailRsMessage" x:FieldModifier="internal" FontSize="10" Foreground="{StaticResource TextTertiaryBrush}"
                                               Visibility="Collapsed" TextWrapping="Wrap"/>

                                    <ProgressBar x:Name="DetailUlProgress" x:FieldModifier="internal" Visibility="Collapsed"
                                                 Maximum="100" Height="3" CornerRadius="2"
                                                 Foreground="{StaticResource AccentBlueBrush}" Background="{StaticResource SurfaceToolbarBrush}"/>
                                    <TextBlock x:Name="DetailUlMessage" x:FieldModifier="internal" FontSize="10" Foreground="{StaticResource AccentBlueBrush}"
                                               Visibility="Collapsed" TextWrapping="Wrap"/>
                                    <ProgressBar x:Name="DetailDcProgress" x:FieldModifier="internal" Visibility="Collapsed"
                                                 Maximum="100" Height="3" CornerRadius="2"
                                                 Foreground="{StaticResource AccentBlueBrush}" Background="{StaticResource SurfaceToolbarBrush}"/>
                                    <TextBlock x:Name="DetailDcMessage" x:FieldModifier="internal" FontSize="10" Foreground="{StaticResource AccentBlueBrush}"
                                               Visibility="Collapsed" TextWrapping="Wrap"/>
                                    <ProgressBar x:Name="DetailDofFixProgress" x:FieldModifier="internal" Visibility="Collapsed"
                                                 Maximum="100" Height="3" CornerRadius="2"
                                                 Foreground="{StaticResource AccentBlueBrush}" Background="{StaticResource SurfaceToolbarBrush}"/>
                                    <TextBlock x:Name="DetailDofFixMessage" x:FieldModifier="internal" FontSize="10" Foreground="{StaticResource AccentBlueBrush}"
                                               Visibility="Collapsed" TextWrapping="Wrap"/>
                                    <ProgressBar x:Name="DetailDxvkProgress" x:FieldModifier="internal" Visibility="Collapsed"
                                                 Maximum="100" Height="3" CornerRadius="2"
                                                 Foreground="{StaticResource AccentBlueBrush}" Background="{StaticResource SurfaceToolbarBrush}"/>
                                    <TextBlock x:Name="DetailDxvkMessage" x:FieldModifier="internal" FontSize="10" Foreground="{StaticResource AccentBlueBrush}"
                                               Visibility="Collapsed" TextWrapping="Wrap"/>
                                    <ProgressBar x:Name="DetailRdxProgress" x:FieldModifier="internal" Visibility="Collapsed"
                                                 Maximum="100" Height="3" CornerRadius="2"
                                                 Foreground="{StaticResource AccentBlueBrush}" Background="{StaticResource SurfaceToolbarBrush}"/>
                                    <TextBlock x:Name="DetailRdxMessage" x:FieldModifier="internal" FontSize="10" Foreground="{StaticResource AccentBlueBrush}"
                                               Visibility="Collapsed" TextWrapping="Wrap"/>
                                    <ProgressBar x:Name="DetailLumaProgress" x:FieldModifier="internal" Visibility="Collapsed"
                                                 Maximum="100" Height="3" CornerRadius="2"
                                                 Foreground="{StaticResource AccentGreenBrush}" Background="{StaticResource SurfaceToolbarBrush}"/>
                                    <TextBlock x:Name="DetailLumaMessage" x:FieldModifier="internal" FontSize="10" Foreground="{StaticResource AccentGreenBrush}"
                                               Visibility="Collapsed" TextWrapping="Wrap"/>
                                </StackPanel>
                                </StackPanel><!-- /DetailComponentsBody -->
                            </StackPanel>
                        </Border>

                        <!-- ── Game Overrides section ── -->
                        <Border x:Name="OverridesContainer" x:FieldModifier="internal"
                                Background="{StaticResource SurfaceComponentTableBrush}" CornerRadius="12"
                                BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1"
                                Padding="14,12" Visibility="Collapsed">
                            <StackPanel Spacing="8">
                                <!-- Collapse header — wired in BuildOverridesPanel -->
                                <StackPanel x:Name="OverridesHeaderRow" x:FieldModifier="internal"
                                            Orientation="Horizontal" Spacing="0"/>
                                <!-- Body — all overrides content added here by builder -->
                                <StackPanel x:Name="OverridesPanel" x:FieldModifier="internal" Spacing="6"/>
                            </StackPanel>
                        </Border>

                        <!-- ── Neural Rendering section ── -->
                        <Border x:Name="NeuralRenderingContainer" x:FieldModifier="internal"
                                Background="{StaticResource SurfaceComponentTableBrush}" CornerRadius="12"
                                BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1"
                                Padding="14,12" Visibility="Collapsed">
                            <StackPanel x:Name="NeuralRenderingPanel" x:FieldModifier="internal" Spacing="6"/>
                        </Border>

                        <!-- ── Nvidia Profile Overrides section ── -->
                        <Border x:Name="NvidiaProfileContainer" x:FieldModifier="internal"
                                Background="{StaticResource SurfaceComponentTableBrush}" CornerRadius="12"
                                BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1"
                                Padding="14,12" Visibility="Collapsed">
                            <StackPanel x:Name="NvidiaProfilePanel" x:FieldModifier="internal" Spacing="6"/>
                        </Border>

                        <!-- ── Management section (folder, reset, report) ── -->
                        <Border x:Name="ManagementContainer" x:FieldModifier="internal"
                                Background="{StaticResource SurfaceComponentTableBrush}" CornerRadius="12"
                                BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1"
                                Padding="14,12" Visibility="Collapsed">
                            <StackPanel x:Name="ManagementPanel" x:FieldModifier="internal" Spacing="6"/>
                        </Border>
                        <!-- ── Extras section ── -->
                        <Border x:Name="ExtrasContainer" x:FieldModifier="internal"
                                Background="{StaticResource SurfaceComponentTableBrush}" CornerRadius="12"
                                BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1"
                                Padding="14,12" Visibility="Collapsed">
                            <StackPanel Spacing="6">
                                <StackPanel x:Name="ExtrasPanel" x:FieldModifier="internal" Spacing="6"/>
                                <ProgressBar x:Name="DetailOsProgress" x:FieldModifier="internal" Visibility="Collapsed"
                                             Maximum="100" Height="3" CornerRadius="2"
                                             Foreground="{StaticResource AccentBlueBrush}" Background="{StaticResource SurfaceToolbarBrush}"/>
                                <TextBlock x:Name="DetailOsMessage" x:FieldModifier="internal" FontSize="10" Foreground="{StaticResource AccentBlueBrush}"
                                           Visibility="Collapsed" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                    <!-- Compact Nav Arrows — overlaid on content area, visible only in Compact mode -->
                    <Button x:Name="CompactNavLeft"
                            Content="◀" Click="CompactNavLeft_Click"
                            VerticalAlignment="Center" HorizontalAlignment="Left"
                            Canvas.ZIndex="1"
                            Visibility="{x:Bind ViewModel.CompactViewVisibility, Mode=OneWay}"
                            Background="{StaticResource SurfaceInputBrush}"
                            Foreground="{StaticResource AccentTealBrush}"
                            BorderBrush="{StaticResource AccentTealBorderBrush}" BorderThickness="1"
                            CornerRadius="8" FontSize="18"
                            Padding="8,16" Margin="4,0"/>

                    <Button x:Name="CompactNavRight"
                            Content="▶" Click="CompactNavRight_Click"
                            VerticalAlignment="Center" HorizontalAlignment="Right"
                            Canvas.ZIndex="1"
                            Visibility="{x:Bind ViewModel.CompactViewVisibility, Mode=OneWay}"
                            Background="{StaticResource SurfaceInputBrush}"
                            Foreground="{StaticResource AccentTealBrush}"
                            BorderBrush="{StaticResource AccentTealBorderBrush}" BorderThickness="1"
                            CornerRadius="8" FontSize="18"
                            Padding="8,16" Margin="0,0,4,0"/>

                    <!-- Skeleton detail panel overlay (removed programmatically after first load) -->
                    <ScrollViewer x:Name="SkeletonDetailScrollViewer" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled" Visibility="Visible">
                        <StackPanel x:Name="SkeletonDetailPanel" Spacing="16"
                                    Padding="24,18,24,24"/>
                    </ScrollViewer>

                </Grid>
            </Grid>

            <!--  SETTINGS PANEL  -->
            <Grid x:Name="SettingsPanel" x:FieldModifier="internal" Visibility="Collapsed" Background="{StaticResource SurfaceBaseBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Back button bar -->
                <Border Grid.Row="0" Padding="24,12,24,10" Background="Transparent"
                        BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,0,0,1">
                    <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                        <Button x:Name="SettingsBackBtn" Content="← К играм"
                                Click="SettingsBack_Click"
                                Background="{StaticResource SurfaceOverlayBrush}" Foreground="{StaticResource TextSecondaryBrush}"
                                BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1"
                                CornerRadius="8" Padding="12,6" FontSize="12"/>
                        <TextBlock Text="Настройки" FontSize="20" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Scrollable settings content -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel Padding="32,24,32,40" Spacing="14" MaxWidth="800"
                                HorizontalAlignment="Center">

                        <!-- ══════════════════════════════════════════════════════════
                             CARD 1: GAME LIBRARY
                             ══════════════════════════════════════════════════════════ -->
                        <Border Background="{StaticResource SurfaceRaisedBrush}" CornerRadius="10" Padding="20,16"
                                BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
                            <StackPanel Spacing="12">
                            <TextBlock Text="Обновления компонентов" FontSize="15" FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                            <Grid ColumnSpacing="0" RowSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="25"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Left: Check For Updates -->
                                <Grid Grid.Column="0" RowSpacing="8">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <StackPanel Grid.Row="0" Spacing="8">
                                        <TextBlock Text="Проверить обновления" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource InlineDescriptionBrush}" LineHeight="18"
                                                   Text="Загружает свежий манифест и проверяет все компоненты на обновления. Пропускает 4-часовую задержку."/>
                                    </StackPanel>
                                    <Button Grid.Row="1" x:Name="CheckForUpdatesBtn" Content="Проверить обновления"
                                            Click="CheckForUpdatesButton_Click"
                                            Background="{StaticResource AccentBlueBgBrush}" Foreground="{StaticResource AccentBlueBrush}"
                                            BorderBrush="{StaticResource AccentBlueBorderBrush}" BorderThickness="1"
                                            CornerRadius="8" Padding="12,7" FontSize="12"
                                            HorizontalAlignment="Stretch"
                                            ToolTipService.ToolTip="Проверить наличие обновлений всех компонентов и приложения"/>
                                </Grid>

                                <!-- Divider -->
                                <Border Grid.Column="1" Width="1"
                                        Background="{StaticResource BorderDefaultBrush}"
                                        VerticalAlignment="Stretch" Margin="12,0,12,0"/>

                                <!-- Right: Automatic Updates -->
                                <StackPanel Grid.Column="2" Spacing="8">
                                    <TextBlock Text="Автоматические обновления" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource InlineDescriptionBrush}" LineHeight="18"
                                               Text="Если включено, RHI тихо устанавливает обновления компонентов в фоне после каждой проверки. Если игра с обновлением была запущена, попытка повторится автоматически после её закрытия. На обновления самого приложения не влияет."/>
                                    <ComboBox x:Name="AutoUpdateComponentsCombo" x:FieldModifier="internal"
                                              FontSize="12" HorizontalAlignment="Stretch"
                                              ToolTipService.ToolTip="Автоматически и незаметно устанавливать в фоне обновления ReShade, RenoDX, ReLimiter, DC, OptiScaler, RE Framework, Luma, DXVK и DOF Fix"
                                              SelectionChanged="AutoUpdateComponentsCombo_SelectionChanged">
                                        <ComboBoxItem Content="Нет"/>
                                        <ComboBoxItem Content="Да"/>
                                    </ComboBox>
                                </StackPanel>
                            </Grid>
                            </StackPanel>
                        </Border>

                        <!-- ══════════════════════════════════════════════════════════
                             CARD 2: RESHADE & DISPLAY
                             ══════════════════════════════════════════════════════════ -->
                        <Border Background="{StaticResource SurfaceRaisedBrush}" CornerRadius="10" Padding="20,16"
                                BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
                            <StackPanel Spacing="12">
                            <TextBlock Text="ReShade и дисплей" FontSize="15" FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                            <Grid ColumnSpacing="0" RowSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="25"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- ── Left: Screenshots & Hotkeys ── -->
                                <StackPanel Grid.Row="0" Grid.Column="0" Spacing="4">
                                    <TextBlock Text="Скриншоты и горячие клавиши" FontSize="14" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <TextBlock TextWrapping="Wrap" FontSize="11"
                                               Foreground="{StaticResource InlineDescriptionBrush}" LineHeight="18"
                                               Text="Путь сохранения скриншотов и назначение клавиш ReShade применяются ко всем управляемым reshade.ini."/>
                                </StackPanel>

                                <!-- Divider -->
                                <Border Grid.Row="0" Grid.RowSpan="5" Grid.Column="1" Width="1"
                                        Background="{StaticResource BorderDefaultBrush}"
                                        VerticalAlignment="Stretch" Margin="12,0,12,0"/>

                                <!-- ── Right: HDR & Peak Brightness ── -->
                                <StackPanel Grid.Row="0" Grid.Column="2" Spacing="4">
                                    <TextBlock Text="HDR и пиковая яркость" FontSize="14" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <TextBlock TextWrapping="Wrap" FontSize="11"
                                               Foreground="{StaticResource InlineDescriptionBrush}" LineHeight="18"
                                               Text="Пиковая яркость (в нит) записывается в пресеты reshade.ini. Автопереключение HDR включает Windows HDR при запуске игры и выключает при выходе."/>
                                </StackPanel>

                                <!-- Row 1 Left: Screenshot path + Open -->
                                <Grid Grid.Row="1" Grid.Column="0" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid Grid.Column="0">
                                        <TextBox x:Name="ScreenshotPathBox" x:FieldModifier="internal"
                                                 PlaceholderText="Введите или выберите папку скриншотов"
                                                 FontSize="12" Padding="12,8,36,8"
                                                 Background="{StaticResource SurfaceInputBrush}"
                                                 Foreground="{StaticResource TextSecondaryBrush}"
                                                 BorderBrush="{StaticResource BorderSubtleBrush}"/>
                                        <Button Click="BrowseScreenshotPath_Click"
                                                Background="Transparent" BorderThickness="0"
                                                Padding="8,6" MinWidth="0" MinHeight="0"
                                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                                Margin="0,0,4,0"
                                                ToolTipService.ToolTip="Выберите папку для скриншотов">
                                            <FontIcon Glyph="&#xED25;" FontSize="14"
                                                      Foreground="{StaticResource TextTertiaryBrush}"/>
                                        </Button>
                                    </Grid>
                                    <Button Grid.Column="1" Content="Открыть" Click="OpenScreenshotFolder_Click"
                                            Background="{StaticResource AccentBlueBgBrush}" Foreground="{StaticResource AccentBlueBrush}"
                                            BorderBrush="{StaticResource AccentBlueBorderBrush}" BorderThickness="1"
                                            CornerRadius="8" Padding="12,6" FontSize="12"
                                            ToolTipService.ToolTip="Открыть папку скриншотов в Проводнике"/>
                                </Grid>

                                <!-- Row 1 Right: Peak Nits -->
                                <Grid Grid.Row="1" Grid.Column="2" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Пиковая яркость" FontSize="12"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               VerticalAlignment="Center"/>
                                    <Button Grid.Column="1" x:Name="PeakNitsAutoBtn"
                                            Content="Авто" Click="PeakNitsAuto_Click"
                                            Background="{StaticResource AccentBlueBgBrush}"
                                            Foreground="{StaticResource AccentBlueBrush}"
                                            BorderBrush="{StaticResource AccentBlueBorderBrush}" BorderThickness="1"
                                            CornerRadius="8" Padding="10,5" FontSize="12"
                                            ToolTipService.ToolTip="Автоматически считывает пиковую яркость монитора."/>
                                    <TextBox Grid.Column="2" x:Name="PeakNitsBox" x:FieldModifier="internal"
                                             PlaceholderText="нит" FontSize="12"
                                             VerticalContentAlignment="Center"
                                             Background="{StaticResource SurfaceInputBrush}"
                                             Foreground="{StaticResource TextSecondaryBrush}"
                                             BorderBrush="{StaticResource BorderSubtleBrush}"
                                             KeyDown="PeakNitsBox_KeyDown"/>
                                    <Button Grid.Column="3" Content="⚙" Click="PeakNitsCog_Click"
                                            Background="{StaticResource SurfaceOverlayBrush}"
                                            Foreground="{StaticResource ChipTextBrush}"
                                            BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1"
                                            CornerRadius="6" Padding="8,4" MinWidth="0" MinHeight="0"
                                            FontSize="12" VerticalAlignment="Center"
                                            ToolTipService.ToolTip="Выберите, каким пресетам назначать общее значение пиковой яркости."/>
                                </Grid>

                                <!-- Row 2 Left: Overlay key | Screenshot key | Per-Game Folders combo -->
                                <Grid Grid.Row="2" Grid.Column="0" ColumnSpacing="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" FontSize="11"
                                               Foreground="{StaticResource InlineDescriptionBrush}"
                                               Text="Клавиша оверлея" Margin="0,0,0,3"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1" FontSize="11"
                                               Foreground="{StaticResource InlineDescriptionBrush}"
                                               Text="Клавиша скриншота" Margin="0,0,0,3"/>
                                    <TextBlock Grid.Row="0" Grid.Column="2" FontSize="11"
                                               Foreground="{StaticResource InlineDescriptionBrush}"
                                               Text="Подпапки" Margin="0,0,0,3"/>
                                    <TextBox Grid.Row="1" Grid.Column="0" x:Name="HotkeyBox" x:FieldModifier="internal"
                                             PlaceholderText="Нажмите клавишу..." IsReadOnly="True" FontSize="12"
                                             VerticalContentAlignment="Center"
                                             Background="{StaticResource SurfaceInputBrush}"
                                             Foreground="{StaticResource TextSecondaryBrush}"
                                             BorderBrush="{StaticResource BorderSubtleBrush}"
                                             PreviewKeyDown="HotkeyBox_PreviewKeyDown"/>
                                    <Grid Grid.Row="1" Grid.Column="1" ColumnSpacing="4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" x:Name="ScreenshotHotkeyBox" x:FieldModifier="internal"
                                                 PlaceholderText="Нажмите клавишу..." IsReadOnly="True" FontSize="12"
                                                 VerticalContentAlignment="Center"
                                                 Background="{StaticResource SurfaceInputBrush}"
                                                 Foreground="{StaticResource TextSecondaryBrush}"
                                                 BorderBrush="{StaticResource BorderSubtleBrush}"
                                                 ToolTipService.ToolTip="Нажмите клавишу, чтобы назначить её, или Backspace, чтобы очистить."
                                                 PreviewKeyDown="ScreenshotHotkeyBox_PreviewKeyDown"/>
                                        <Button Grid.Column="1" Content="↺" Click="ResetScreenshotHotkey_Click"
                                                ToolTipService.ToolTip="Вернуть Print Screen"
                                                Background="Transparent" BorderThickness="0"
                                                Padding="6,4" MinWidth="0" MinHeight="0" FontSize="14"
                                                Foreground="{StaticResource TextTertiaryBrush}"
                                                VerticalAlignment="Center"/>
                                    </Grid>
                                    <ComboBox Grid.Row="1" Grid.Column="2" x:Name="PerGameScreenshotCombo" x:FieldModifier="internal"
                                              FontSize="12" MinWidth="60"
                                              ToolTipService.ToolTip="Вкл — у каждой игры своя подпапка для скриншотов."
                                              SelectionChanged="PerGameScreenshotCombo_SelectionChanged">
                                        <ComboBoxItem Content="Off"/>
                                        <ComboBoxItem Content="On"/>
                                    </ComboBox>
                                </Grid>

                                <!-- Row 2 Right: Apply to All Games (nits) -->
                                <Button Grid.Row="2" Grid.Column="2" x:Name="ApplyScreenshotPathBtn"
                                        Content="Применить ко всем играм"
                                        Click="ApplyPeakNitsToAll_Click"
                                        Background="{StaticResource AccentBlueBgBrush}"
                                        Foreground="{StaticResource AccentBlueBrush}"
                                        BorderBrush="{StaticResource AccentBlueBorderBrush}" BorderThickness="1"
                                        CornerRadius="8" Padding="12,7" FontSize="12"
                                        HorizontalAlignment="Stretch"/>
                                <!-- Row 4 Right: HDR Auto-Toggle + Select Monitors -->
                                <Grid Grid.Row="4" Grid.Column="2" ColumnSpacing="6" VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Автопереключение HDR" FontSize="12"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               VerticalAlignment="Center"/>
                                    <ComboBox Grid.Column="1" x:Name="HdrAutoToggleCombo" x:FieldModifier="internal"
                                              FontSize="12" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                              ToolTipService.ToolTip="Вкл — Windows HDR автоматически включается при запуске игры через RHI и выключается при выходе из игры"
                                              SelectionChanged="HdrAutoToggleCombo_SelectionChanged">
                                        <ComboBoxItem Content="Off"/>
                                        <ComboBoxItem Content="On"/>
                                    </ComboBox>
                                    <Button Grid.Column="2" Content="⚙" Click="HdrSelectMonitors_Click"
                                            Background="{StaticResource SurfaceOverlayBrush}"
                                            Foreground="{StaticResource ChipTextBrush}"
                                            BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1"
                                            CornerRadius="6" Padding="8,4" MinWidth="0" MinHeight="0"
                                            FontSize="12" VerticalAlignment="Center"
                                            ToolTipService.ToolTip="Выберите мониторы, на которых включать HDR. Пусто — только основной дисплей."/>
                                </Grid>

                                <!-- Row 3 Left: Effect list style -->
                                <Grid Grid.Row="3" Grid.Column="0" ColumnSpacing="8" VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Стиль списка эффектов" FontSize="12"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               VerticalAlignment="Center"/>
                                    <ComboBox Grid.Column="1" x:Name="RsVariableListUseTabsCombo" x:FieldModifier="internal"
                                              FontSize="12" HorizontalAlignment="Stretch"
                                              ToolTipService.ToolTip="Управляет отображением шейдеров в оверлее ReShade. «Вкладки» группируют файлы эффектов по именным вкладкам; «Дерево» показывает сворачиваемую иерархию."
                                              SelectionChanged="RsVariableListUseTabsCombo_SelectionChanged">
                                        <ComboBoxItem Content="Вкладки"/>
                                        <ComboBoxItem Content="Дерево"/>
                                    </ComboBox>
                                </Grid>

                                <!-- Row 4: Apply buttons -->
                                <Button Grid.Row="4" Grid.Column="0" x:Name="ApplyHotkeyBtn" x:FieldModifier="internal"
                                        Content="Применить ко всем играм"
                                        Click="ApplyScreenshotPath_Click"
                                        Background="{StaticResource AccentBlueBgBrush}"
                                        Foreground="{StaticResource AccentBlueBrush}"
                                        BorderBrush="{StaticResource AccentBlueBorderBrush}" BorderThickness="1"
                                        CornerRadius="8" Padding="12,7" FontSize="12"
                                        HorizontalAlignment="Stretch"/>
                            </Grid>
                            </StackPanel>
                        </Border>

                        <!-- ══════════════════════════════════════════════════════════
                             CARD 2b: RESOLUTION CONTROL (dev-only — hidden by DevUnlockService)
                             ══════════════════════════════════════════════════════════ -->
                        <Border x:Name="ResolutionControlCard" x:FieldModifier="internal"
                                Visibility="Collapsed"
                                Background="{StaticResource SurfaceRaisedBrush}" CornerRadius="10" Padding="20,16"
                                BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
                            <StackPanel Spacing="12">
                                <TextBlock Text="Управление разрешением и цветом" FontSize="15" FontWeight="Bold"
                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                                <Grid ColumnSpacing="0" RowSpacing="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="25"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Left: Target Resolution + Auto-Toggle stacked -->
                                    <StackPanel Grid.Column="0" Spacing="12">
                                        <!-- Target Resolution -->
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="Целевое разрешение" FontSize="14" FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                                            <TextBlock TextWrapping="Wrap" FontSize="11"
                                                       Foreground="{StaticResource InlineDescriptionBrush}" LineHeight="18"
                                                       Text="Разрешение рабочего стола, переключаемое перед запуском игры. Восстанавливается при выходе из игры."/>
                                            <ComboBox x:Name="ResolutionTargetCombo" x:FieldModifier="internal"
                                                      FontSize="12" HorizontalAlignment="Stretch"
                                                      ToolTipService.ToolTip="Выберите целевое разрешение рабочего стола."
                                                      SelectionChanged="ResolutionTargetCombo_SelectionChanged"/>
                                        </StackPanel>

                                        <!-- Resolution Auto-Toggle -->
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="Автопереключение разрешения" FontSize="14" FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                                            <TextBlock TextWrapping="Wrap" FontSize="11"
                                                       Foreground="{StaticResource InlineDescriptionBrush}" LineHeight="18"
                                                       Text="Вкл — при запуске игры переключается на целевое разрешение и возвращает его при выходе."/>
                                            <Grid ColumnSpacing="6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="Автопереключение разрешения" FontSize="12"
                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                           VerticalAlignment="Center"/>
                                                <ComboBox Grid.Column="1" x:Name="ResAutoToggleCombo" x:FieldModifier="internal"
                                                          FontSize="12" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                                          SelectionChanged="ResAutoToggleCombo_SelectionChanged">
                                                    <ComboBoxItem Content="Off"/>
                                                    <ComboBoxItem Content="On"/>
                                                </ComboBox>
                                                <Button Grid.Column="2" Content="⚙" Click="ResSelectMonitors_Click"
                                                        Background="{StaticResource SurfaceOverlayBrush}"
                                                        Foreground="{StaticResource ChipTextBrush}"
                                                        BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1"
                                                        CornerRadius="6" Padding="8,4" MinWidth="0" MinHeight="0"
                                                        FontSize="12" VerticalAlignment="Center"
                                                        ToolTipService.ToolTip="Выберите мониторы, у которых менять разрешение."/>
                                            </Grid>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Divider -->
                                    <Border Grid.Column="1" Width="1"
                                            Background="{StaticResource BorderDefaultBrush}"
                                            VerticalAlignment="Stretch" Margin="12,0,12,0"/>

                                    <!-- Right: Output Colour Settings -->
                                    <StackPanel Grid.Column="2" Spacing="12">
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="Настройки вывода цвета" FontSize="14" FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                                            <TextBlock TextWrapping="Wrap" FontSize="11"
                                                       Foreground="{StaticResource InlineDescriptionBrush}" LineHeight="18"
                                                       Text="Меняйте глубину цвета и динамический диапазон дисплея без Панели управления NVIDIA."/>
                                        </StackPanel>

                                        <!-- Display selector -->
                                        <ComboBox x:Name="ColorDisplayCombo" x:FieldModifier="internal"
                                                  FontSize="12" HorizontalAlignment="Stretch"
                                                  ToolTipService.ToolTip="Выберите настраиваемый дисплей."
                                                  SelectionChanged="ColorDisplayCombo_SelectionChanged"/>

                                        <!-- Colour Depth + Dynamic Range + Apply -->
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Spacing="4">
                                                <TextBlock Text="Глубина цвета" FontSize="11"
                                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                                                <ComboBox x:Name="ColorDepthCombo" x:FieldModifier="internal"
                                                          FontSize="12" HorizontalAlignment="Stretch">
                                                    <ComboBoxItem Content="8 bpc"/>
                                                    <ComboBoxItem Content="10 bpc"/>
                                                    <ComboBoxItem Content="12 bpc"/>
                                                </ComboBox>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Spacing="4">
                                                <TextBlock Text="Динамический диапазон" FontSize="11"
                                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                                                <ComboBox x:Name="ColorRangeCombo" x:FieldModifier="internal"
                                                          FontSize="12" HorizontalAlignment="Stretch">
                                                    <ComboBoxItem Content="Full"/>
                                                    <ComboBoxItem Content="Limited"/>
                                                </ComboBox>
                                            </StackPanel>
                                            <Button Grid.Column="2" Content="Применить"
                                                    x:Name="ColorApplyBtn" x:FieldModifier="internal"
                                                    Click="ColorApplyBtn_Click"
                                                    Background="{StaticResource AccentBlueBgBrush}"
                                                    Foreground="{StaticResource AccentBlueBrush}"
                                                    BorderBrush="{StaticResource AccentBlueBorderBrush}"
                                                    BorderThickness="1" CornerRadius="6"
                                                    Padding="12,6" MinWidth="0" MinHeight="0"
                                                    FontSize="12" VerticalAlignment="Bottom"/>
                                        </Grid>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- ══════════════════════════════════════════════════════════
                             CARD 2c: NEXUS MODS (dev-only — hidden by DevUnlockService)
                             ══════════════════════════════════════════════════════════ -->
                        <Border x:Name="NexusModsCard" x:FieldModifier="internal"
                                Visibility="Collapsed"
                                Background="{StaticResource SurfaceRaisedBrush}" CornerRadius="10" Padding="20,16"
                                BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
                            <StackPanel Spacing="12">
                                <TextBlock Text="Nexus Mods" FontSize="15" FontWeight="Bold"
                                           Foreground="{StaticResource TextPrimaryBrush}"/>

                                <Grid ColumnSpacing="0" RowSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="25"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Left description -->
                                    <StackPanel Grid.Row="0" Grid.Column="0" Spacing="4">
                                        <TextBlock Text="API-ключ" FontSize="14" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <TextBlock TextWrapping="Wrap" FontSize="11"
                                                   Foreground="{StaticResource InlineDescriptionBrush}" LineHeight="18"
                                                   Text="Вставьте личный API-ключ Nexus Mods. Премиум-пользователям — скачивание в один клик и тихие автообновления. Остальным — скачивание в один клик через браузер."/>
                                    </StackPanel>

                                    <!-- Divider -->
                                    <Border Grid.Row="0" Grid.RowSpan="3" Grid.Column="1" Width="1"
                                            Background="{StaticResource BorderDefaultBrush}"
                                            VerticalAlignment="Stretch" Margin="12,0,12,0"/>

                                    <!-- Right: connection status + NXM toggle -->
                                    <StackPanel Grid.Row="0" Grid.Column="2" Spacing="4">
                                        <TextBlock Text="Обработчик протокола NXM" FontSize="14" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <TextBlock TextWrapping="Wrap" FontSize="11"
                                                   Foreground="{StaticResource InlineDescriptionBrush}" LineHeight="18"
                                                   Text="Зарегистрировать RHI как обработчик nxm://, чтобы кнопки «Mod Manager Download» на Nexus открывались прямо в RHI."/>
                                    </StackPanel>

                                    <!-- Row 1 Left: API key input + Connect/Disconnect buttons -->
                                    <StackPanel Grid.Row="1" Grid.Column="0" Spacing="6">
                                        <Grid ColumnSpacing="6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Button x:Name="NexusConnectBtn" x:FieldModifier="internal"
                                                    Grid.Column="0"
                                                    Content="Подключить"
                                                    Click="NexusConnectBtn_Click"
                                                    Background="{StaticResource AccentGreenBrush}"
                                                    Foreground="White"
                                                    BorderThickness="0"
                                                    CornerRadius="6" Padding="12,6" MinWidth="0"
                                                    FontSize="12" VerticalAlignment="Center"
                                                    HorizontalAlignment="Left"/>
                                        </Grid>
                                        <TextBlock x:Name="NexusStatusText" x:FieldModifier="internal"
                                                   FontSize="11" TextWrapping="Wrap"
                                                   Foreground="{StaticResource TextTertiaryBrush}"
                                                   Text="Не подключено"/>
                                    </StackPanel>

                                    <!-- Row 1 Right: NXM handler register/unregister -->
                                    <StackPanel Grid.Row="1" Grid.Column="2" Spacing="6">
                                        <Grid ColumnSpacing="6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Name="NxmStatusText" x:FieldModifier="internal"
                                                       Grid.Column="0"
                                                       FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       Text="Не зарегистрировано"/>
                                            <Button x:Name="NxmRegisterBtn" x:FieldModifier="internal"
                                                    Grid.Column="1"
                                                    Content="Зарегистрировать"
                                                    Click="NxmRegisterBtn_Click"
                                                    Background="{StaticResource SurfaceOverlayBrush}"
                                                    Foreground="{StaticResource ChipTextBrush}"
                                                    BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1"
                                                    CornerRadius="6" Padding="12,6" MinWidth="0"
                                                    FontSize="12" VerticalAlignment="Center"/>
                                        </Grid>
                                    </StackPanel>

                                    <!-- Row 2: Disconnect row (shown only when connected) -->
                                    <StackPanel Grid.Row="2" Grid.Column="0" Spacing="4" x:Name="NexusDisconnectRow" x:FieldModifier="internal" Visibility="Collapsed">
                                        <Button Content="Отключить"
                                                Click="NexusDisconnectBtn_Click"
                                                Background="Transparent"
                                                Foreground="{StaticResource AccentRedBrush}"
                                                BorderBrush="{StaticResource AccentRedBrush}" BorderThickness="1"
                                                CornerRadius="6" Padding="12,4" MinWidth="0"
                                                FontSize="11" HorizontalAlignment="Left"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- ══════════════════════════════════════════════════════════
                             CARD 2d: RENODX DATA SOURCE (dev-only — hidden by DevUnlockService)
                             ══════════════════════════════════════════════════════════ -->
                        <Border x:Name="RenoDxDbSourceCard" x:FieldModifier="internal"
                                Visibility="Collapsed"
                                Background="{StaticResource SurfaceRaisedBrush}" CornerRadius="10" Padding="20,16"
                                BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
                            <StackPanel Spacing="12">
                                <TextBlock Text="Источник данных RenoDX" FontSize="15" FontWeight="Bold"
                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock TextWrapping="Wrap" FontSize="11"
                                           Foreground="{StaticResource InlineDescriptionBrush}" LineHeight="18"
                                           Text="Определяет источник данных о модах. База RHI использует поддерживаемое сообществом хранилище RHI (рекомендуется). Вики RenoDX обращается к скраперу вики RenoDX. При изменении настройки список сразу обновится."/>
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Исходный код" FontSize="13"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               VerticalAlignment="Center"/>
                                    <ComboBox x:Name="RenoDxDbSourceCombo" x:FieldModifier="internal"
                                              Grid.Column="1" FontSize="12"
                                              HorizontalAlignment="Left" MinWidth="160">
                                        <ComboBoxItem Content="База RHI" Tag="DbOnly"/>
                                        <ComboBoxItem Content="Вики RenoDX" Tag="WikiOnly"/>
                                    </ComboBox>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- ══════════════════════════════════════════════════════════
                             CARD 3: DLSS & STREAMLINE
                             ══════════════════════════════════════════════════════════ -->
                        <Border Background="{StaticResource SurfaceRaisedBrush}" CornerRadius="10" Padding="20,16"
                                BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
                            <StackPanel Spacing="12">
                            <TextBlock Text="Настройки DLSS / Streamline" FontSize="15" FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                            <Grid ColumnSpacing="0" RowSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Left: Defaults + DMFG Defaults + Batch Deploy -->
                                <Grid Grid.Column="0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <StackPanel Grid.Row="0" Spacing="8">
                                        <TextBlock Text="По умолчанию" FontSize="14" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <TextBlock TextWrapping="Wrap" FontSize="11"
                                                   Foreground="{StaticResource InlineDescriptionBrush}" LineHeight="18"
                                                   Text="Настройте предпочитаемые версии, пресеты и масштабы рендеринга DLSS/Streamline. Кнопка «Быстрое применение» в разделе профиля NVIDIA применит их к любой игре."/>
                                        <Button Content="Настроить значения по умолчанию" Click="DlssDefaults_Click"
                                                Background="{StaticResource AccentBlueBgBrush}"
                                                Foreground="{StaticResource AccentBlueBrush}"
                                                BorderBrush="{StaticResource AccentBlueBorderBrush}" BorderThickness="1"
                                                CornerRadius="8" Padding="12,7" FontSize="12"
                                                HorizontalAlignment="Stretch"/>
                                        <StackPanel x:Name="DlssDefaultsSummaryPanel" x:FieldModifier="internal" Spacing="4" Margin="0,4,0,0"/>
                                    </StackPanel>

                                    <!-- DMFG Defaults (global base profile) -->
                                    <StackPanel Grid.Row="1" Spacing="8" Margin="0,16,0,0">
                                        <TextBlock Text="DMFG по умолчанию" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <TextBlock TextWrapping="Wrap" FontSize="11"
                                                   Foreground="{StaticResource InlineDescriptionBrush}" LineHeight="18"
                                                   Text="Общие настройки динамической мульти-генерации кадров. Задайте один раз — затем просто включайте динамический режим в диалоге MFG каждой игры."/>
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Spacing="4">
                                                <TextBlock Text="Количество кадров" FontSize="11" Foreground="{StaticResource InlineDescriptionBrush}"/>
                                                <ComboBox x:Name="DmfgFrameCountCombo" x:FieldModifier="internal"
                                                          FontSize="12" HorizontalAlignment="Stretch"
                                                          ToolTipService.ToolTip="Общее максимальное количество кадров DMFG. Игры в динамическом режиме наследуют его, если не задано своё."
                                                          SelectionChanged="DmfgFrameCountCombo_SelectionChanged"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Spacing="4">
                                                <TextBlock Text="Целевой FPS" FontSize="11" Foreground="{StaticResource InlineDescriptionBrush}"/>
                                                <ComboBox x:Name="DmfgTargetFpsCombo" x:FieldModifier="internal"
                                                          FontSize="12" HorizontalAlignment="Stretch"
                                                          ToolTipService.ToolTip="Общая целевая частота кадров DMFG. Выкл — без цели. Max Refresh Rate — по дисплею. Либо конкретный FPS."
                                                          SelectionChanged="DmfgTargetFpsCombo_SelectionChanged"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>

                                    <StackPanel Grid.Row="2" Spacing="8" Margin="0,16,0,0">
                                        <TextBlock Text="Массовое развертывание" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <TextBlock TextWrapping="Wrap" FontSize="11"
                                                   Foreground="{StaticResource InlineDescriptionBrush}" LineHeight="18"
                                                   Text="Развернуть версии DLL DLSS и Streamline, а также пресеты DLSS сразу в нескольких играх. Оригиналы автоматически резервируются. Поля заранее заполнены вашими значениями по умолчанию."/>
                                        <Button Content="Массовое развертывание" Click="MassDlssDeploy_Click"
                                                Background="{StaticResource AccentBlueBgBrush}"
                                                Foreground="{StaticResource AccentBlueBrush}"
                                                BorderBrush="{StaticResource AccentBlueBorderBrush}" BorderThickness="1"
                                                CornerRadius="8" Padding="12,7" FontSize="12"
                                                HorizontalAlignment="Stretch"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Divider -->
                                <Border Grid.Column="1" Width="1"
                                        Background="{StaticResource BorderSubtleBrush}" Margin="16,0"/>

                                <!-- Right: DLSS & G-Sync Indicators + Auto-Update -->
                                <StackPanel Grid.Column="2" Spacing="8">
                                    <TextBlock Text="Экранный индикатор DLSS" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <TextBlock TextWrapping="Wrap" FontSize="11"
                                               Foreground="{StaticResource InlineDescriptionBrush}" LineHeight="18"
                                               Text="Управляет текстовым индикатором DLSS, который драйвер NVIDIA показывает в углу игр. Общесистемная настройка — влияет на все игры. Требуются права администратора."/>
                                    <ComboBox x:Name="DlssIndicatorCombo" x:FieldModifier="internal"
                                              FontSize="12" HorizontalAlignment="Stretch"
                                              SelectionChanged="DlssIndicatorCombo_SelectionChanged">
                                        <ComboBoxItem Content="Включено"/>
                                        <ComboBoxItem Content="Отключено"/>
                                    </ComboBox>

                                    <TextBlock Text="Экранный индикатор G-Sync" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}" Margin="0,8,0,0"/>
                                    <ComboBox x:Name="GSyncIndicatorCombo" x:FieldModifier="internal"
                                              FontSize="12" HorizontalAlignment="Stretch"
                                              SelectionChanged="GSyncIndicatorCombo_SelectionChanged">
                                        <ComboBoxItem Content="Включено"/>
                                        <ComboBoxItem Content="Отключено"/>
                                    </ComboBox>

                                    <TextBlock Text="Автообновление" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}" Margin="0,8,0,0"/>
                                    <TextBlock TextWrapping="Wrap" FontSize="11"
                                               Foreground="{StaticResource InlineDescriptionBrush}" LineHeight="18"
                                               Text="Автоматически переключаться на новейшую версию при выходе нового релиза. Касается только игр с последней версией — вручную выбранные старые версии не трогаются."/>
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Spacing="4">
                                            <TextBlock Text="DLSS" FontSize="11" Foreground="{StaticResource InlineDescriptionBrush}"/>
                                            <ComboBox x:Name="AutoUpdateDlssCombo" x:FieldModifier="internal"
                                                      FontSize="12" HorizontalAlignment="Stretch"
                                                      SelectionChanged="AutoUpdateDlssCombo_SelectionChanged">
                                                <ComboBoxItem Content="Off"/>
                                                <ComboBoxItem Content="On"/>
                                            </ComboBox>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="4">
                                            <TextBlock Text="Streamline" FontSize="11" Foreground="{StaticResource InlineDescriptionBrush}"/>
                                            <ComboBox x:Name="AutoUpdateStreamlineCombo" x:FieldModifier="internal"
                                                      FontSize="12" HorizontalAlignment="Stretch"
                                                      SelectionChanged="AutoUpdateStreamlineCombo_SelectionChanged">
                                                <ComboBoxItem Content="Off"/>
                                                <ComboBoxItem Content="On"/>
                                            </ComboBox>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Grid>
                            </StackPanel>
                        </Border>

                        <!-- ══════════════════════════════════════════════════════════
                             CARD 4: GLOBAL NVIDIA DRIVER SETTINGS
                             ══════════════════════════════════════════════════════════ -->
                        <Border Background="{StaticResource SurfaceRaisedBrush}" CornerRadius="10" Padding="20,16"
                                BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
                            <StackPanel Spacing="12">
                            <TextBlock Text="Глобальные настройки драйвера NVIDIA" FontSize="15" FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                            <Grid ColumnSpacing="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="25"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Left column -->
                                <StackPanel Grid.Column="0" Spacing="12" VerticalAlignment="Top">
                                    <TextBlock TextWrapping="Wrap" FontSize="11"
                                               Foreground="{StaticResource InlineDescriptionBrush}" LineHeight="18"
                                               Text="Драйверные настройки, применяемые глобально через базовый профиль NVIDIA. Настройки для отдельных игр находятся в разделе «Профиль NVIDIA» на панели переопределений каждой игры."/>

                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Spacing="4">
                                            <TextBlock Text="Размер кеша шейдеров" FontSize="11" Foreground="{StaticResource InlineDescriptionBrush}"/>
                                            <ComboBox x:Name="ShaderCacheSizeCombo" x:FieldModifier="internal"
                                                      FontSize="12" HorizontalAlignment="Stretch"
                                                      ToolTipService.ToolTip="Максимум места на диске для кеша скомпилированных шейдеров. Больше — меньше фризов при повторных посещениях. 16 ГБ — значение драйвера по умолчанию."
                                                      SelectionChanged="ShaderCacheSizeCombo_SelectionChanged"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="4">
                                            <TextBlock Text="Предварительная компиляция шейдеров" FontSize="11" Foreground="{StaticResource InlineDescriptionBrush}"/>
                                            <ComboBox x:Name="ShaderPrecompileCombo" x:FieldModifier="internal"
                                                      FontSize="12" HorizontalAlignment="Stretch"
                                                      ToolTipService.ToolTip="Компилирует шейдеры в фоне во время простоя. Выше значение — больше нагрузки на CPU в простое, но быстрее первая загрузка игр."
                                                      SelectionChanged="ShaderPrecompileCombo_SelectionChanged"/>
                                        </StackPanel>
                                    </Grid>

                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Spacing="4">
                                            <TextBlock Text="G-Sync" FontSize="11" Foreground="{StaticResource InlineDescriptionBrush}"/>
                                            <ComboBox x:Name="GSyncEnableCombo" x:FieldModifier="internal"
                                                      FontSize="12" HorizontalAlignment="Stretch"
                                                      ToolTipService.ToolTip="Глобально включает или отключает адаптивную синхронизацию G-Sync/FreeSync."
                                                      SelectionChanged="GSyncEnableCombo_SelectionChanged"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="4">
                                            <TextBlock Text="Режим G-Sync" FontSize="11" Foreground="{StaticResource InlineDescriptionBrush}"/>
                                            <ComboBox x:Name="GSyncModeCombo" x:FieldModifier="internal"
                                                      FontSize="12" HorizontalAlignment="Stretch"
                                                      ToolTipService.ToolTip="Управляет адаптивной синхронизацией G-Sync/FreeSync. Рекомендуются режимы «Полноэкранный» и «Оконный» для бесшовной работы."
                                                      SelectionChanged="GSyncModeCombo_SelectionChanged"/>
                                        </StackPanel>
                                    </Grid>

                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Spacing="4">
                                            <TextBlock Text="Лимит FPS" FontSize="11" Foreground="{StaticResource InlineDescriptionBrush}"/>
                                            <ComboBox x:Name="FpsLimitCombo" x:FieldModifier="internal"
                                                      FontSize="12" HorizontalAlignment="Stretch"
                                                      ToolTipService.ToolTip="Общий лимит FPS через драйвер NVIDIA. Оптимальные для VRR пресеты ставят лимит чуть ниже частоты обновления, чтобы оставаться в диапазоне VRR."
                                                      SelectionChanged="FpsLimitCombo_SelectionChanged"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="4">
                                            <TextBlock Text="Предпочитаемая частота обновления" FontSize="11" Foreground="{StaticResource InlineDescriptionBrush}"/>
                                            <ComboBox x:Name="PreferredRefreshRateCombo" x:FieldModifier="internal"
                                                      FontSize="12" HorizontalAlignment="Stretch"
                                                      ToolTipService.ToolTip="«Наивысшая доступная» принудительно ставит максимальную частоту обновления. «Настройка игры» позволяет играм выбирать свою."
                                                      SelectionChanged="PreferredRefreshRateCombo_SelectionChanged"/>
                                        </StackPanel>
                                    </Grid>

                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Spacing="4">
                                            <TextBlock Text="VSync" FontSize="11" Foreground="{StaticResource InlineDescriptionBrush}"/>
                                            <ComboBox x:Name="GlobalVSyncCombo" x:FieldModifier="internal"
                                                      FontSize="12" HorizontalAlignment="Stretch"
                                                      ToolTipService.ToolTip="Общий режим VSync — действует для всех игр без индивидуального переопределения."
                                                      SelectionChanged="GlobalVSyncCombo_SelectionChanged"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="4">
                                            <TextBlock Text="Режим питания" FontSize="11" Foreground="{StaticResource InlineDescriptionBrush}"/>
                                            <ComboBox x:Name="GlobalPowerModeCombo" x:FieldModifier="internal"
                                                      FontSize="12" HorizontalAlignment="Stretch"
                                                      ToolTipService.ToolTip="Общий режим управления питанием — действует для всех игр без индивидуального переопределения."
                                                      SelectionChanged="GlobalPowerModeCombo_SelectionChanged"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- ReBAR row -->
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Spacing="4">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <TextBlock Text="ReBAR" FontSize="11" Foreground="{StaticResource InlineDescriptionBrush}"/>
                                                <TextBlock x:Name="ReBarAdminWarning" x:FieldModifier="internal"
                                                           Text="— Требуется администратор" FontSize="11"
                                                           Foreground="{StaticResource AccentAmberBrush}"
                                                           Visibility="Collapsed"/>
                                            </StackPanel>
                                            <ComboBox x:Name="GlobalReBarEnableCombo" x:FieldModifier="internal"
                                                      FontSize="12" HorizontalAlignment="Stretch"
                                                      ToolTipService.ToolTip="Глобальный Resizable BAR — разрешает крупные передачи памяти GPU для всех игр. Требуются права администратора и совместимое железо (RTX 30-й серии и новее)."
                                                      SelectionChanged="GlobalReBarEnableCombo_SelectionChanged"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="4">
                                            <TextBlock Text="Лимит размера ReBAR" FontSize="11" Foreground="{StaticResource InlineDescriptionBrush}"/>
                                            <ComboBox x:Name="GlobalReBarSizeCombo" x:FieldModifier="internal"
                                                      FontSize="12" HorizontalAlignment="Stretch"
                                                      ToolTipService.ToolTip="Максимальный размер передачи BAR. 1 ГБ оптимален для большинства игр. Уменьшите до 512 МБ, если возникают фризы, связанные с ReBAR."
                                                      SelectionChanged="GlobalReBarSizeCombo_SelectionChanged"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>

                                <!-- Divider -->
                                <Border Grid.Column="1" Width="1"
                                        Background="{StaticResource BorderDefaultBrush}"
                                        VerticalAlignment="Stretch" Margin="12,0,12,0"/>

                                <!-- Right column -->
                                <StackPanel Grid.Column="2" Spacing="12" VerticalAlignment="Top">
                                    <TextBlock TextWrapping="Wrap" FontSize="11"
                                               Foreground="{StaticResource InlineDescriptionBrush}" LineHeight="18"
                                               Text="Настройка цифровой насыщенности NVIDIA (Digital Vibrance) для каждого дисплея. Сохранённые значения автоматически восстанавливаются при запуске приложения."/>
                                    <Button Content="Digital Vibrance"
                                            Click="DigitalVibrance_Click"
                                            ToolTipService.ToolTip="Настройка Digital Vibrance (насыщенности цвета) для каждого дисплея. Сохранённые значения восстанавливаются при запуске приложения."
                                            Background="{StaticResource AccentBlueBgBrush}"
                                            Foreground="{StaticResource AccentBlueBrush}"
                                            BorderBrush="{StaticResource AccentBlueBorderBrush}" BorderThickness="1"
                                            CornerRadius="8" Padding="12,7" FontSize="12"
                                            HorizontalAlignment="Stretch"/>

                                    <!-- Create Missing Profiles -->
                                    <TextBlock TextWrapping="Wrap" FontSize="11" Margin="0,8,0,0"
                                               Foreground="{StaticResource InlineDescriptionBrush}" LineHeight="18"
                                               Text="Игры без профиля NVIDIA не получают общие драйверные настройки. Создайте профили для всех игр в библиотеке, чтобы общие настройки применялись везде."/>
                                    <Button Content="Создать отсутствующие профили"
                                            Click="CreateMissingNvidiaProfiles_Click"
                                            ToolTipService.ToolTip="Создаёт профили драйвера NVIDIA для всех игр, у которых их ещё нет. Гарантирует, что общие настройки вроде режима питания и VSync действуют для каждой игры."
                                            Background="{StaticResource AccentBlueBgBrush}"
                                            Foreground="{StaticResource AccentBlueBrush}"
                                            BorderBrush="{StaticResource AccentBlueBorderBrush}" BorderThickness="1"
                                            CornerRadius="8" Padding="12,7" FontSize="12"
                                            HorizontalAlignment="Stretch"/>

                                    <TextBlock Text="Резервная копия сохраняет все индивидуальные настройки драйвера NVIDIA в файл. Восстановление загружает их обратно — полезно перед обновлением драйверов."
                                               TextWrapping="Wrap" FontSize="11"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               Margin="0,8,0,0"/>
                                    <Grid ColumnSpacing="12" Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Content="Резервные копии профилей"
                                                Click="ExportNvidiaProfiles_Click"
                                                ToolTipService.ToolTip="Сохранить все настройки профилей NVIDIA в резервный файл."
                                                Background="{StaticResource AccentBlueBgBrush}"
                                                Foreground="{StaticResource AccentBlueBrush}"
                                                BorderBrush="{StaticResource AccentBlueBorderBrush}" BorderThickness="1"
                                                CornerRadius="8" Padding="12,7" FontSize="12"
                                                HorizontalAlignment="Stretch"/>
                                        <Button Grid.Column="1" Content="Восстановить профили"
                                                Click="ImportNvidiaProfiles_Click"
                                                ToolTipService.ToolTip="Восстановить настройки профилей NVIDIA из ранее созданной резервной копии."
                                                Background="{StaticResource AccentBlueBgBrush}"
                                                Foreground="{StaticResource AccentBlueBrush}"
                                                BorderBrush="{StaticResource AccentBlueBorderBrush}" BorderThickness="1"
                                                CornerRadius="8" Padding="12,7" FontSize="12"
                                                HorizontalAlignment="Stretch"/>
                                    </Grid>

                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Content="Сбросить профили NVIDIA"
                                                Click="ResetAllNvidiaProfiles_Click"
                                                ToolTipService.ToolTip="Удаляет ВСЕ переопределения профилей NVIDIA для игр. Глобальный профиль станет как новый."
                                                Background="{StaticResource AccentBlueBgBrush}"
                                                Foreground="{StaticResource AccentBlueBrush}"
                                                BorderBrush="#CC4444" BorderThickness="1"
                                                CornerRadius="8" Padding="12,7" FontSize="12"
                                                HorizontalAlignment="Stretch"/>
                                        <Button Grid.Column="1" Content="Очистить кеш шейдеров"
                                                Click="ClearNvidiaShaderCache_Click"
                                                ToolTipService.ToolTip="Удаляет папки DXCache и GLCache NVIDIA. Шейдеры будут перекомпилированы при следующем запуске."
                                                Background="{StaticResource AccentBlueBgBrush}"
                                                Foreground="{StaticResource AccentBlueBrush}"
                                                BorderBrush="#CC4444" BorderThickness="1"
                                                CornerRadius="8" Padding="12,7" FontSize="12"
                                                HorizontalAlignment="Stretch"/>
                                    </Grid>
                                </StackPanel>
                            </Grid>
                            </StackPanel>
                        </Border>

                        <!-- ══════════════════════════════════════════════════════════
                             CARD 5: COMPONENT SETTINGS (ReLimiter + OptiScaler)
                             ══════════════════════════════════════════════════════════ -->
                        <Border Background="{StaticResource SurfaceRaisedBrush}" CornerRadius="10" Padding="20,16"
                                BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
                            <StackPanel Spacing="12">
                            <TextBlock Text="Настройки компонентов" FontSize="15" FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                            <Grid ColumnSpacing="0" RowSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="25"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Left: ReLimiter -->
                                <StackPanel Grid.Row="0" Grid.Column="0" Spacing="4">
                                    <TextBlock Text="ReLimiter" FontSize="14" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <TextBlock TextWrapping="Wrap" FontSize="11"
                                               Foreground="{StaticResource InlineDescriptionBrush}" LineHeight="18"
                                               Text="Горячая клавиша OSD ReLimiter и общие настройки функций применяются ко всем играм."/>
                                </StackPanel>

                                <!-- Divider -->
                                <Border Grid.Row="0" Grid.RowSpan="3" Grid.Column="1" Width="1"
                                        Background="{StaticResource BorderDefaultBrush}"
                                        VerticalAlignment="Stretch" Margin="12,0,12,0"/>

                                <!-- Right: OptiScaler -->
                                <StackPanel Grid.Row="0" Grid.Column="2" Spacing="4">
                                    <TextBlock Text="OptiScaler" FontSize="14" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <TextBlock TextWrapping="Wrap" FontSize="11"
                                               Foreground="{StaticResource InlineDescriptionBrush}" LineHeight="18"
                                               Text="Тип GPU, настройки DLSS-входа и горячая клавиша оверлея для установок OptiScaler."/>
                                </StackPanel>

                                <!-- Row 1 Left: ReLimiter controls -->
                                <Grid Grid.Row="1" Grid.Column="0" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" FontSize="11"
                                               Foreground="{StaticResource InlineDescriptionBrush}"
                                               Text="Клавиша OSD" VerticalAlignment="Bottom" Margin="0,0,0,4"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1" FontSize="11"
                                               Foreground="{StaticResource InlineDescriptionBrush}"
                                               Text="Общие пресеты" VerticalAlignment="Bottom" Margin="0,0,0,4"/>
                                    <TextBlock Grid.Row="0" Grid.Column="2" FontSize="11"
                                               Foreground="{StaticResource InlineDescriptionBrush}"
                                               Text="Хуки DLSS" VerticalAlignment="Bottom" Margin="0,0,0,4"/>
                                    <TextBlock Grid.Row="0" Grid.Column="3" FontSize="11"
                                               Foreground="{StaticResource InlineDescriptionBrush}"
                                               Text="Целевой FPS" VerticalAlignment="Bottom" Margin="0,0,0,4"/>
                                    <TextBox Grid.Row="1" Grid.Column="0" x:Name="UlHotkeyBox" x:FieldModifier="internal"
                                             PlaceholderText="Нажмите клавишу..." IsReadOnly="True"
                                             FontSize="12" MinWidth="80"
                                             Background="{StaticResource SurfaceInputBrush}"
                                             Foreground="{StaticResource TextSecondaryBrush}"
                                             BorderBrush="{StaticResource BorderSubtleBrush}"
                                             ToolTipService.ToolTip="Клавиша включения оверлея OSD ReLimiter в игре."
                                             PreviewKeyDown="UlHotkeyBox_PreviewKeyDown"/>
                                    <ComboBox Grid.Row="1" Grid.Column="1" x:Name="UlSharedPresetsCombo" x:FieldModifier="internal"
                                              FontSize="12" HorizontalAlignment="Stretch"
                                              ToolTipService.ToolTip="Вкл — все игры используют общий файл пресетов OSD. Выкл — у каждой игры свои пресеты."
                                              SelectionChanged="UlSharedPresetsCombo_SelectionChanged">
                                        <ComboBoxItem Content="Off"/>
                                        <ComboBoxItem Content="On"/>
                                    </ComboBox>
                                    <ComboBox Grid.Row="1" Grid.Column="2" x:Name="UlDlssHooksCombo" x:FieldModifier="internal"
                                              FontSize="12" HorizontalAlignment="Stretch"
                                              ToolTipService.ToolTip="Показывает режим качества DLSS, разрешение рендеринга и активные функции в OSD ReLimiter. Отключите при вылетах."
                                              SelectionChanged="UlDlssHooksCombo_SelectionChanged">
                                        <ComboBoxItem Content="Off"/>
                                        <ComboBoxItem Content="On"/>
                                    </ComboBox>
                                    <ComboBox Grid.Row="1" Grid.Column="3" x:Name="UlTargetFpsCombo" x:FieldModifier="internal"
                                              FontSize="12" HorizontalAlignment="Stretch"
                                              ToolTipService.ToolTip="Общий лимит FPS записывается во все relimiter.ini. Выберите пресет VRR или «Свой» для ручного значения."
                                              SelectionChanged="UlTargetFpsCombo_SelectionChanged">
                                        <!-- Items populated in code-behind -->
                                    </ComboBox>
                                </Grid>

                                <!-- Row 1 Right: OptiScaler controls -->
                                <Grid Grid.Row="1" Grid.Column="2" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <StackPanel Grid.Row="0" Grid.Column="0" Grid.RowSpan="2" Spacing="4">
                                        <TextBlock Text="Тип GPU" FontSize="11" Foreground="{StaticResource InlineDescriptionBrush}"/>
                                        <ComboBox x:Name="OsGpuCombo" x:FieldModifier="internal"
                                                  FontSize="12" HorizontalAlignment="Stretch"
                                                  Background="{StaticResource SurfaceInputBrush}"
                                                  Foreground="{StaticResource TextSecondaryBrush}"
                                                  BorderBrush="{StaticResource BorderSubtleBrush}"
                                                  SelectionChanged="OsGpuCombo_SelectionChanged">
                                            <x:String>NVIDIA</x:String>
                                            <x:String>AMD</x:String>
                                            <x:String>Intel</x:String>
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Grid.Row="0" Grid.Column="1" Grid.RowSpan="2" Spacing="4"
                                                x:Name="OsDlssInputsPanel" x:FieldModifier="internal" Visibility="Collapsed">
                                        <TextBlock Text="Входы DLSS" FontSize="11" Foreground="{StaticResource InlineDescriptionBrush}"/>
                                        <ComboBox x:Name="OsDlssInputsCombo" x:FieldModifier="internal"
                                                  FontSize="12" HorizontalAlignment="Stretch"
                                                  Background="{StaticResource SurfaceInputBrush}"
                                                  Foreground="{StaticResource TextSecondaryBrush}"
                                                  BorderBrush="{StaticResource BorderSubtleBrush}"
                                                  SelectionChanged="OsDlssInputsCombo_SelectionChanged">
                                            <x:String>Да</x:String>
                                            <x:String>Нет</x:String>
                                        </ComboBox>
                                    </StackPanel>
                                </Grid>

                                <!-- Row 2 Left: ReLimiter Apply -->
                                <Button Grid.Row="2" Grid.Column="0" x:Name="ApplyUlHotkeyBtn" x:FieldModifier="internal"
                                        Content="Применить ко всем играм"
                                        Click="ApplyUlOsdHotkey_Click"
                                        Background="{StaticResource AccentBlueBgBrush}"
                                        Foreground="{StaticResource AccentBlueBrush}"
                                        BorderBrush="{StaticResource AccentBlueBorderBrush}" BorderThickness="1"
                                        CornerRadius="8" Padding="12,7" FontSize="12"
                                        HorizontalAlignment="Stretch"/>

                                <!-- Row 2 Right: OptiScaler Hotkey + Apply -->
                                <Grid Grid.Row="2" Grid.Column="2" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <ComboBox Grid.Column="0" x:Name="OsHotkeyCombo" x:FieldModifier="internal"
                                              FontSize="12" HorizontalAlignment="Stretch"
                                              Background="{StaticResource SurfaceInputBrush}"
                                              Foreground="{StaticResource TextSecondaryBrush}"
                                              BorderBrush="{StaticResource BorderSubtleBrush}"
                                              SelectionChanged="OsHotkeyCombo_SelectionChanged">
                                        <x:String>Insert</x:String>
                                        <x:String>Home</x:String>
                                        <x:String>End</x:String>
                                        <x:String>Удалить</x:String>
                                        <x:String>Page Up</x:String>
                                        <x:String>Page Down</x:String>
                                        <x:String>F1</x:String>
                                        <x:String>F2</x:String>
                                        <x:String>F3</x:String>
                                        <x:String>F4</x:String>
                                        <x:String>F5</x:String>
                                        <x:String>F6</x:String>
                                        <x:String>F7</x:String>
                                        <x:String>F8</x:String>
                                        <x:String>F9</x:String>
                                        <x:String>F10</x:String>
                                        <x:String>F11</x:String>
                                        <x:String>F12</x:String>
                                    </ComboBox>
                                    <Button Grid.Column="1" x:Name="ApplyOsHotkeyBtn" x:FieldModifier="internal"
                                            Content="Применить ко всем играм"
                                            Click="ApplyOsHotkey_Click"
                                            Background="{StaticResource AccentBlueBgBrush}"
                                            Foreground="{StaticResource AccentBlueBrush}"
                                            BorderBrush="{StaticResource AccentBlueBorderBrush}" BorderThickness="1"
                                            CornerRadius="8" Padding="12,7" FontSize="12"
                                            HorizontalAlignment="Stretch"/>
                                </Grid>
                            </Grid>
                            </StackPanel>
                        </Border>

                        <!-- ══════════════════════════════════════════════════════════
                             CARD 6: SHADERS & ADDONS
                             ══════════════════════════════════════════════════════════ -->
                        <Border Background="{StaticResource SurfaceRaisedBrush}" CornerRadius="10" Padding="20,16"
                                BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
                            <StackPanel Spacing="12">
                            <TextBlock Text="Шейдеры и аддоны" FontSize="15" FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                            <Grid ColumnSpacing="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="25"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Left: Shader Management + Cache -->
                                <StackPanel Grid.Column="0" Spacing="12">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="Управление шейдерами" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource InlineDescriptionBrush}" LineHeight="18"
                                                   Text="Управление тем, как RHI обращается с файлами шейдеров в ваших играх."/>
                                    </StackPanel>
                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Управление шейдерами" FontSize="11"
                                                   Foreground="{StaticResource InlineDescriptionBrush}" Margin="0,0,0,3"/>
                                        <TextBlock Grid.Row="0" Grid.Column="1" Text="Кешировать все шейдеры" FontSize="11"
                                                   Foreground="{StaticResource InlineDescriptionBrush}" Margin="0,0,0,3"/>
                                        <ComboBox Grid.Row="1" Grid.Column="0" x:Name="CustomShadersCombo" x:FieldModifier="internal"
                                                  FontSize="12" HorizontalAlignment="Stretch"
                                                  ToolTipService.ToolTip="Под управлением RHI: разворачивать встроенные наборы шейдеров во все игры.&amp;#10;Свои: использовать собственный каталог шейдеров.&amp;#10;Выкл: RHI вообще не трогает шейдеры."
                                                  SelectionChanged="CustomShadersCombo_SelectionChanged">
                                            <ComboBoxItem Content="Off"/>
                                            <ComboBoxItem Content="Под управлением RHI"/>
                                            <ComboBoxItem Content="Свой"/>
                                        </ComboBox>
                                        <ComboBox Grid.Row="1" Grid.Column="1" x:Name="CacheAllShadersCombo" x:FieldModifier="internal"
                                                  FontSize="12" HorizontalAlignment="Stretch"
                                                  ToolTipService.ToolTip="Вкл — все наборы шейдеров скачиваются и кешируются при запуске. Выкл — наборы скачиваются по мере необходимости."
                                                  SelectionChanged="CacheAllShadersCombo_SelectionChanged">
                                            <ComboBoxItem Content="Off"/>
                                            <ComboBoxItem Content="On"/>
                                        </ComboBox>
                                    </Grid>
                                </StackPanel>

                                <!-- Divider -->
                                <Border Grid.Column="1" Width="1"
                                        Background="{StaticResource BorderDefaultBrush}"
                                        VerticalAlignment="Stretch" Margin="12,0,12,0"/>

                                <!-- Right: Addon Watch Folder -->
                                <StackPanel Grid.Column="2" Spacing="12">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="Папка наблюдения за аддонами" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource InlineDescriptionBrush}" LineHeight="18"
                                                   Text="RHI следит в этой папке за файлами аддонов RenoDX (.addon64/.addon32) и архивами. По умолчанию — ваша папка загрузок."/>
                                    </StackPanel>
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="AddonWatchFolderBox" x:FieldModifier="internal"
                                                 Grid.Column="0"
                                                 PlaceholderText="Папка загрузок (по умолчанию)"
                                                 FontSize="12"
                                                 Background="{StaticResource SurfaceInputBrush}"
                                                 Foreground="{StaticResource TextSecondaryBrush}"
                                                 BorderBrush="{StaticResource BorderSubtleBrush}"/>
                                        <Button Grid.Column="1" Content="Обзор" Click="BrowseAddonWatchFolder_Click"
                                                Background="{StaticResource AccentBlueBgBrush}" Foreground="{StaticResource AccentBlueBrush}"
                                                BorderBrush="{StaticResource AccentBlueBorderBrush}" BorderThickness="1"
                                                CornerRadius="8" Padding="12,6" FontSize="12"/>
                                        <Button Grid.Column="2" Content="Сбросить" Click="ResetAddonWatchFolder_Click"
                                                Background="{StaticResource SurfaceInputBrush}" Foreground="{StaticResource TextTertiaryBrush}"
                                                BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1"
                                                CornerRadius="8" Padding="12,6" FontSize="12"/>
                                    </Grid>
                                </StackPanel>
                            </Grid>
                            </StackPanel>
                        </Border>

                        <!-- ══════════════════════════════════════════════════════════
                             CARD 7: UPDATE & DEPLOYMENT
                             ══════════════════════════════════════════════════════════ -->
                        <Border Background="{StaticResource SurfaceRaisedBrush}" CornerRadius="10" Padding="20,16"
                                BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
                            <StackPanel Spacing="12">
                            <TextBlock Text="Обновление и развертывание" FontSize="15" FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                            <Grid ColumnSpacing="0" RowSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="25"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Left: Global Update Checks -->
                                <StackPanel Grid.Row="0" Grid.Column="0" Spacing="4">
                                    <TextBlock Text="Глобальная проверка обновлений" FontSize="14" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <TextBlock TextWrapping="Wrap" FontSize="11"
                                               Foreground="{StaticResource InlineDescriptionBrush}" LineHeight="18"
                                               Text="Отключите проверку обновлений для отдельных компонентов. Отключённый компонент не проверяется при запуске и в «Обновить всё»."/>
                                </StackPanel>

                                <!-- Divider -->
                                <Border Grid.Row="0" Grid.RowSpan="3" Grid.Column="1" Width="1"
                                        Background="{StaticResource BorderDefaultBrush}"
                                        VerticalAlignment="Stretch" Margin="12,0,12,0"/>

                                <!-- Right: Mass INI Deployment -->
                                <StackPanel Grid.Row="0" Grid.Column="2" Spacing="4">
                                    <TextBlock Text="Массовое развертывание INI" FontSize="14" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <TextBlock TextWrapping="Wrap" FontSize="11"
                                               Foreground="{StaticResource InlineDescriptionBrush}" LineHeight="18"
                                               Text="Развернуть INI-файлы или пресеты ReShade сразу в нескольких играх. Пользовательские горячие клавиши и путь к скриншотам сохраняются."/>
                                </StackPanel>

                                <!-- Row 1 Left: Update Inclusion button -->
                                <Button Grid.Row="1" Grid.Column="0" x:Name="GlobalUpdateInclusionBtn"
                                        Content="Включение в обновление"
                                        Click="GlobalUpdateInclusion_Click"
                                        Background="{StaticResource AccentBlueBgBrush}"
                                        Foreground="{StaticResource AccentBlueBrush}"
                                        BorderBrush="{StaticResource AccentBlueBorderBrush}" BorderThickness="1"
                                        CornerRadius="8" Padding="12,7" FontSize="12"
                                        HorizontalAlignment="Stretch"/>

                                <!-- Row 1 Right: INI deploy buttons (2x2 grid) -->
                                <Grid Grid.Row="1" Grid.RowSpan="2" Grid.Column="2" ColumnSpacing="8" RowSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Button Grid.Row="0" Grid.Column="0" Content="ReShade.ini" Click="MassDeployRsIni_Click"
                                            Background="{StaticResource AccentBlueBgBrush}" Foreground="{StaticResource AccentBlueBrush}"
                                            BorderBrush="{StaticResource AccentBlueBorderBrush}" BorderThickness="1"
                                            CornerRadius="8" Padding="12,7" FontSize="12" HorizontalAlignment="Stretch"/>
                                    <Button Grid.Row="0" Grid.Column="1" Content="relimiter.ini" Click="MassDeployUlIni_Click"
                                            Background="{StaticResource AccentBlueBgBrush}" Foreground="{StaticResource AccentBlueBrush}"
                                            BorderBrush="{StaticResource AccentBlueBorderBrush}" BorderThickness="1"
                                            CornerRadius="8" Padding="12,7" FontSize="12" HorizontalAlignment="Stretch"/>
                                    <Button Grid.Row="1" Grid.Column="0" Content="DC.ini" Click="MassDeployDcIni_Click"
                                            Background="{StaticResource AccentBlueBgBrush}" Foreground="{StaticResource AccentBlueBrush}"
                                            BorderBrush="{StaticResource AccentBlueBorderBrush}" BorderThickness="1"
                                            CornerRadius="8" Padding="12,7" FontSize="12" HorizontalAlignment="Stretch"/>
                                    <Button Grid.Row="1" Grid.Column="1" Content="OptiScaler.ini" Click="MassDeployOsIni_Click"
                                            Background="{StaticResource AccentBlueBgBrush}" Foreground="{StaticResource AccentBlueBrush}"
                                            BorderBrush="{StaticResource AccentBlueBorderBrush}" BorderThickness="1"
                                            CornerRadius="8" Padding="12,7" FontSize="12" HorizontalAlignment="Stretch"/>
                                    <Button Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Content="Массовая установка пресетов"
                                            Click="MassPresetInstall_Click"
                                            Background="{StaticResource AccentBlueBgBrush}" Foreground="{StaticResource AccentBlueBrush}"
                                            BorderBrush="{StaticResource AccentBlueBorderBrush}" BorderThickness="1"
                                            CornerRadius="8" Padding="12,7" FontSize="12" HorizontalAlignment="Stretch"/>
                                </Grid>

                                <!-- Row 2 Left: Summary text -->
                                <TextBlock Grid.Row="2" Grid.Column="0" x:Name="GlobalUpdateSummaryText" x:FieldModifier="internal"
                                           FontSize="11" TextWrapping="Wrap"/>
                            </Grid>
                            </StackPanel>
                        </Border>

                        <!-- ══════════════════════════════════════════════════════════
                             CARD 8: SYSTEM & MAINTENANCE
                             ══════════════════════════════════════════════════════════ -->
                        <Border Background="{StaticResource SurfaceRaisedBrush}" CornerRadius="10" Padding="20,16"
                                BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
                            <StackPanel Spacing="12">
                            <TextBlock Text="Система и обслуживание" FontSize="15" FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                            <Grid ColumnSpacing="0" RowSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="25"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Left: Full Refresh + Purge Staging -->
                                <Grid Grid.Column="0" RowSpacing="8">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <StackPanel Grid.Row="0" Spacing="8">
                                        <TextBlock Text="Полное обновление" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource InlineDescriptionBrush}" LineHeight="18"
                                                   Text="Очищает все кеши и заново сканирует всё с диска. Крайняя мера — если игры пропали, пути изменились, к игре добавился DLSS или с карточки игры пропал раздел DLSS."/>
                                    </StackPanel>
                                    <Button Grid.Row="1" x:Name="FullRefreshBtn" Content="Полное обновление"
                                            Click="FullRefreshButton_Click"
                                            Background="{StaticResource AccentBlueBgBrush}" Foreground="{StaticResource AccentBlueBrush}"
                                            BorderBrush="{StaticResource AccentBlueBorderBrush}" BorderThickness="1"
                                            CornerRadius="8" Padding="12,7" FontSize="12"
                                            HorizontalAlignment="Stretch"/>
                                    <TextBlock Grid.Row="2" TextWrapping="Wrap" FontSize="11" Margin="0,8,0,0"
                                               Foreground="{StaticResource InlineDescriptionBrush}" LineHeight="18"
                                               Text="Удаляет кешированные файлы DLSS, Streamline и компонентов, освобождая место на диске. Шейдеры, установленные аддоны и метаданные версий сохраняются. Файлы автоматически скачаются заново, когда понадобятся."/>
                                    <Button Grid.Row="3" x:Name="PurgeCacheBtn"
                                            Content="Очистить кеш загрузок"
                                            Click="PurgeCachedFiles_Click"
                                            Background="{StaticResource AccentRedBgBrush}" Foreground="{StaticResource AccentRedBrush}"
                                            BorderBrush="{StaticResource AccentPurpleBorderBrush}" BorderThickness="1"
                                            CornerRadius="8" Padding="12,7" FontSize="12"
                                            HorizontalAlignment="Stretch"
                                            ToolTipService.ToolTip="Удаляет кешированные DLSS, Streamline и загруженные файлы, освобождая место на диске. Шейдеры сохраняются."/>
                                </Grid>

                                <!-- Divider -->
                                <Border Grid.Column="1" Width="1"
                                        Background="{StaticResource BorderDefaultBrush}"
                                        VerticalAlignment="Stretch" Margin="12,0,12,0"/>

                                <!-- Right: Admin Mode + System Tray -->
                                <Grid Grid.Column="2" RowSpacing="8">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <!-- Admin Mode description + combo -->
                                    <StackPanel Grid.Row="0" Spacing="4">
                                        <TextBlock Text="Режим администратора" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource InlineDescriptionBrush}" LineHeight="18"
                                                   Text="Создаёт назначенное задание для запуска RHI с повышенными правами. Необходимо для драйверных настроек ReBAR, Low Latency Ultra и Smooth Motion. Drop Helper включает перетаскивание из Discord при запуске с повышенными правами."/>
                                    </StackPanel>
                                    <Grid Grid.Row="1" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Spacing="4">
                                            <TextBlock Text="Режим администратора" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                            <ComboBox x:Name="AdminModeCombo" x:FieldModifier="internal"
                                                      SelectionChanged="AdminModeCombo_SelectionChanged"
                                                      FontSize="12" Padding="8,4"
                                                      CornerRadius="8" HorizontalAlignment="Stretch">
                                                <ComboBoxItem Content="Off"/>
                                                <ComboBoxItem Content="On"/>
                                            </ComboBox>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="4">
                                            <TextBlock Text="Drop Helper" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                            <ComboBox x:Name="DropHelperCombo" x:FieldModifier="internal"
                                                      SelectionChanged="DropHelperCombo_SelectionChanged"
                                                      FontSize="12" Padding="8,4"
                                                      CornerRadius="8" HorizontalAlignment="Stretch"
                                                      ToolTipService.ToolTip="Окно Drop Helper включает перетаскивание из Discord в режиме администратора. Отключите, если не нужно. Требуется перезапуск.">
                                                <ComboBoxItem Content="Off"/>
                                                <ComboBoxItem Content="On"/>
                                            </ComboBox>
                                        </StackPanel>
                                    </Grid>
                                    <!-- System Tray description + combos -->
                                    <StackPanel Grid.Row="2" Spacing="4" Margin="0,12,0,0">
                                        <TextBlock Text="Системный трей" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource InlineDescriptionBrush}" LineHeight="18"
                                                   Text="Сворачивать в системный трей при закрытии. Правый клик по значку в трее или закреплённому значку панели задач — быстрый запуск недавних игр."/>
                                    </StackPanel>
                                    <Grid Grid.Row="3" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Spacing="4">
                                            <TextBlock Text="Свёртывать в трей" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                            <ComboBox x:Name="CloseToTrayCombo" x:FieldModifier="internal"
                                                      SelectionChanged="CloseToTrayCombo_SelectionChanged"
                                                      FontSize="12" Padding="8,4" CornerRadius="8" HorizontalAlignment="Stretch">
                                                <ComboBoxItem Content="Off"/>
                                                <ComboBoxItem Content="On"/>
                                            </ComboBox>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="4">
                                            <TextBlock Text="Недавние игры" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                            <ComboBox x:Name="RecentGamesCombo" x:FieldModifier="internal"
                                                      SelectionChanged="RecentGamesCombo_SelectionChanged"
                                                      FontSize="12" Padding="8,4" CornerRadius="8" HorizontalAlignment="Stretch">
                                                <ComboBoxItem Content="Off"/>
                                                <ComboBoxItem Content="On"/>
                                            </ComboBox>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Spacing="4">
                                            <TextBlock Text="Запускать с Windows" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                            <ComboBox x:Name="StartWithWindowsCombo" x:FieldModifier="internal"
                                                      SelectionChanged="StartWithWindowsCombo_SelectionChanged"
                                                      FontSize="12" Padding="8,4" CornerRadius="8" HorizontalAlignment="Stretch">
                                                <ComboBoxItem Content="Off"/>
                                                <ComboBoxItem Content="On"/>
                                            </ComboBox>
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Grid>
                            </StackPanel>
                        </Border>

                        <!-- ══════════════════════════════════════════════════════════
                             CARD 9: DATA & FOLDERS
                             ══════════════════════════════════════════════════════════ -->
                        <Border Background="{StaticResource SurfaceRaisedBrush}" CornerRadius="10" Padding="20,16"
                                BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Данные и пользовательские файлы" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource InlineDescriptionBrush}" LineHeight="20">
                                    Все данные RHI хранятся в AppData. Перетащите свои DLL ReShade, DLSS или Streamline в папку Custom, чтобы использовать их как переопределения для отдельных игр. В папке Logs лежат журналы сеансов — они помогают при разборе проблем.
                                </TextBlock>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button x:Name="OpenAppDataBtn" Content="Папка AppData" Click="OpenAppDataFolder_Click"
                                            Background="{StaticResource AccentBlueBgBrush}" Foreground="{StaticResource AccentBlueBrush}"
                                            BorderBrush="{StaticResource AccentBlueBorderBrush}" BorderThickness="1"
                                            CornerRadius="8" Padding="12,6" FontSize="12"/>
                                    <Button x:Name="OpenDownloadsBtn" Content="Папка загрузок" Click="OpenDownloadsFolder_Click"
                                            Background="{StaticResource AccentBlueBgBrush}" Foreground="{StaticResource AccentBlueBrush}"
                                            BorderBrush="{StaticResource AccentBlueBorderBrush}" BorderThickness="1"
                                            CornerRadius="8" Padding="12,6" FontSize="12"/>
                                    <Button x:Name="OpenCustomBtn" Content="Папка Custom" Click="OpenCustomFolder_Click"
                                            Background="{StaticResource AccentBlueBgBrush}" Foreground="{StaticResource AccentBlueBrush}"
                                            BorderBrush="{StaticResource AccentBlueBorderBrush}" BorderThickness="1"
                                            CornerRadius="8" Padding="12,6" FontSize="12"/>
                                    <Button x:Name="OpenLogsBtn" Content="Папка журналов" Click="OpenLogsFolder_Click"
                                            Background="{StaticResource AccentBlueBgBrush}" Foreground="{StaticResource AccentBlueBrush}"
                                            BorderBrush="{StaticResource AccentBlueBorderBrush}" BorderThickness="1"
                                            CornerRadius="8" Padding="12,6" FontSize="12"/>
                                    <Button x:Name="CopyLogsArchiveBtn" Content="Скопировать журналы" Click="CopyLogsArchive_Click"
                                            Background="{StaticResource AccentBlueBgBrush}" Foreground="{StaticResource AccentBlueBrush}"
                                            BorderBrush="{StaticResource AccentBlueBorderBrush}" BorderThickness="1"
                                            CornerRadius="8" Padding="12,6" FontSize="12"
                                            ToolTipService.ToolTip="Создаёт zip-архив всех журналов и копирует его в буфер обмена — можно вставить прямо в Discord"/>
                                    <Button x:Name="ExportGameDataBtn" x:FieldModifier="internal" Content="Экспортировать данные об играх" Click="ExportGameData_Click"
                                            Background="{StaticResource AccentBlueBgBrush}" Foreground="{StaticResource AccentBlueBrush}"
                                            BorderBrush="{StaticResource AccentBlueBorderBrush}" BorderThickness="1"
                                            CornerRadius="8" Padding="12,6" FontSize="12"
                                            ToolTipService.ToolTip="Собирает данные игровой библиотеки (API, пути к exe, сведения о движке) и копирует JSON в буфер обмена — вставьте в Discord, чтобы поделиться с базой сообщества RHI"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Hidden combos retained for code-behind compatibility -->
                        <StackPanel Visibility="Collapsed">
                            <ComboBox x:Name="ReShadeChannelCombo" x:FieldModifier="internal"
                                      SelectionChanged="ReShadeChannelCombo_SelectionChanged">
                                <x:String>Stable (релизы с reshade.me)</x:String>
                                <x:String>Nightly (сборки GitHub Actions)</x:String>
                            </ComboBox>
                            <ComboBox x:Name="DxvkVariantCombo" x:FieldModifier="internal"
                                      SelectionChanged="DxvkVariantCombo_SelectionChanged">
                                <x:String>Development (ночные сборки)</x:String>
                                <x:String>Stable (тегированные релизы)</x:String>
                                <x:String>Lilium HDR</x:String>
                            </ComboBox>
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- end SettingsPanel -->

            <!--  ABOUT PANEL  -->
            <Grid x:Name="AboutPanel" x:FieldModifier="internal" Visibility="Collapsed" Background="{StaticResource SurfaceBaseBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Back button bar -->
                <Border Grid.Row="0" Padding="24,12,24,10" Background="Transparent"
                        BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,0,0,1">
                    <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                        <Button Content="← К играм"
                                Click="AboutBack_Click"
                                Background="{StaticResource SurfaceOverlayBrush}" Foreground="{StaticResource TextSecondaryBrush}"
                                BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1"
                                CornerRadius="8" Padding="12,6" FontSize="12"/>
                        <TextBlock Text="О программе" FontSize="20" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Scrollable about content -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel Padding="32,24,32,40" Spacing="14" MaxWidth="800"
                                HorizontalAlignment="Center">

                        <!-- ── About ───────────────────────────────────────────────── -->
                        <Border Background="{StaticResource SurfaceRaisedBrush}" CornerRadius="10" Padding="20,16"
                                BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
                            <StackPanel Spacing="10">
                                <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,0,0,4">
                                    <Image Source="icon.ico" Width="48" Height="48"/>
                                    <StackPanel VerticalAlignment="Center" Spacing="4">
                                        <TextBlock FontSize="20" FontWeight="Bold">
                                            <Run Text="RHI" Foreground="{StaticResource AccentTealBrush}"/>
                                        </TextBlock>
                                        <TextBlock x:Name="AboutVersionText" x:FieldModifier="internal" FontSize="12" Foreground="{StaticResource InlineDescriptionBrush}"/>
                                    </StackPanel>
                                </StackPanel>

                                <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource TextTertiaryBrush}" LineHeight="20"
                                           Text="Универсальный набор для улучшения игр на ПК. Сам находит игры из 8 магазинов и даёт управление в один клик: ReShade, HDR-моды, шейдеры, DLSS/Streamline, ограничители FPS, профили драйвера NVIDIA и многое другое — всё в одном месте."/>

                                <!-- What it does -->
                                <Border Background="{StaticResource SurfaceToolbarBrush}" CornerRadius="8" Padding="14,10"
                                        BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="Что управляет RHI" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource InlineDescriptionBrush}" LineHeight="18"
                                                   Text="ReShade и наборы шейдеров · HDR-моды RenoDX · Luma Framework · подмена версий DLSS/Streamline и пресеты · настройки профиля драйвера NVIDIA (VSync, Low Latency, ReBAR, Smooth Motion, питание) · OptiScaler · ограничители FPS ReLimiter и Display Commander · RE Framework · DXVK · нативный HDR UE-Extended · индивидуальные переопределения для всего."/>
                                    </StackPanel>
                                </Border>

                                <!-- Disclaimer -->
                                <!-- Single-player warning -->
                                <Border Background="{StaticResource AccentRedBgBrush}" CornerRadius="8" Padding="14,10"
                                        BorderBrush="{StaticResource AccentPurpleBorderBrush}" BorderThickness="1">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="Только одиночная игра" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{StaticResource AccentRedBrush}"/>
                                        <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource InlineDescriptionBrush}" LineHeight="18"
                                                   Text="RHI устанавливает ReShade с полной поддержкой аддонов и OptiScaler, а также подменяет DLL DLSS/Streamline. Эти модификации могут распознаваться античитом в сетевых и многопользовательских играх. Перед игрой онлайн удалите ReShade, OptiScaler и верните DLSS/Streamline к исходным версиям."/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- ── Credits ─────────────────────────────────────────────── -->
                        <Border Background="{StaticResource SurfaceRaisedBrush}" CornerRadius="10" Padding="20,16"
                                BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Благодарности и авторы" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource InlineDescriptionBrush}" LineHeight="20"
