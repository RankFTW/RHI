                                            <ToolTip>
                                                <TextBlock TextWrapping="Wrap" MaxWidth="280">
                                                    <Run Text="{Binding [L3c9aec06e679_Text], Source={StaticResource LocalizedStrings}, Mode=OneWay}"/><LineBreak/>
                                                    <Run Text="{Binding [L5f2611037f46_Text], Source={StaticResource LocalizedStrings}, Mode=OneWay}"/>
                                                </TextBlock>
                                            </ToolTip>
                                        </ToolTipService.ToolTip>
                                        <ComboBoxItem ContentTemplate="{StaticResource LocalizedOptionTemplate}" Content="On"/>
                                        <ComboBoxItem ContentTemplate="{StaticResource LocalizedOptionTemplate}" Content="Minimal"/>
                                    </ComboBox>
                                </Grid>

                                <!-- Divider -->
                                <Border Grid.Column="1" Width="1"
                                        Background="{StaticResource BorderDefaultBrush}"
                                        VerticalAlignment="Stretch" Margin="12,0,12,0"/>

                                <!-- Right: Automatic Updates — uses same Grid structure as left so the combo aligns with Background Checks -->
                                <Grid Grid.Column="2" RowSpacing="8">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <StackPanel Grid.Row="0" Spacing="8">
                                        <TextBlock Text="{Binding [L26f3900c3e92_Text], Source={StaticResource LocalizedStrings}, Mode=OneWay}" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource InlineDescriptionBrush}" LineHeight="18"
                                                   Text="{Binding [L3b0339f3197d_Text], Source={StaticResource LocalizedStrings}, Mode=OneWay}"/>
                                    </StackPanel>
                                    <!-- Rows 1–2 intentionally empty — spacers to match left column height -->
                                    <ComboBox Grid.Row="3" x:Name="AutoUpdateComponentsCombo" x:FieldModifier="internal"
                                              FontSize="12" HorizontalAlignment="Stretch"
                                              ToolTipService.ToolTip="{Binding [Lc445de2f4557_ToolTip], Source={StaticResource LocalizedStrings}, Mode=OneWay}"
                                              SelectionChanged="AutoUpdateComponentsCombo_SelectionChanged">
                                        <ComboBoxItem ContentTemplate="{StaticResource LocalizedOptionTemplate}" Content="No"/>
                                        <ComboBoxItem ContentTemplate="{StaticResource LocalizedOptionTemplate}" Content="Yes"/>
                                    </ComboBox>
                                </Grid>
                            </Grid>
                            </StackPanel>
                        </Border>

                        <!-- ══════════════════════════════════════════════════════════
                             CARD 2: RESHADE & DISPLAY
                             ══════════════════════════════════════════════════════════ -->
                        <Border Background="{StaticResource SurfaceRaisedBrush}" CornerRadius="10" Padding="20,16"
                                BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
                            <StackPanel Spacing="12">
                            <TextBlock Text="{Binding [Ladc1b3a0e700_Text], Source={StaticResource LocalizedStrings}, Mode=OneWay}" FontSize="15" FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                            <Grid ColumnSpacing="0" RowSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="25"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- ── Left: Screenshots & Hotkeys ── -->
                                <StackPanel Grid.Row="0" Grid.Column="0" Spacing="4">
                                    <TextBlock Text="{Binding [L31be4f781c54_Text], Source={StaticResource LocalizedStrings}, Mode=OneWay}" FontSize="14" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <TextBlock TextWrapping="Wrap" FontSize="11"
                                               Foreground="{StaticResource InlineDescriptionBrush}" LineHeight="18"
                                               Text="{Binding [Lce4953921b7a_Text], Source={StaticResource LocalizedStrings}, Mode=OneWay}"/>
                                </StackPanel>

