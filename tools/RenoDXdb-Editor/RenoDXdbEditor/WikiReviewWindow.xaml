<Window x:Class="RenoDXdbEditor.WikiReviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:t="clr-namespace:RhiTools.Theme"
        Title="Wiki New Mods Review" Height="680" Width="940"
        MinHeight="480" MinWidth="680"
        Style="{StaticResource ThemedWindow}"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- header / progress -->
            <RowDefinition Height="*"/>      <!-- two-panel content -->
            <RowDefinition Height="Auto"/>   <!-- action buttons -->
        </Grid.RowDefinitions>

        <!-- ── Header ─────────────────────────────────────────────────────── -->
        <Grid Grid.Row="0" Margin="24,20,24,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock x:Name="ProgressLabel" Text="Reviewing new mods from the RenoDX wiki"
                           Style="{StaticResource DialogTitle}"/>
                <TextBlock x:Name="SubLabel" Text="Review each mod and choose to Accept or Skip it."
                           Style="{StaticResource Caption}" Margin="0,4,0,0"/>
            </StackPanel>
            <Border Grid.Column="1" Style="{StaticResource SuccessPill}" VerticalAlignment="Top">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Accepted " FontSize="12" Foreground="{DynamicResource SuccessText}"/>
                    <TextBlock x:Name="AcceptedCountLabel" Text="0" FontSize="12" FontWeight="SemiBold"
                               Foreground="{DynamicResource SuccessText}"/>
                    <TextBlock Text=" / " FontSize="12" Foreground="{DynamicResource SuccessText}"/>
                    <TextBlock x:Name="TotalCountLabel" Text="0" FontSize="12" Foreground="{DynamicResource SuccessText}"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ── Two-panel content ──────────────────────────────────────────── -->
        <Grid Grid.Row="1" Margin="24,0,24,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left: wiki mod -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="From the wiki" Style="{StaticResource SectionTitle}" Foreground="{DynamicResource CautionText}"/>

                        <TextBlock Text="Name" Style="{StaticResource FieldLabel}"/>
                        <TextBlock x:Name="WikiName" Style="{StaticResource FieldValue}" FontSize="15" FontWeight="SemiBold"/>

                        <TextBlock Text="Author" Style="{StaticResource FieldLabel}"/>
                        <TextBlock x:Name="WikiAuthor" Style="{StaticResource FieldValue}"/>

                        <TextBlock Text="Status" Style="{StaticResource FieldLabel}"/>
                        <TextBlock x:Name="WikiStatus" Style="{StaticResource FieldValue}"/>

                        <TextBlock Text="Snapshot URL (64-bit)" Style="{StaticResource FieldLabel}"/>
                        <TextBlock x:Name="WikiSnapshotUrl" Style="{StaticResource FieldUrl}"/>

                        <TextBlock Text="Snapshot URL (32-bit)" Style="{StaticResource FieldLabel}"/>
                        <TextBlock x:Name="WikiSnapshotUrl32" Style="{StaticResource FieldUrl}"/>

                        <TextBlock Text="Nexus URL" Style="{StaticResource FieldLabel}"/>
                        <TextBlock x:Name="WikiNexusUrl" Style="{StaticResource FieldUrl}"/>

                        <TextBlock Text="Discord URL" Style="{StaticResource FieldLabel}"/>
                        <TextBlock x:Name="WikiDiscordUrl" Style="{StaticResource FieldUrl}"/>

                        <TextBlock Text="Discussion URL" Style="{StaticResource FieldLabel}"/>
                        <TextBlock x:Name="WikiDiscussionUrl" Style="{StaticResource FieldUrl}"/>

                        <TextBlock Text="Notes" Style="{StaticResource FieldLabel}"/>
                        <TextBlock x:Name="WikiNotes" Style="{StaticResource FieldValue}" Foreground="{DynamicResource TextSecondary}"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Right: DB entry that would be created (editable before accepting) -->
            <Border Grid.Column="2" Style="{StaticResource Card}" Margin="0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Will be added as" Style="{StaticResource SectionTitle}" Foreground="{DynamicResource AccentText}"/>

                        <Label Content="Name (edit if needed)"/>
                        <TextBox x:Name="DbNameBox" Margin="0,0,0,12"/>

                        <Label Content="Author"/>
                        <TextBox x:Name="DbAuthorBox" Margin="0,0,0,12"/>

                        <Label Content="Snapshot URL (64-bit)"/>
                        <TextBox x:Name="DbSnapshotUrlBox" Margin="0,0,0,12" TextWrapping="Wrap"
                                 Style="{StaticResource MonoTextBox}"/>

                        <Label Content="Snapshot URL (32-bit)"/>
                        <TextBox x:Name="DbSnapshotUrl32Box" Margin="0,0,0,12" TextWrapping="Wrap"
                                 Style="{StaticResource MonoTextBox}"/>

                        <Label Content="Nexus URL"/>
                        <TextBox x:Name="DbNexusUrlBox" Margin="0,0,0,12" TextWrapping="Wrap"
                                 Style="{StaticResource MonoTextBox}"/>

                        <Label Content="Discord URL"/>
                        <TextBox x:Name="DbDiscordUrlBox" Margin="0,0,0,12" TextWrapping="Wrap"
                                 Style="{StaticResource MonoTextBox}"/>

                        <Label Content="Discussion URL"/>
                        <TextBox x:Name="DbDiscussionUrlBox" Margin="0,0,0,12" TextWrapping="Wrap"
                                 Style="{StaticResource MonoTextBox}"/>

                        <Label Content="Notes"/>
                        <TextBox x:Name="DbNotesBox" TextWrapping="Wrap" AcceptsReturn="True" Height="70"
                                 VerticalScrollBarVisibility="Auto"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- ── Action bar ─────────────────────────────────────────────────── -->
        <Border Grid.Row="2" Style="{StaticResource DialogFooter}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="PositionLabel" VerticalAlignment="Center" Style="{StaticResource Caption}"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="AcceptBtn" Content="Accept and Add" Click="Accept_Click"
                            Style="{StaticResource AccentButton}" t:Ui.Icon="&#xE73E;"/>
                    <Button x:Name="SkipBtn" Content="Skip" Click="Skip_Click"
                            t:Ui.Icon="&#xE72A;" Margin="8,0,0,0"
                            ToolTip="Skip this mod. It will not be added to the DB"/>
                    <Button x:Name="StopBtn" Content="Stop Review" Click="Stop_Click"
                            Style="{StaticResource DangerButton}" t:Ui.Icon="&#xE71A;" Margin="8,0,0,0"
                            ToolTip="Close the review. Accepted mods are kept."/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
