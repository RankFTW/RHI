<Window x:Class="PCGWEditor.PcgwCredentialsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PCGW Bot Credentials" SizeToContent="Height" Width="540"
        Style="{StaticResource ThemedWindow}"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False">
    <StackPanel>
        <StackPanel Margin="24,20,24,20">
            <TextBlock Text="PCGamingWiki bot credentials" Style="{StaticResource DialogTitle}" Margin="0,0,0,6"/>
            <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,18">
                Required for fetching from PCGW. Use a bot password from Special:BotPasswords&#10;(username format: YourName@BotName, needs Cargo query + High-volume access grants).
            </TextBlock>

            <Label Content="Username (e.g. Rankftw@Fiatbrava14!)"/>
            <TextBox x:Name="UsernameBox" Margin="0,0,0,14"/>

            <Label Content="Password (generated bot password)"/>
            <PasswordBox x:Name="PasswordBox"/>
        </StackPanel>

        <Border Style="{StaticResource DialogFooter}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Content="Save" Click="Save_Click" Style="{StaticResource AccentButton}" IsDefault="True"/>
                <Button Grid.Column="2" Content="Cancel" Click="Cancel_Click" IsCancel="True"/>
            </Grid>
        </Border>
    </StackPanel>
</Window>
